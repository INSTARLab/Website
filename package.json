{
  "name": "instarlab-website",
  "version": "0.1.0",
  "private": true,
  "description": "INSTAR Lab static website migration",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.4.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm run build:compatibility && pnpm run build:search",
    "build:astro": "astro build",
    "build:compatibility": "node scripts/build/finalize-static-artifact.mjs",
    "build:search": "node scripts/search/build-pagefind.mjs",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "test": "pnpm run check",
    "quality:routes": "node scripts/quality/route-ledger.mjs --dist dist --strict",
    "quality:links": "node scripts/quality/check-dist-links.mjs --dist dist",
    "quality:sitemap": "node scripts/quality/check-dist-sitemap.mjs --dist dist --origin https://www.instarlab.org",
    "quality:media": "node scripts/quality/media-audit.mjs --dist dist",
    "quality:provenance": "node scripts/quality/check-dist-provenance.mjs --dist dist",
    "design:refresh": "21st init --design-context --refresh",
    "test:browser": "pnpm exec playwright test -c tests/browser/playwright.config.ts",
    "quality:browser": "pnpm run test:browser",
    "verify": "pnpm run check && pnpm run quality:record && pnpm run build && pnpm run quality:routes && pnpm run quality:media && pnpm run quality:provenance && pnpm run quality:links && pnpm run quality:sitemap && pnpm run quality:browser",
    "quality:record": "node --test tests/record/*.test.mjs tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "bootstrap": "5.3.8",
    "motion": "^13.2.0"
  },
  "devDependencies": {
    "@21st-dev/cli": "1.17.1",
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "pagefind": "1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
