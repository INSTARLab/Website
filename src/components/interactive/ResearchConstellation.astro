<section class="research-constellation" aria-labelledby="research-constellation-title">
  <div class="site-container research-constellation__inner">
    <div class="research-constellation__copy" data-reveal>
      <p class="research-constellation__eyebrow">A field guide to the work</p>
      <h2 id="research-constellation-title">Follow a question across disciplines.</h2>
      <p>
        INSTAR connects scientific questions to the methods, technologies, and public-benefit paths that can move them forward.
        Use the map as an orientation layer, then choose the route that matches your next decision.
      </p>
      <nav aria-label="Research pathways">
        <ul class="research-constellation__links">
          <li><a href="/research/current-programs/">Current programs <span aria-hidden="true">↗</span></a></li>
          <li><a href="/sciences/outer-space/">Space science <span aria-hidden="true">↗</span></a></li>
          <li><a href="/technology/quantum-computing/">Quantum computing <span aria-hidden="true">↗</span></a></li>
          <li><a href="/community/support/">Support the work <span aria-hidden="true">↗</span></a></li>
        </ul>
      </nav>
    </div>

    <div
      class="research-constellation__visual"
      data-research-constellation
      data-reveal
      role="img"
      aria-label="An interactive constellation linking research, science, technology, and public benefit"
    >
      <canvas class="research-constellation__canvas" aria-hidden="true"></canvas>
      <div class="research-constellation__legend" aria-hidden="true">
        <span><i class="research-constellation__dot research-constellation__dot--blue"></i> Research</span>
        <span><i class="research-constellation__dot research-constellation__dot--red"></i> Application</span>
        <span><i class="research-constellation__dot research-constellation__dot--gold"></i> Public benefit</span>
      </div>
      <noscript>
        <p class="research-constellation__noscript">The pathway links remain available above when motion and WebGL are unavailable.</p>
      </noscript>
    </div>
  </div>
</section>

<script>
  import { animate, inView } from 'motion';

  const root = document.querySelector<HTMLElement>('[data-research-constellation]');
  const canvas = root?.querySelector<HTMLCanvasElement>('canvas');
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (root && canvas) {
    const boot = async () => {
    const THREE = await import('three');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 20);
    camera.position.z = 4.8;
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'low-power' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setClearColor(0x000000, 0);

    const constellation = new THREE.Group();
    const nodes = [
      { position: [-1.6, 0.8, 0], color: 0x2dbee1 },
      { position: [-0.7, 1.3, 0.25], color: 0x1072ba },
      { position: [0.25, 0.9, -0.15], color: 0xec2227 },
      { position: [1.1, 0.2, 0.15], color: 0xc8972b },
      { position: [0.4, -0.7, 0.1], color: 0x1072ba },
      { position: [-0.9, -0.75, -0.2], color: 0x2dbee1 },
      { position: [-1.75, -0.2, 0.15], color: 0xc8972b },
    ] as const;
    const nodeGeometry = new THREE.SphereGeometry(0.075, 10, 10);

    nodes.forEach(({ position, color }) => {
      const node = new THREE.Mesh(nodeGeometry, new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.95 }));
      node.position.set(...position);
      constellation.add(node);
    });

    const linePositions = nodes.flatMap((node, index) => {
      const next = nodes[(index + 1) % nodes.length];
      return [...node.position, ...next.position];
    });
    const lineGeometry = new THREE.BufferGeometry();
    lineGeometry.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));
    constellation.add(new THREE.LineSegments(lineGeometry, new THREE.LineBasicMaterial({ color: 0x6f879e, transparent: true, opacity: 0.34 })));
    scene.add(constellation);

    const resize = () => {
      const width = root.clientWidth;
      const height = Math.max(280, root.clientHeight);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };
    const observer = new ResizeObserver(resize);
    observer.observe(root);
    resize();

    let frame = 0;
    const render = () => {
      if (!reducedMotion) {
        constellation.rotation.y += 0.0018;
        constellation.rotation.x = Math.sin(performance.now() * 0.00025) * 0.05;
      }
      renderer.render(scene, camera);
      frame = window.requestAnimationFrame(render);
    };
    render();

    window.addEventListener('pagehide', () => {
      window.cancelAnimationFrame(frame);
      observer.disconnect();
      lineGeometry.dispose();
      nodeGeometry.dispose();
      renderer.dispose();
    }, { once: true });
    };

    const visibilityObserver = new IntersectionObserver((entries) => {
      if (entries[0]?.isIntersecting) {
        visibilityObserver.disconnect();
        void boot();
      }
    }, { rootMargin: '240px' });
    visibilityObserver.observe(root);
  }

  if (revealItems.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    revealItems.forEach((item) => { item.style.opacity = '0'; item.style.transform = 'translateY(18px)'; });
    inView(revealItems, ({ target }) => {
      animate(target, { opacity: 1, y: 0 }, { duration: 0.6, ease: 'easeOut' });
    }, { amount: 0.2 });
  }
</script>

<style>
  .research-constellation {
    border-block: 1px solid color-mix(in srgb, var(--color-brand) 28%, transparent);
    background: #f3f7fb;
  }

  .research-constellation__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .research-constellation__copy { max-inline-size: 38rem; }
  .research-constellation__eyebrow {
    margin-block-end: 1rem;
    color: var(--color-brand-deep);
    font-family: var(--font-ui);
    font-size: var(--text-kicker);
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .research-constellation h2 { max-inline-size: 12ch; font-size: clamp(2rem, 3vw, 3.6rem); }
  .research-constellation__copy > p:not(.research-constellation__eyebrow) { margin-block: 1.5rem 2rem; max-inline-size: 58ch; color: var(--color-muted-strong); }
  .research-constellation__links { display: grid; gap: 0.2rem; max-inline-size: 31rem; }
  .research-constellation__links a { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.72rem; border-block-end: 1px solid var(--color-rule); color: var(--color-ink); font-family: var(--font-ui); font-weight: 700; text-decoration: none; }
  .research-constellation__links a:hover { color: var(--color-brand-deep); }
  .research-constellation__visual { position: relative; min-block-size: 23rem; overflow: hidden; border: 1px solid color-mix(in srgb, var(--color-brand) 30%, transparent); border-radius: var(--radius-panel); background: radial-gradient(circle at 50% 45%, rgb(255 255 255 / 0.92), rgb(224 236 247 / 0.72)); box-shadow: var(--shadow-panel); }
  .research-constellation__canvas { inline-size: 100%; block-size: 100%; min-block-size: 23rem; }
  .research-constellation__legend { position: absolute; inset-inline: 1.25rem; inset-block-end: 1.1rem; display: flex; flex-wrap: wrap; gap: 0.75rem 1.1rem; color: var(--color-muted-strong); font-family: var(--font-ui); font-size: 0.75rem; }
  .research-constellation__dot { display: inline-block; inline-size: 0.55rem; block-size: 0.55rem; margin-inline-end: 0.3rem; border-radius: 50%; }
  .research-constellation__dot--blue { background: var(--color-brand); }
  .research-constellation__dot--red { background: var(--color-accent); }
  .research-constellation__dot--gold { background: #c8972b; }
  .research-constellation__noscript { position: absolute; inset: auto 1rem 1rem; padding: 0.75rem; background: rgb(255 255 255 / 0.9); font-size: 0.85rem; }

  @media (max-width: 52rem) {
    .research-constellation__inner { grid-template-columns: 1fr; }
    .research-constellation h2 { max-inline-size: 16ch; }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-constellation__copy, .research-constellation__visual { opacity: 1 !important; transform: none !important; }
  }
</style>
