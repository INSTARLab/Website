---
import Icon from '../primitives/Icon.astro';
---

<section class="research-constellation @container" aria-labelledby="research-constellation-title">
  <div class="site-container research-constellation__inner">
    <div class="research-constellation__copy" data-reveal>
      <p class="research-constellation__eyebrow">The research process</p>
      <h2 id="research-constellation-title">From scientific question to defensible result.</h2>
      <p>
        INSTAR connects scientific questions to advanced AI, quantum methods, computation, sensing, and domain science.
        Use the process map to review how a program is framed, tested, and translated into technical outputs.
      </p>
      <nav aria-label="Research pathways">
        <ul class="research-constellation__links">
          <li><a class="touch-target" data-prefetch-intent href="/research/current-programs/">Review current programs <Icon name="arrow-up-right" size="1rem" /></a></li>
          <li><a class="touch-target" data-prefetch-intent href="/sciences/outer-space/">Review space science <Icon name="arrow-up-right" size="1rem" /></a></li>
          <li><a class="touch-target" data-prefetch-intent href="/technology/quantum-computing/">Review quantum computing <Icon name="arrow-up-right" size="1rem" /></a></li>
          <li><a class="touch-target" data-prefetch-intent href="/contact-us/">Discuss a funding or contract need <Icon name="arrow-up-right" size="1rem" /></a></li>
        </ul>
      </nav>
    </div>

    <div
      class="research-constellation__visual"
      data-research-constellation
      data-reveal
      aria-labelledby="research-constellation-map-title"
      aria-describedby="research-constellation-map-description"
    >
      <canvas class="research-constellation__canvas" aria-hidden="true"></canvas>
      <div class="research-constellation__guide">
        <div class="research-constellation__guide-intro">
          <p class="research-constellation__guide-kicker">The research loop</p>
          <h3 id="research-constellation-map-title">How a program earns confidence.</h3>
          <p id="research-constellation-map-description">
            Text guide: a question is defined, a method is selected, the result is tested, and the outputs are documented for the next decision.
          </p>
        </div>

        <ol class="research-constellation__pathway" aria-label="Four-stage research validation pathway">
          <li class="research-constellation__step">
            <span class="research-constellation__step-marker" aria-hidden="true"></span>
            <div class="research-constellation__step-copy">
              <h4>Question</h4>
              <p>Define the scientific or mission question and the decision it must inform.</p>
            </div>
            <span class="research-constellation__step-tag">Scope</span>
          </li>
          <li class="research-constellation__step">
            <span class="research-constellation__step-marker" aria-hidden="true"></span>
            <div class="research-constellation__step-copy">
              <h4>Method</h4>
              <p>Select the AI, quantum, computational, experimental, or domain method that fits the question.</p>
            </div>
            <span class="research-constellation__step-tag">Design</span>
          </li>
          <li class="research-constellation__step">
            <span class="research-constellation__step-marker" aria-hidden="true"></span>
            <div class="research-constellation__step-copy">
              <h4>Validation</h4>
              <p>Test assumptions, measure uncertainty, and document what holds up under review.</p>
            </div>
            <span class="research-constellation__step-tag">Verify</span>
          </li>
          <li class="research-constellation__step">
            <span class="research-constellation__step-marker" aria-hidden="true"></span>
            <div class="research-constellation__step-copy">
              <h4>Deliverable</h4>
              <p>Translate validated work into data, models, reports, prototypes, or other usable outputs.</p>
            </div>
            <span class="research-constellation__step-tag">Transfer</span>
          </li>
        </ol>

        <div class="research-constellation__legend" role="group" aria-label="Constellation layer key">
          <span class="research-constellation__legend-label">Map layer</span>
          <span><i class="research-constellation__dot research-constellation__dot--blue" aria-hidden="true"></i>Research</span>
          <span><i class="research-constellation__dot research-constellation__dot--red" aria-hidden="true"></i>Application</span>
          <span><i class="research-constellation__dot research-constellation__dot--gold" aria-hidden="true"></i>Sponsor review</span>
        </div>

        <noscript>
          <p class="research-constellation__noscript">The animated constellation is optional; this four-stage guide and the pathway links remain available without JavaScript.</p>
        </noscript>
      </div>
      <p class="research-constellation__fallback" data-visualization-fallback hidden>
        The animated map is unavailable here. The four-stage guide remains available above, and the pathway links remain available in the orientation text.
      </p>
    </div>
  </div>
</section>

<script>
  import { animate, hover, inView, press } from 'motion';

  let disposeCurrent: (() => void) | undefined;
  let currentRoot: HTMLElement | undefined;

  const mount = () => {
    const root = document.querySelector<HTMLElement>('[data-research-constellation]');
    if (root && root === currentRoot) return;

    disposeCurrent?.();
    disposeCurrent = undefined;
    currentRoot = root ?? undefined;

    const canvas = root?.querySelector<HTMLCanvasElement>('canvas');
    const section = root?.closest<HTMLElement>('.research-constellation');
    const revealItems = section?.querySelectorAll<HTMLElement>('[data-reveal]') ?? [];
    const pathwayLinks = section?.querySelectorAll<HTMLAnchorElement>('[data-prefetch-intent]') ?? [];
    const cleanups: Array<() => void> = [];

    if (root && canvas) {
      const boot = () => {
        const context = canvas.getContext('2d');
        if (!context) {
          const fallback = root.querySelector<HTMLElement>('[data-visualization-fallback]');
          if (fallback) fallback.hidden = false;
          return;
        }

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const nodes = [
          { position: [-1.6, 0.8, 0], color: '#2dbee1' },
          { position: [-0.7, 1.3, 0.25], color: '#1072ba' },
          { position: [0.25, 0.9, -0.15], color: '#ec2227' },
          { position: [1.1, 0.2, 0.15], color: '#c8972b' },
          { position: [0.4, -0.7, 0.1], color: '#1072ba' },
          { position: [-0.9, -0.75, -0.2], color: '#2dbee1' },
          { position: [-1.75, -0.2, 0.15], color: '#c8972b' },
        ] as const;

        let width = 0;
        let height = 0;
        let pixelRatio = 1;
        let rotation = 0;

        const project = ([x, y, z]: readonly [number, number, number]) => {
          const cosine = Math.cos(rotation);
          const sine = Math.sin(rotation);
          const rotatedX = x * cosine - z * sine;
          const depth = 1 + (x * sine + z * cosine) * 0.08;
          return {
            x: width / 2 + rotatedX * width * 0.2 * depth,
            y: height / 2 - y * height * 0.2 * depth,
            scale: depth,
          };
        };

        const resize = () => {
          width = root.clientWidth;
          height = Math.max(280, root.clientHeight);
          pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
          canvas.width = Math.round(width * pixelRatio);
          canvas.height = Math.round(height * pixelRatio);
          context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        };

        const observer = new ResizeObserver(resize);
        observer.observe(root);
        resize();

        let frame = 0;
        const render = () => {
          context.clearRect(0, 0, width, height);
          const points = nodes.map(({ position }) => project(position));
          context.beginPath();
          context.strokeStyle = 'rgba(111, 135, 158, 0.34)';
          context.lineWidth = 1;
          nodes.forEach((_, index) => {
            const point = points[index];
            const next = points[(index + 1) % points.length];
            context.moveTo(point.x, point.y);
            context.lineTo(next.x, next.y);
          });
          context.stroke();

          points.forEach((point, index) => {
            context.beginPath();
            context.fillStyle = nodes[index].color;
            context.globalAlpha = 0.95;
            context.arc(point.x, point.y, 3.5 * point.scale, 0, Math.PI * 2);
            context.fill();
          });
          context.globalAlpha = 1;
        };
        render();
        if (!reducedMotion) {
          const animateFrame = () => {
            rotation += 0.0018;
            render();
            frame = window.requestAnimationFrame(animateFrame);
          };
          frame = window.requestAnimationFrame(animateFrame);
        }

        cleanups.push(() => {
          window.cancelAnimationFrame(frame);
          observer.disconnect();
          context.clearRect(0, 0, width, height);
        });
      };

      const visibilityObserver = new IntersectionObserver((entries) => {
        if (entries[0]?.isIntersecting) {
          visibilityObserver.disconnect();
          boot();
        }
      }, { rootMargin: '240px' });
      visibilityObserver.observe(root);
      cleanups.push(() => visibilityObserver.disconnect());
    }

    if (revealItems.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const stopReveal = inView(revealItems, ({ target }) => {
        animate(target, { opacity: 1, y: 0 }, { duration: 0.6, ease: 'easeOut' });
      }, { amount: 0.2 });
      cleanups.push(stopReveal);
    }

    if (pathwayLinks.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      pathwayLinks.forEach((link) => {
        const arrow = link.querySelector<HTMLElement>('.research-constellation__link-arrow');
        if (arrow) {
          cleanups.push(hover(link, () => {
            const enter = animate(arrow, { x: 4 }, { duration: 0.16, ease: 'easeOut' });
            return () => {
              enter.stop();
              animate(arrow, { x: 0 }, { duration: 0.16, ease: 'easeOut' });
            };
          }));
        }

        cleanups.push(press(link, (element) => {
          const down = animate(element, { scale: 0.985 }, { duration: 0.12, ease: 'easeOut' });
          return () => {
            down.stop();
            animate(element, { scale: 1 }, { duration: 0.18, ease: 'easeOut' });
          };
        }));
      });
    }

    disposeCurrent = () => cleanups.splice(0).forEach((cleanup) => cleanup());
  };

  const dispose = () => {
    disposeCurrent?.();
    disposeCurrent = undefined;
    currentRoot = undefined;
  };

  mount();
  document.addEventListener('astro:before-swap', dispose);
  document.addEventListener('astro:page-load', mount);
</script>

<style>
  .research-constellation {
    border-block: 1px solid color-mix(in srgb, var(--color-brand) 28%, transparent);
    background: #f3f7fb;
  }

  .research-constellation__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .research-constellation__copy { max-inline-size: 38rem; }
  .research-constellation__eyebrow {
    margin-block-end: 1rem;
    color: var(--color-brand-deep);
    font-family: var(--font-ui);
    font-size: var(--text-kicker);
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .research-constellation h2 { max-inline-size: 12ch; font-size: clamp(2rem, 3vw, 3.6rem); }
  .research-constellation__copy > p:not(.research-constellation__eyebrow) { margin-block: 1.5rem 2rem; max-inline-size: 58ch; color: var(--color-muted-strong); }
  .research-constellation__links { display: grid; gap: 0.2rem; max-inline-size: 31rem; }
  .research-constellation__links a { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.72rem; border-block-end: 1px solid var(--color-rule); color: var(--color-ink); font-family: var(--font-ui); font-weight: 700; text-decoration: none; }
  .research-constellation__links a:hover { color: var(--color-brand-deep); }
  .research-constellation__links .icon { flex: none; }
  .research-constellation__visual { position: relative; min-block-size: clamp(32rem, 50vw, 38rem); overflow: hidden; border: 1px solid color-mix(in srgb, var(--color-brand) 30%, transparent); border-radius: var(--radius-panel); background: radial-gradient(circle at 50% 45%, rgb(255 255 255 / 0.94), rgb(224 236 247 / 0.78)); box-shadow: var(--shadow-panel); }
  .research-constellation__canvas { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; opacity: 0.42; }
  .research-constellation__guide { position: relative; z-index: 1; display: grid; gap: 1.2rem; min-block-size: 100%; padding: clamp(1.25rem, 3vw, 2.25rem); background: linear-gradient(115deg, rgb(243 247 251 / 0.96), rgb(243 247 251 / 0.78)); }
  .research-constellation__guide-intro { display: grid; gap: 0.45rem; }
  .research-constellation__guide-kicker { margin: 0; color: var(--color-brand-deep); font-family: var(--font-ui); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
  .research-constellation__guide h3 { margin: 0; max-inline-size: 20ch; font-size: clamp(1.6rem, 2.7vw, 2.45rem); }
  .research-constellation__guide-intro > p:last-child { margin: 0; max-inline-size: 52ch; color: var(--color-muted-strong); font-size: 0.92rem; line-height: 1.45; }
  .research-constellation__pathway { display: grid; gap: 0.7rem; margin: 0; padding: 0; list-style: none; }
  .research-constellation__step { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.8rem; min-block-size: 4.65rem; padding: 0.8rem 0.9rem; border: 1px solid color-mix(in srgb, var(--color-brand) 18%, var(--color-rule)); border-radius: 0.75rem; background: rgb(255 255 255 / 0.88); box-shadow: 0 0.45rem 1.2rem rgb(26 57 82 / 0.06); }
  .research-constellation__step:not(:last-child)::after { content: "↓"; position: absolute; inset-block-end: -0.92rem; inset-inline-start: 1.35rem; z-index: 2; color: var(--color-brand-deep); font-family: var(--font-ui); font-size: 0.9rem; font-weight: 800; line-height: 1; }
  .research-constellation__step-marker { display: block; inline-size: 0.8rem; block-size: 0.8rem; border-radius: 50%; background: var(--color-brand); }
  .research-constellation__step:nth-child(2) .research-constellation__step-marker { background: #a7191e; }
  .research-constellation__step:nth-child(3) .research-constellation__step-marker { background: #536f8b; }
  .research-constellation__step:nth-child(4) .research-constellation__step-marker { background: #c8972b; }
  .research-constellation__step-copy { display: grid; gap: 0.15rem; min-inline-size: 0; }
  .research-constellation__step h4 { margin: 0; color: var(--color-ink); font-family: var(--font-ui); font-size: 0.98rem; font-weight: 800; }
  .research-constellation__step p { margin: 0; color: var(--color-muted-strong); font-size: 0.8rem; line-height: 1.35; }
  .research-constellation__step-tag { align-self: start; padding-block: 0.2rem; color: var(--color-brand-deep); font-family: var(--font-ui); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .research-constellation__legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem 1rem; padding-block-start: 0.25rem; color: var(--color-muted-strong); font-family: var(--font-ui); font-size: 0.72rem; }
  .research-constellation__legend-label { color: var(--color-ink); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .research-constellation__dot { display: inline-block; inline-size: 0.55rem; block-size: 0.55rem; margin-inline-end: 0.3rem; border-radius: 50%; }
  .research-constellation__dot--blue { background: var(--color-brand); }
  .research-constellation__dot--red { background: var(--color-accent); }
  .research-constellation__dot--gold { background: #c8972b; }
  .research-constellation__noscript { margin: 0; padding: 0.65rem 0.8rem; border-inline-start: 3px solid var(--color-accent); background: rgb(255 255 255 / 0.78); color: var(--color-muted-strong); font-size: 0.8rem; line-height: 1.4; }
  .research-constellation__fallback { position: absolute; inset: 1rem; z-index: 3; display: grid; place-items: center; padding: 1rem; border: 1px solid var(--color-rule); background: rgb(255 255 255 / 0.94); color: var(--color-muted-strong); font-size: 0.9rem; text-align: center; }

  @container (max-width: 52rem) {
    .research-constellation__inner { grid-template-columns: 1fr; }
    .research-constellation h2 { max-inline-size: 16ch; }
    .research-constellation__visual { min-block-size: auto; }
  }

  @container (max-width: 34rem) {
    .research-constellation__step { grid-template-columns: auto minmax(0, 1fr); }
    .research-constellation__step-tag { grid-column: 2; margin-block-start: -0.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .research-constellation__copy, .research-constellation__visual { opacity: 1 !important; transform: none !important; }
  }
</style>
