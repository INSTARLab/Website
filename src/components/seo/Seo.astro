---
export interface SeoProps {
  title: string;
  description: string;
  canonical?: string | URL;
  image?: string | URL;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: string | Date;
  modifiedAt?: string | Date;
  author?: string;
  jsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  publishedAt,
  modifiedAt,
  author,
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://instarlab.org/');
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteOrigin).href;
const imageUrl = image ? new URL(image, siteOrigin).href : undefined;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const toIso = (value?: string | Date) => value instanceof Date ? value.toISOString() : value;
const jsonLdText = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, '\\u003c')
  : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
<meta name="theme-color" content="#1072ba" />
<link rel="icon" href="/img/logo/instar.svg" type="image/svg+xml" />
<link rel="icon" href="/img/logo/fav/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/img/logo/fav/apple-touch-icon.png" />
<link rel="manifest" href="/img/logo/fav/site.webmanifest" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="INSTAR Lab" />
{imageUrl ? <meta property="og:image" content={imageUrl} /> : null}
{imageUrl && imageAlt ? <meta property="og:image:alt" content={imageAlt} /> : null}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:site" content="@INSTARLab" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl ? <meta name="twitter:image" content={imageUrl} /> : null}

{type === 'article' && publishedAt ? <meta property="article:published_time" content={toIso(publishedAt)} /> : null}
{type === 'article' && modifiedAt ? <meta property="article:modified_time" content={toIso(modifiedAt)} /> : null}
{type === 'article' && author ? <meta property="article:author" content={author} /> : null}
{jsonLdText ? <script type="application/ld+json" set:html={jsonLdText}></script> : null}
