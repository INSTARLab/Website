---
import { csvDataHref, csvDocument } from './csv.mjs';

export interface BarDatum {
  readonly label: string;
  readonly value: number | null;
  readonly href?: string;
}

interface Props {
  readonly title: string;
  readonly items: readonly BarDatum[];
  readonly kicker?: string;
  readonly unit?: string;
  readonly source?: string;
  readonly sourceHref?: string;
  /**
   * Approval reference for the snapshot the values come from. It travels in the
   * CSV export but is deliberately not printed in the visible footer: on an
   * unapproved snapshot the value is the raw enum state (`pending`), which is
   * meaningful to the operator inspecting an export and meaningless to the
   * public reading the page. The page states the absence in prose instead.
   */
  readonly approval?: string;
  readonly description?: string;
  readonly id?: string;
  /**
   * Outline level for the chart title. A chart is content inside a section, so
   * a hard-coded `<h2>` fabricated a document-level heading on every page that
   * rendered one. Call sites pass the level their enclosing section implies;
   * the default reproduces the previous markup for anything that does not.
   */
  readonly level?: 2 | 3 | 4 | 5 | 6;
  readonly emptyMessage?: string;
}

const { title, items, kicker, unit, source, sourceHref, approval, description, id, level = 2, emptyMessage = 'No observations are available for this period.' } = Astro.props;
const TitleTag = `h${level}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const chartId = id ?? `record-bar-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const invalidItem = items.find((item) => item.value !== null && !Number.isFinite(item.value));
if (invalidItem) throw new Error(`BarChart data for “${invalidItem.label}” must be finite or null.`);
const availableItems = items.filter((item) => item.value !== null);
const maxValue = Math.max(1, ...availableItems.map((item) => Math.max(0, item.value as number)));
const formatValue = (value: number | null) => value === null || !Number.isFinite(value) ? 'Not reported' : value.toLocaleString('en-US');
// The export carries the same attribution the page displays, plus the approval
// reference an operator needs to trace a value back to its sign-off. A
// downloaded CSV used to lose the source entirely, so a reader holding the file
// could no longer tell where the numbers came from. Values are written raw (a
// spreadsheet should read them as numbers) and an unavailable observation is
// written as the room's explicit "Not reported" rather than an empty cell, so
// it cannot be confused with a row that was never published.
//
// The State column is what keeps the three publication states apart in a file
// someone keeps after leaving the page: a measured zero exports as the number
// 0 with `measured`, an approved-but-unpublished value exports as "Not
// reported" with `unavailable`, and a measure with no approved observation
// exports no rows at all.
const csvValue = (value: number | null) => value === null || !Number.isFinite(value) ? 'Not reported' : value;
const csvState = (value: number | null) => value === null || !Number.isFinite(value) ? 'unavailable' : 'measured';
const csv = csvDocument([
  ['Label', 'Value', 'State', ...(unit ? ['Unit'] : []), ...(source ? ['Source'] : []), ...(approval ? ['Approval'] : [])],
  ...items.map((item) => [item.label, csvValue(item.value), csvState(item.value), ...(unit ? [unit] : []), ...(source ? [source] : []), ...(approval ? [approval] : [])]),
]);
const csvHref = csvDataHref(csv);
---

<section class="record-bar-chart" aria-labelledby={`${chartId}-title`} data-record-viz="bar" data-record-viz-id={chartId}>
  <header class="record-viz__header">
    <div>
      {kicker && <p class="record-kicker">{kicker}</p>}
      <TitleTag id={`${chartId}-title`} class="record-viz__title">{title}</TitleTag>
      {description && <p class="record-viz__description">{description}</p>}
    </div>
    <a class="record-viz__export" href={csvHref} download={`${chartId}.csv`}>Download CSV</a>
  </header>

  {items.length === 0 ? (
    <p class="record-viz__empty" role="status">{emptyMessage}</p>
  ) : (
    <>
      <div class="record-bar-chart__list" role="list" aria-label={`${title} bars`}>
        {items.map((item) => {
          const isAvailable = typeof item.value === 'number' && Number.isFinite(item.value);
          const barSize = isAvailable ? Math.max(0, item.value as number) / maxValue * 100 : 0;
          return (
            <div class="record-bar-chart__item" role="listitem">
              <div class="record-bar-chart__meta">
                <span class="record-bar-chart__label">{item.href ? <a href={item.href}>{item.label}</a> : item.label}</span>
                <strong class="record-bar-chart__value">{formatValue(item.value)}</strong>
              </div>
              <div class="record-bar-chart__track" aria-hidden="true"><span class="record-bar-chart__bar" style={`--record-bar-size: ${barSize}%`}></span></div>
            </div>
          );
        })}
      </div>

      <details class="record-viz__table-details">
        <summary>View data table</summary>
        {/* tabindex puts this wrapper in the tab order, so it needs a role and a
          * name — the same contract the register tables in files/ and verify/ use. */}
        <div class="record-viz__table-wrap" tabindex="0" role="region" aria-label={`${title} data table`}>
          <table class="record-viz__table">
            <caption>{title}</caption>
            <thead><tr><th scope="col">Category</th><th scope="col">Value{unit && ` (${unit})`}</th></tr></thead>
            <tbody>
              {items.map((item) => (
                <tr>
                  <th scope="row">{item.href ? <a href={item.href}>{item.label}</a> : item.label}</th>
                  <td>{formatValue(item.value)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </>
  )}

  {(source || unit) && (
    <footer class="record-viz__footer">
      {unit && <span>Unit: {unit}</span>}
      {source && <span>Source: {sourceHref ? <a href={sourceHref}>{source}</a> : source}</span>}
    </footer>
  )}
</section>

<style>
  .record-bar-chart,
  .record-viz__table-details {
    color: #122535;
    font-family: var(--font-ui, system-ui, sans-serif);
  }

  .record-viz__header {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1rem;
  }

  .record-viz__title {
    margin: 0;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: clamp(1.1rem, 1.6vw, 1.45rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .record-viz__description,
  .record-viz__footer,
  .record-viz__empty {
    color: #526675;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .record-viz__description {
    max-width: 68ch;
    margin: 0.45rem 0 0;
  }

  .record-viz__export {
    flex: 0 0 auto;
    padding: 0.4rem 0.65rem;
    border: 1px solid #9ebdcc;
    border-radius: 0.35rem;
    color: #14627d;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
  }

  .record-viz__export:hover,
  .record-viz__export:focus-visible {
    border-color: #14627d;
    background: #edf7fb;
  }

  .record-bar-chart__list {
    display: grid;
    gap: 1rem;
  }

  .record-bar-chart__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.4rem;
    color: #122535;
    font-size: 0.82rem;
  }

  .record-bar-chart__value {
    flex: 0 0 auto;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .record-bar-chart__label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .record-bar-chart__label a {
    color: inherit;
    text-decoration-color: #9ebdcc;
    text-underline-offset: 0.18em;
  }

  .record-bar-chart__track {
    width: 100%;
    height: 0.7rem;
    overflow: hidden;
    border-radius: 999px;
    background: #edf3f6;
  }

  .record-bar-chart__bar {
    display: block;
    width: var(--record-bar-size, 0%);
    height: 100%;
    border-radius: inherit;
    background: #176b8c;
  }

  .record-viz__table-details {
    margin-top: 0.9rem;
    border-top: 1px solid #e4ebef;
  }

  .record-viz__table-details summary {
    width: fit-content;
    padding: 0.75rem 0;
    color: #14627d;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .record-viz__table-wrap {
    overflow-x: auto;
  }

  .record-viz__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .record-viz__table th,
  .record-viz__table td {
    padding: 0.65rem 0.55rem;
    border-bottom: 1px solid #e4ebef;
    text-align: left;
  }

  .record-viz__table td {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .record-viz__table a,
  .record-viz__footer a {
    color: #14627d;
    text-underline-offset: 0.18em;
  }

  .record-viz__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid #e4ebef;
  }

  .record-viz__empty {
    margin: 0;
    padding: 1rem;
    border: 1px dashed #9ebdcc;
    border-radius: 0.4rem;
    background: #f7fafc;
  }

  @media (max-width: 40rem) {
    .record-viz__export {
      width: 100%;
      text-align: center;
    }
  }
</style>
