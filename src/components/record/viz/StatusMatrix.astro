---
export type StatusValue = string | number | boolean | null;

export interface StatusCell {
  readonly value: StatusValue;
  readonly status?: 'positive' | 'caution' | 'negative' | 'neutral';
  readonly note?: string;
}

export interface StatusRow {
  readonly label: string;
  readonly values: readonly (StatusValue | StatusCell)[];
}

interface Props {
  readonly title: string;
  readonly columns: readonly string[];
  readonly rows: readonly StatusRow[];
  readonly description?: string;
  readonly source?: string;
  readonly sourceHref?: string;
  readonly id?: string;
  readonly emptyMessage?: string;
}

const { title, columns, rows, description, source, sourceHref, id, emptyMessage = 'No status observations are available.' } = Astro.props;
const matrixId = id ?? `record-matrix-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const asCell = (value: StatusValue | StatusCell): StatusCell => typeof value === 'object' && value !== null && 'value' in value ? value : { value };
const displayValue = (value: StatusValue) => value === null || value === '' ? 'Not reported' : typeof value === 'boolean' ? value ? 'Yes' : 'No' : typeof value === 'number' ? value.toLocaleString('en-US') : value;
const classFor = (status: StatusCell['status']) => status ? `record-status-matrix__cell--${status}` : '';
---

<section class="record-status-matrix" aria-labelledby={`${matrixId}-title`} data-record-viz="status-matrix" data-record-viz-id={matrixId}>
  <header class="record-viz__header">
    <div>
      <h2 id={`${matrixId}-title`} class="record-viz__title">{title}</h2>
      {description && <p class="record-viz__description">{description}</p>}
    </div>
  </header>

  {rows.length === 0 ? (
    <p class="record-viz__empty" role="status">{emptyMessage}</p>
  ) : (
    <div class="record-viz__table-wrap" tabindex="0">
      <table class="record-status-matrix__table">
        <caption>{title}</caption>
        <thead>
          <tr><th scope="col">Area</th>{columns.map((column) => <th scope="col">{column}</th>)}</tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {columns.map((_, index) => {
                const cell = asCell(row.values[index] ?? null);
                return <td class={classFor(cell.status)} data-status={cell.status ?? 'unreported'} title={cell.note}>{displayValue(cell.value)}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {source && <footer class="record-viz__footer">Source: {sourceHref ? <a href={sourceHref}>{source}</a> : source}</footer>}
</section>

<style>
  .record-status-matrix,
  .record-status-matrix__table {
    color: #122535;
    font-family: var(--font-ui, system-ui, sans-serif);
  }

  .record-viz__header {
    margin-bottom: 1rem;
  }

  .record-viz__title {
    margin: 0;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: clamp(1.1rem, 1.6vw, 1.45rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .record-viz__description,
  .record-viz__footer,
  .record-viz__empty {
    color: #526675;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .record-viz__description {
    max-width: 68ch;
    margin: 0.45rem 0 0;
  }

  .record-viz__table-wrap {
    overflow-x: auto;
  }

  .record-status-matrix__table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .record-status-matrix__table caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .record-status-matrix__table th,
  .record-status-matrix__table td {
    padding: 0.7rem 0.65rem;
    border-bottom: 1px solid #e4ebef;
    text-align: left;
    vertical-align: top;
  }

  .record-status-matrix__table thead th {
    color: #526675;
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .record-status-matrix__table tbody th {
    min-width: 11rem;
    font-weight: 700;
  }

  .record-status-matrix__table td {
    color: #526675;
    font-variant-numeric: tabular-nums;
  }

  .record-status-matrix__cell--positive,
  .record-status-matrix__cell--caution,
  .record-status-matrix__cell--negative,
  .record-status-matrix__cell--neutral {
    font-weight: 700;
  }

  .record-status-matrix__cell--positive {
    color: #176b50 !important;
  }

  .record-status-matrix__cell--caution {
    color: #8a5b00 !important;
  }

  .record-status-matrix__cell--negative {
    color: #a61b1b !important;
  }

  .record-status-matrix__cell--neutral {
    color: #14627d !important;
  }

  .record-viz__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid #e4ebef;
  }

  .record-viz__footer a {
    color: #14627d;
    text-underline-offset: 0.18em;
  }

  .record-viz__empty {
    margin: 0;
    padding: 1rem;
    border: 1px dashed #9ebdcc;
    border-radius: 0.4rem;
    background: #f7fafc;
  }
</style>
