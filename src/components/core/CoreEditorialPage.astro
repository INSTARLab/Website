---
import type { CoreRouteMeta } from '../../data/core-routes';
import { publicMediaFor } from '../../data/media';
import SiteLayout from '../../layouts/SiteLayout.astro';
import EditorialMedia from '../editorial/media/EditorialMedia.astro';
import { createPublicMedia } from '../../utils/media/records';

interface Props {
  meta: CoreRouteMeta;
}

interface ContentLink {
  readonly label: string;
  readonly href: string;
}

interface ContentBlock {
  readonly title: string;
  readonly body: string;
  readonly bullets?: readonly (string | ContentLink)[];
}

const { meta } = Astro.props;
const key = meta.key;
const content: Record<string, { eyebrow: string; hero: string; lead: string; blocks: readonly ContentBlock[] }> = {
  about: {
    eyebrow: 'Institution / capability',
    hero: '/img/banners/about.avif',
    lead: 'INSTAR Lab is a 501(c)(3) nonprofit research institute organized to pursue technically difficult questions across AI, quantum science, high-performance computing, health, energy, space, and the sciences.',
    blocks: [
      { title: 'Research at the frontier', body: 'We combine advanced AI with quantum research, computation, sensing, formal methods, and domain science. The result is a research portfolio designed for ambitious questions that require more than one technical capability.' },
      { title: 'Built for sponsored research', body: 'As a nonprofit research institute, INSTAR can align program design with scientific merit, mission need, reproducibility, data stewardship, and clear reporting—not only with a product roadmap.' },
      { title: 'What a sponsor can review', body: 'Start with current programs, technical capabilities, facilities, the research process, or a direct conversation about a solicitation or contract requirement.', bullets: ['Review current programs', 'Review technical capabilities', 'Discuss a federal research need'] },
    ],
  },
  mission: {
    eyebrow: 'Mission / research standard',
    hero: '/img/banners/mission.avif',
    lead: 'Advance human knowledge through rigorous research in AI, quantum science, and the full range of scientific domains—and turn validated results into useful knowledge, tools, and partnerships.',
    blocks: [
      { title: 'Define', body: 'Frame the scientific question, its mission relevance, and the evidence needed to evaluate it.' },
      { title: 'Develop', body: 'Use advanced AI, quantum methods, high-performance computing, sensing, formal verification, and domain expertise where they materially improve the work.' },
      { title: 'Validate and transfer', body: 'Test assumptions, document limitations, and deliver results in forms that researchers, agencies, and implementation partners can evaluate and build on.' },
    ],
  },
  'contact-us': {
    eyebrow: 'Federal research / contact',
    hero: '/img/banners/contact-us.avif',
    lead: 'Bring a solicitation, contract requirement, research question, or partnership proposal. We will route it to the appropriate research or administrative conversation.',
    blocks: [
      { title: 'Federal and sponsored research', body: 'For NSF, NASA, DOE, USDA, or other federal research questions, include the program, solicitation, technical area, and desired outcome when available.' },
      {
        title: 'Direct channels',
        body: 'INSTAR Lab Inc.\n125 Frederick St\nMarietta, OH 45750-3407\n929-229-2917',
        bullets: [
          { label: 'Email info@instarlab.org', href: 'mailto:info@instarlab.org' },
          { label: 'Call 929-229-2917', href: 'tel:9292292917' },
        ],
      },
      { title: 'What to include', body: 'Share the technical question, scope, timeline, data or facility constraints, and the decision the work must support.' },
    ],
  },
  privacy: {
    eyebrow: 'Policy / privacy',
    hero: '/img/banners/privacy.avif',
    lead: 'This page explains the information practices that apply to the public INSTAR website. We aim to collect the minimum information needed to respond and operate the service.',
    blocks: [
      { title: 'Information you choose to share', body: 'If you contact INSTAR by email or through a form, use the channel for the purpose stated. Do not send sensitive personal information unless it is necessary and the recipient has asked for it.' },
      { title: 'Essential operations', body: 'The site may process technical information required to deliver pages, protect the service, and understand failures. Nonessential tracking should not be required to read public content.' },
      { title: 'Questions and requests', body: 'For privacy questions or a request about information you submitted, contact info@instarlab.org. This page should be reviewed with the organization’s current legal and data-retention policy before production publication.' },
    ],
  },
  terms: {
    eyebrow: 'Policy / terms',
    hero: '/img/banners/terms.avif',
    lead: 'Use this site to learn, inspect research context, and begin legitimate conversations. The information is provided for general educational and organizational purposes.',
    blocks: [
      { title: 'Use the work responsibly', body: 'Respect intellectual property, attribution, privacy, and the limits stated alongside research materials. Do not use the site to interfere with service operation or misrepresent INSTAR’s work.' },
      { title: 'Research context is not a guarantee', body: 'Research descriptions, perspectives, and public materials are not a substitute for professional, legal, medical, financial, or safety advice. Verify time-sensitive information with the responsible source.' },
      { title: 'Contact', body: 'Questions about these terms or permission to reuse material can be directed to info@instarlab.org.' },
    ],
  },
  accessibility: {
    eyebrow: 'Commitment / access',
    hero: '/img/banners/accessibility.avif',
    lead: 'INSTAR is committed to making this site usable across devices, input methods, assistive technologies, and different ways of perceiving information.',
    blocks: [
      { title: 'How we build', body: 'We use semantic HTML, visible focus, keyboard paths, readable type, responsive media, reduced-motion treatments, and accessible alternatives for interactive visualizations.' },
      { title: 'Where we are improving', body: 'A site with a large content surface needs continuous review. We test the production build with automated WCAG checks and browser journeys, then prioritize issues that block understanding or action.' },
      { title: 'Tell us what failed', body: 'If a page, document, form, or visualization creates a barrier, email info@instarlab.org with the URL, the task you were trying to complete, and the assistive technology or browser involved.' },
    ],
  },
  '404': {
    eyebrow: 'Signal lost / recover',
    hero: '/img/404-bg.avif',
    lead: 'The route is not in the current map. Use the research pathways below to continue exploring.',
    blocks: [
      {
        title: 'Try a known path',
        body: 'Return to the home page, browse current programs, search the site, or open the latest research briefs.',
        bullets: [
          { label: 'Return home', href: '/' },
          { label: 'Explore current programs', href: '/research/current-programs/' },
          { label: 'Search the site', href: '/search/' },
          { label: 'Read the latest briefs', href: '/news/' },
        ],
      },
    ],
  },
};
const page = content[key] ?? content['404'];
const isNotFound = key === '404';
const pageSignature = isNotFound
  ? 'orientation → connection → participation'
  : key === 'contact-us'
    ? 'orientation → evidence → participation'
    : ['privacy', 'terms', 'accessibility'].includes(key)
      ? 'orientation → evidence → connection'
      : 'orientation → evidence → participation';
const heroUrl = page.hero as `/${string}`;
const heroAction = isNotFound
  ? { href: '/', label: 'Return to home' }
  : key === 'contact-us'
    ? { href: 'mailto:info@instarlab.org', label: 'Email INSTAR directly' }
    : { href: '/contact-us/', label: 'Discuss a research requirement' };
const heroAsset = publicMediaFor(heroUrl, {
  alt: { kind: 'contextual', status: 'approved', text: `${meta.title} — INSTAR Lab` },
  caption: `INSTAR Lab / ${page.eyebrow}`,
  sizes: '(min-width: 58rem) 55vw, 100vw',
  loading: 'eager',
  fetchpriority: 'high',
}) ?? createPublicMedia({
  id: `media:core-${key}` as `media:${string}`,
  url: heroUrl,
  type: 'photography-or-illustration',
  role: 'orientation',
  alt: { kind: 'contextual', status: 'approved', text: `${meta.title} — INSTAR Lab` },
  dimensions: { width: 1920, height: 600 },
  sizes: '(min-width: 58rem) 55vw, 100vw',
  loading: 'eager',
  fetchpriority: 'high',
  provenance: {
    status: 'unverified',
    source: 'Repository asset; original source is not recorded.',
    license: 'Unverified; confirm ownership or license before publication.',
  },
  caption: `INSTAR Lab / ${page.eyebrow}`,
});
---

<SiteLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.path}
  image={page.hero}
  imageAlt={`${meta.title} — INSTAR Lab`}
  noindex={isNotFound || meta.robots.startsWith('noindex')}
  bodyClass={`core-editorial-page core-editorial-page--${key}`}
  mainClass="core-editorial-main"
>
  <article class="core-editorial" data-route={meta.path} data-page-signature={pageSignature}>
    <header class="core-editorial__hero">
      <div class="core-editorial__hero-copy">
        <div class="core-editorial__container">
          <p class="core-editorial__eyebrow">{page.eyebrow}</p>
          <h1>{meta.title}</h1>
          <p class="core-editorial__lead">{page.lead}</p>
          <a class="core-editorial__button" href={heroAction.href}>{heroAction.label} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <EditorialMedia asset={heroAsset} figureClass="core-editorial__hero-media" class="core-editorial__hero-image" picture={false} />
    </header>

    <div class="core-editorial__container core-editorial__body">
      <div class="core-editorial__rail" aria-hidden="true"><span>INSTAR</span></div>
      <div class="core-editorial__blocks">
        {page.blocks.map((block, index) => (
          <section class="core-editorial__block" aria-labelledby={`core-block-${index}`}>
            <div>
              <h2 id={`core-block-${index}`}>{block.title}</h2>
              <p>{block.body}</p>
              {block.bullets ? <ul>{block.bullets.map((item) => <li>{typeof item === 'string' ? item : <a href={item.href}>{item.label}</a>}</li>)}</ul> : null}
              {isNotFound ? (
                <form class="core-editorial__search" method="get" action="/search/" role="search">
                  <label for="core-not-found-search">Search the site</label>
                  <div class="core-editorial__search-field">
                    <input
                      id="core-not-found-search"
                      name="q"
                      type="search"
                      placeholder="Try “quantum sensing”"
                      autocomplete="off"
                      spellcheck="false"
                      enterkeyhint="search"
                    />
                    <button type="submit">Search <span aria-hidden="true">↗</span></button>
                  </div>
                </form>
              ) : null}
            </div>
          </section>
        ))}
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .core-editorial { --core-accent: var(--color-brand); background: var(--color-canvas); }
  .core-editorial__container { width: calc(100% - 2 * var(--spacing-gutter)); margin-inline: auto; }
  .core-editorial__hero { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); block-size: min(40rem, calc(100svh - var(--layout-chrome-offset))); min-block-size: min(40rem, calc(100svh - var(--layout-chrome-offset))); color: #fff; background: #0b1626; }
  .core-editorial__hero-copy { display: flex; align-items: center; padding-block: clamp(3.5rem, 7vw, 6rem); }
  .core-editorial__eyebrow { margin-block-end: 1.8rem; color: #7fd7ea; font: 800 0.74rem/1.2 var(--font-ui); letter-spacing: 0.14em; text-transform: uppercase; }
  .core-editorial h1 { max-inline-size: 13ch; margin: 0; color: #fff; font-size: clamp(2.35rem, 4vw, 4.75rem); letter-spacing: -0.045em; line-height: 0.99; }
  .core-editorial__lead { max-inline-size: 47ch; margin-block: 1.5rem 0; color: rgb(255 255 255 / 0.73); font-size: clamp(1rem, 0.96rem + 0.22vw, 1.2rem); line-height: 1.55; }
  .core-editorial__button { display: inline-flex; align-items: center; gap: 0.7rem; margin-block-start: 2rem; padding: 0.9rem 1.1rem; color: #06121c; background: #7fd7ea; font: 800 0.82rem/1 var(--font-ui); text-decoration: none; }
  .core-editorial__button:hover { color: #fff; background: var(--core-accent); }
  :global(.core-editorial__hero-media) { position: relative; block-size: 100%; min-block-size: 100%; margin: 0; overflow: hidden; background: #132339; }
  :global(.core-editorial__hero-media img) { inline-size: 100%; block-size: 100%; min-block-size: 26rem; object-fit: cover; filter: saturate(0.82) contrast(1.06); }
  :global(.core-editorial__hero-media::after) { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(11 22 38 / 0.5), transparent 42%); content: ''; }
  :global(.core-editorial__hero-media figcaption) { position: absolute; z-index: 1; inset-inline: 1.5rem; inset-block-end: 1.5rem; color: #fff; font: 0.72rem/1.4 var(--font-ui); letter-spacing: 0.08em; text-transform: uppercase; }
  .core-editorial__body { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(4rem, 7vw, 6.5rem); }
  .core-editorial__rail { display: flex; flex-direction: column; justify-content: space-between; color: var(--core-accent); font: 800 0.7rem/1.4 var(--font-ui); letter-spacing: 0.15em; text-transform: uppercase; }
  .core-editorial__blocks { max-inline-size: 62rem; }
  .core-editorial__block { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; padding-block: 2.5rem; border-block-start: 1px solid var(--color-rule); }
  .core-editorial h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 3.3rem); letter-spacing: -0.05em; }
  .core-editorial__block p { max-inline-size: 62ch; margin-block: 1rem 0; color: var(--color-muted-strong); white-space: pre-line; }
  .core-editorial__block ul { display: grid; gap: 0.55rem; margin-block: 1.25rem 0; padding: 0; list-style: none; }
  .core-editorial__block li { display: flex; align-items: center; gap: 0.65rem; color: var(--color-ink); font-weight: 700; }
  .core-editorial__block li::before { inline-size: 0.55rem; block-size: 0.55rem; border-radius: 50%; background: var(--core-accent); content: ''; }
  .core-editorial__block li a { color: var(--core-accent); text-decoration-thickness: 0.08em; text-underline-offset: 0.14em; }
  .core-editorial__search { max-inline-size: 38rem; margin-block-start: 1.75rem; }
  .core-editorial__search label { display: block; margin-block-end: 0.6rem; color: var(--color-ink); font: 800 0.72rem/1.3 var(--font-ui); letter-spacing: 0.1em; text-transform: uppercase; }
  .core-editorial__search-field { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.6rem; }
  .core-editorial__search-field input { min-block-size: 3rem; padding-inline: 0.9rem; border: 1px solid var(--color-rule); border-radius: 0; background: #fff; color: var(--color-ink); font-size: 1rem; }
  .core-editorial__search-field button { display: inline-flex; align-items: center; gap: 0.6rem; min-block-size: 3rem; padding-inline: 1.1rem; border: 0; background: var(--core-accent); color: #fff; font: 800 0.8rem/1 var(--font-ui); cursor: pointer; }
  .core-editorial__search-field button:hover { filter: brightness(1.1); }

  @media (max-width: 58rem) {
    .core-editorial__hero { grid-template-columns: 1fr; }
    .core-editorial__hero { block-size: auto; }
    :global(.core-editorial__hero-media) { block-size: auto; min-block-size: auto; }
    :global(.core-editorial__hero-media img) { min-block-size: 22rem; max-block-size: 52svh; }
  }

  @media (max-width: 42rem) {
    .core-editorial__body { grid-template-columns: 1fr; gap: 2rem; }
    .core-editorial__rail { flex-direction: row; }
    .core-editorial__block { gap: 1rem; }
  }
</style>
