---
type HomeSliderAction = {
  readonly href: string;
  readonly label: string;
  readonly variant?: 'primary' | 'secondary';
};

type HomeSliderImage = {
  readonly src: `/${string}`;
  readonly alt: string;
  readonly caption?: string;
  readonly width?: number;
  readonly height?: number;
  readonly sizes?: string;
  readonly focalPoint?: `${number}% ${number}%`;
};

type HomeSliderSlide = {
  readonly id?: string;
  readonly kicker?: string;
  readonly title: string;
  readonly description?: string;
  readonly image: HomeSliderImage;
  readonly actions?: readonly HomeSliderAction[];
};

interface Props {
  /** Use a non-empty array; the first item is the no-JS and LCP slide. */
  readonly slides: readonly [HomeSliderSlide, ...HomeSliderSlide[]];
  readonly id?: string;
  readonly ariaLabel?: string;
  readonly controlsLabel?: string;
  readonly titleId?: string;
  readonly class?: string;
}

const {
  slides,
  id = 'home-slider',
  ariaLabel = 'Homepage highlights',
  controlsLabel = 'Choose a homepage highlight',
  titleId = `${id}-title`,
  class: className,
} = Astro.props;

const slidesId = `${id}-slides`;
const controlsId = `${id}-controls`;
const hasMultipleSlides = slides.length > 1;
---

<section
  id={id}
  class:list={['home-slider', className]}
  data-home-slider
  role="region"
  aria-roledescription="carousel"
  aria-label={ariaLabel}
>
  <div class="home-slider__viewport" data-slider-viewport>
    <ul id={slidesId} class="home-slider__slides">
      {slides.map((slide, index) => {
        const slideId = slide.id ? `${id}-${slide.id}` : `${id}-slide-${index + 1}`;
        const slideTitleId = index === 0 ? titleId : `${slideId}-title`;

        return (
          <li
            id={slideId}
            class="home-slider__slide"
            data-slide
            data-slide-index={index}
            data-slide-title={slide.title}
            data-active={index === 0 ? 'true' : 'false'}
            role="listitem"
            aria-roledescription="slide"
            aria-label={`Slide ${index + 1} of ${slides.length}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            hidden={index !== 0}
          >
            <figure class="home-slider__media">
              <img
                class="home-slider__image"
                src={slide.image.src}
                alt={slide.image.alt}
                width={slide.image.width}
                height={slide.image.height}
                sizes={slide.image.sizes ?? '100vw'}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'low'}
                decoding="async"
                style={`object-position: ${slide.image.focalPoint ?? '50% 50%'};`}
              />
              {slide.image.caption ? <figcaption>{slide.image.caption}</figcaption> : null}
            </figure>

            <div class="home-slider__content-shell">
              <div class="home-slider__copy">
                {slide.kicker ? <p class="home-slider__kicker">{slide.kicker}</p> : null}
                {index === 0 ? (
                  <h1 id={slideTitleId} class="home-slider__title">{slide.title}</h1>
                ) : (
                  <h2 id={slideTitleId} class="home-slider__title">{slide.title}</h2>
                )}
                {slide.description ? <p class="home-slider__description">{slide.description}</p> : null}
                {slide.actions?.length ? (
                  <div class="home-slider__actions home-masthead__actions">
                    {slide.actions.map((action) => (
                      <a
                        class:list={[
                          'home-slider__action',
                          `home-slider__action--${action.variant ?? 'secondary'}`,
                        ]}
                        href={action.href}
                      >
                        {action.label} <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                ) : null}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>

  {hasMultipleSlides ? (
    <div id={controlsId} class="home-slider__controls" data-slider-controls hidden>
      <div class="home-slider__navigation" aria-label="Slide navigation">
        <button
          class="home-slider__control"
          type="button"
          data-slider-action="previous"
          aria-controls={slidesId}
          aria-label="Previous slide"
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          class="home-slider__control"
          type="button"
          data-slider-action="next"
          aria-controls={slidesId}
          aria-label="Next slide"
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <nav class="home-slider__indicators" aria-label={controlsLabel}>
        <ol>
          {slides.map((slide, index) => (
            <li>
              <button
                class="home-slider__indicator"
                type="button"
                data-slider-index={index}
                aria-controls={slidesId}
                aria-current={index === 0 ? 'true' : undefined}
                aria-label={`Go to slide ${index + 1}: ${slide.title}`}
              >
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </button>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  ) : null}

  <p class="home-slider__live-region" data-slider-live-region aria-live="polite" aria-atomic="true"></p>
</section>

<script>
  const initializeHomeSlider = (slider) => {
    if (!(slider instanceof HTMLElement) || slider.dataset.sliderInitialized === 'true') return;

    const slides = Array.from(slider.querySelectorAll('[data-slide]'));
    const viewport = slider.querySelector('[data-slider-viewport]');
    const controls = slider.querySelector('[data-slider-controls]');
    const liveRegion = slider.querySelector('[data-slider-live-region]');

    if (slides.length < 2 || !(viewport instanceof HTMLElement)) return;

    const indicators = Array.from(slider.querySelectorAll('[data-slider-index]'));
    const previous = slider.querySelector('[data-slider-action="previous"]');
    const next = slider.querySelector('[data-slider-action="next"]');
    let activeIndex = 0;
    let pointerStart = null;

    slider.dataset.sliderInitialized = 'true';
    slider.dataset.sliderReady = 'true';

    const setActive = (requestedIndex, announce = true) => {
      activeIndex = (requestedIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.hidden = false;
        slide.dataset.active = isActive ? 'true' : 'false';
        slide.setAttribute('aria-hidden', String(!isActive));

        if (isActive) {
          slide.removeAttribute('inert');
        } else {
          slide.setAttribute('inert', '');
        }
      });

      indicators.forEach((indicator, index) => {
        if (index === activeIndex) {
          indicator.setAttribute('aria-current', 'true');
        } else {
          indicator.removeAttribute('aria-current');
        }
      });

      if (announce && liveRegion) {
        liveRegion.textContent = slides[activeIndex].getAttribute('data-slide-title') ?? '';
      }
    };

    slides.forEach((slide) => {
      slide.hidden = false;
    });
    if (controls instanceof HTMLElement) controls.hidden = false;
    setActive(0, false);

    previous?.addEventListener('click', () => setActive(activeIndex - 1));
    next?.addEventListener('click', () => setActive(activeIndex + 1));

    indicators.forEach((indicator) => {
      indicator.addEventListener('click', () => {
        const requestedIndex = Number(indicator.getAttribute('data-slider-index'));
        if (Number.isInteger(requestedIndex)) setActive(requestedIndex);
      });
    });

    slider.addEventListener('keydown', (event) => {
      const target = event.target;
      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement ||
        (target instanceof HTMLElement && target.isContentEditable)
      ) {
        return;
      }

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        setActive(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        setActive(slides.length - 1);
      }
    });

    viewport.addEventListener('pointerdown', (event) => {
      if (event.isPrimary === false || (event.pointerType === 'mouse' && event.button !== 0)) return;
      if (event.target instanceof Element && event.target.closest('a, button')) return;

      pointerStart = { id: event.pointerId, x: event.clientX, y: event.clientY };
      viewport.setPointerCapture?.(event.pointerId);
    });

    viewport.addEventListener('pointerup', (event) => {
      if (!pointerStart || pointerStart.id !== event.pointerId) return;

      const deltaX = event.clientX - pointerStart.x;
      const deltaY = event.clientY - pointerStart.y;
      pointerStart = null;

      if (Math.abs(deltaX) < 40 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
      setActive(deltaX < 0 ? activeIndex + 1 : activeIndex - 1);
    });

    viewport.addEventListener('pointercancel', () => {
      pointerStart = null;
    });
  };

  document.querySelectorAll('[data-home-slider]').forEach(initializeHomeSlider);
</script>

<style>
  .home-slider {
    --home-slider-dark: var(--home-dark, #0b1626);
    --home-slider-accent: var(--home-teal, var(--color-brand-cool));
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: #fff;
    background: var(--home-slider-dark);
  }

  .home-slider__viewport,
  .home-slider__slides,
  .home-slider__slide {
    min-block-size: min(48rem, calc(100svh - var(--layout-chrome-offset, 7rem)));
  }

  .home-slider__viewport {
    position: relative;
    touch-action: pan-y;
  }

  .home-slider__slides {
    display: grid;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .home-slider__slide {
    position: relative;
    display: grid;
    grid-area: 1 / 1;
    align-items: stretch;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 360ms var(--ease-editorial, ease), visibility 360ms var(--ease-editorial, ease);
  }

  .home-slider__slide[hidden] {
    display: none;
  }

  .home-slider:not([data-slider-ready]) .home-slider__slide:not(:first-child) {
    display: none;
  }

  .home-slider:not([data-slider-ready]) .home-slider__slide:first-child,
  .home-slider[data-slider-ready] .home-slider__slide[data-active='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .home-slider__slide[inert] {
    pointer-events: none;
  }

  :global(.home-slider__media) {
    position: absolute;
    z-index: -1;
    inset: 0;
    margin: 0;
    overflow: hidden;
    background: var(--home-slider-dark);
  }

  :global(.home-slider__media)::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(11 22 38 / 0.97) 0%, rgb(11 22 38 / 0.84) 30%, rgb(11 22 38 / 0.28) 70%, rgb(11 22 38 / 0.08) 100%),
      linear-gradient(0deg, rgb(11 22 38 / 0.58), transparent 42%);
    content: '';
  }

  :global(.home-slider__image) {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: inherit;
    object-fit: cover;
  }

  :global(.home-slider__media figcaption) {
    position: absolute;
    z-index: 1;
    inset-inline-end: var(--spacing-gutter);
    inset-block-end: 5.9rem;
    max-inline-size: min(30rem, 34vw);
    color: rgb(255 255 255 / 0.82);
    font: 0.74rem/1.4 var(--font-ui);
    text-align: end;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
  }

  .home-slider__content-shell {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    inline-size: min(100% - 2 * var(--spacing-gutter), 90rem);
    min-block-size: inherit;
    margin-inline: auto;
  }

  .home-slider__copy {
    inline-size: min(100%, 44rem);
    padding-block: clamp(4.5rem, 9vw, 7rem) 8rem;
    padding-inline-end: clamp(2rem, 6vw, 7rem);
  }

  .home-slider__kicker {
    margin-block: 0 1.6rem;
    color: var(--home-slider-accent);
    font: 700 var(--text-kicker, 0.72rem)/1.25 var(--font-ui);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .home-slider__title {
    max-inline-size: 15ch;
    margin: 0;
    color: #fff;
    font-size: clamp(2.55rem, 4.2vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  .home-slider__description {
    max-inline-size: 48ch;
    margin-block: 1.75rem 0;
    color: rgb(255 255 255 / 0.8);
    font-size: clamp(1rem, 0.96rem + 0.22vw, 1.2rem);
    line-height: 1.55;
  }

  .home-slider__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block-start: 1.8rem;
  }

  .home-slider__action {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-block-size: var(--spacing-touch, 2.75rem);
    padding: 0.8rem 1rem;
    font: 700 0.78rem/1 var(--font-ui);
    text-decoration: none;
    transition: transform var(--duration-quick, 160ms) var(--ease-editorial, ease), background-color var(--duration-quick, 160ms) ease, color var(--duration-quick, 160ms) ease;
  }

  .home-slider__action--primary {
    color: #06121c;
    background: var(--home-slider-accent);
  }

  .home-slider__action--secondary {
    border: 1px solid rgb(255 255 255 / 0.48);
    color: #fff;
    background: rgb(11 22 38 / 0.14);
  }

  .home-slider__action:hover {
    color: var(--home-slider-dark);
    background: #fff;
    transform: translateY(-2px);
  }

  .home-slider__action--primary:hover {
    color: #fff;
    background: var(--color-brand);
  }

  .home-slider__controls {
    position: absolute;
    z-index: 3;
    inset-inline: var(--spacing-gutter);
    inset-block-end: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    inline-size: min(calc(100% - 2 * var(--spacing-gutter)), 90rem);
    margin-inline: auto;
  }

  .home-slider__navigation,
  .home-slider__indicators ol {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .home-slider__control,
  .home-slider__indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--spacing-touch, 2.75rem);
    min-block-size: var(--spacing-touch, 2.75rem);
    border: 1px solid rgb(255 255 255 / 0.42);
    color: #fff;
    background: rgb(11 22 38 / 0.35);
    font: 700 0.82rem/1 var(--font-ui);
  }

  .home-slider__control:hover,
  .home-slider__indicator:hover,
  .home-slider__indicator[aria-current='true'] {
    border-color: var(--home-slider-accent);
    color: var(--home-slider-dark);
    background: var(--home-slider-accent);
  }

  .home-slider__indicator {
    padding-inline: 0.65rem;
    border-color: transparent;
    background: transparent;
  }

  .home-slider__live-region,
  .home-slider__controls[hidden] {
    display: none;
  }

  @media (max-width: 58rem) {
    .home-slider__viewport,
    .home-slider__slides,
    .home-slider__slide {
      min-block-size: min(44rem, calc(100svh - 6rem));
    }

    :global(.home-slider__media figcaption) {
      inset-inline-end: var(--spacing-gutter);
      max-inline-size: 17rem;
    }

    .home-slider__copy {
      padding-inline-end: 0;
    }
  }

  @media (max-width: 42rem) {
    .home-slider__title {
      max-inline-size: 13ch;
      font-size: clamp(2.3rem, 10vw, 3.25rem);
    }

    .home-slider__description {
      max-inline-size: 34ch;
      font-size: 0.98rem;
    }

    .home-slider__controls {
      align-items: flex-end;
    }

    .home-slider__indicators ol {
      gap: 0.2rem;
    }

    .home-slider__indicator {
      min-inline-size: 2.2rem;
      padding-inline: 0.35rem;
    }

    :global(.home-slider__media figcaption) {
      inset-block-end: 5.4rem;
      max-inline-size: 15rem;
      font-size: 0.68rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-slider__slide,
    .home-slider__action {
      transition: none;
    }

    .home-slider__action:hover {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    :global(.home-slider__media)::after {
      display: none;
    }

    .home-slider__control,
    .home-slider__indicator,
    .home-slider__action--secondary {
      border: 1px solid ButtonText;
      color: ButtonText;
      background: ButtonFace;
    }

    .home-slider__indicator[aria-current='true'],
    .home-slider__action--primary {
      border-color: Highlight;
      color: HighlightText;
      background: Highlight;
    }
  }
</style>
