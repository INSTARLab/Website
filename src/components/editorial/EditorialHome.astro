---
import ResearchConstellation from '../interactive/ResearchConstellation.astro';
import Icon from '../primitives/Icon.astro';
import HomeSlider from './HomeSlider.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import EditorialMedia from './media/EditorialMedia.astro';
import {
  editorialRoutesForFamily,
  familyLabel,
} from '../../data/editorialRoutes';
import { publicMediaFor } from '../../data/media';
import type { MediaAsset } from '../../data/media/types';
import { createPublicMedia } from '../../utils/media/records';

type HomeMediaInput = {
  readonly url: `/${string}`;
  readonly alt: string;
  readonly caption?: string;
  readonly sizes: string;
  readonly loading?: 'eager' | 'lazy';
  readonly fetchpriority?: 'auto' | 'high' | 'low';
  readonly focalPoint?: `${number}% ${number}%`;
};

const homeMedia = (input: HomeMediaInput): MediaAsset => {
  const asset = publicMediaFor(input.url, {
    alt: { kind: 'contextual', status: 'approved', text: input.alt },
    caption: input.caption,
    sizes: input.sizes,
    loading: input.loading,
    fetchpriority: input.fetchpriority,
    focalPoint: input.focalPoint,
  });

  if (!asset) {
    throw new Error(`[EditorialHome] Missing public media policy for ${input.url}`);
  }

  return asset;
};

const research = editorialRoutesForFamily('research').slice(0, 4);
const technology = editorialRoutesForFamily('technology').slice(0, 3);
const sciences = editorialRoutesForFamily('sciences').slice(0, 3);
const briefs = editorialRoutesForFamily('news').filter((route) => route.path !== '/news/').slice(0, 4);

const homeHeroSlides = [
  {
    image: {
      src: '/img/slider/jupiterstar.avif',
      alt: 'Jupiter and stars over deep space — exoplanet and interstellar research',
      caption: 'Deep-space observation / research domain',
      width: 1920,
      height: 751,
      sizes: '100vw',
      focalPoint: '50% 50%',
    },
    kicker: 'Deep-space research',
    title: 'DEEP SPACE EXPLORATION',
    description: 'Exoplanetary characterization, interstellar medium mapping, and multi-spectrum signal intelligence for deep-space observation beyond our solar system.',
    actions: [
      { href: '/mission/', label: 'Our mission', variant: 'primary' },
      { href: '/research/current-programs/', label: 'Review current programs', variant: 'secondary' },
    ],
  },
  {
    image: {
      src: '/img/slider/bulb.avif',
      alt: 'Glowing light bulb representing energy research and scientific innovation',
      caption: 'Energy systems / research at the infrastructure scale',
      width: 1920,
      height: 750,
      sizes: '100vw',
      focalPoint: '50% 50%',
    },
    kicker: 'Energy research',
    title: 'FUTURE OF ENERGY RESEARCH',
    description: 'Fusion plasma confinement, solid-state quantum batteries, and grid-scale superconducting storage systems for a post-carbon energy infrastructure.',
    actions: [
      { href: '/sciences/energy/', label: 'Energy R&D', variant: 'primary' },
      { href: '/research/funding/', label: 'Review energy funding', variant: 'secondary' },
    ],
  },
  {
    image: {
      src: '/img/slider/silicon.avif',
      alt: 'Silicon wafer circuitry — next-generation compute systems and HPC architecture',
      caption: 'AI compute / quantum systems / high-performance infrastructure',
      width: 1920,
      height: 750,
      sizes: '100vw',
      focalPoint: '50% 50%',
    },
    kicker: 'AI / quantum / HPC',
    title: 'NEXT-GEN COMPUTE SYSTEMS',
    description: 'Post-quantum cryptography, formally verified secure kernels, and neuromorphic HPC architectures for resilient autonomous systems and exascale AI.',
    actions: [
      { href: '/technology/computer-science/', label: 'Computing research', variant: 'primary' },
      { href: '/technology/quantum-computing/', label: 'Explore quantum computing', variant: 'secondary' },
    ],
  },
  {
    image: {
      src: '/img/slider/astro.avif',
      alt: 'Astronaut in orbit — orbital operations and space domain awareness research',
      caption: 'Orbital systems / autonomy / space domain awareness',
      width: 1920,
      height: 750,
      sizes: '100vw',
      focalPoint: '68% 50%',
    },
    kicker: 'Space systems',
    title: 'ORBITAL OPERATIONS',
    description: 'Space-hardened embedded systems, autonomous orbital robotics, and real-time space domain awareness for sustained human presence in low Earth orbit.',
    actions: [
      { href: '/sciences/outer-space/', label: 'LEO and beyond', variant: 'primary' },
      { href: '/tech-transfer/sttr-programs/', label: 'Explore STTR pathways', variant: 'secondary' },
    ],
  },
] as const;

const homeOrientationMedia = createPublicMedia({
  id: 'media:home-federal-research',
  url: '/img/projects/sovereign-ai.avif',
  type: 'photography-or-illustration',
  role: 'observation',
  alt: {
    kind: 'contextual',
    status: 'approved',
    text: 'A researcher checks cabling inside a server rack in a controlled computing facility.',
  },
  caption: 'Secure compute / make the method inspectable.',
  sizes: '(min-width: 58rem) 52vw, 100vw',
  focalPoint: '56% 50%',
  dimensions: { width: 800, height: 600 },
  provenance: {
    status: 'unverified',
    source: 'Existing repository asset at public/img/projects/sovereign-ai.avif; original source is not recorded.',
    license: 'Unverified; confirm ownership or license before publication.',
    note: 'Reused as a single homepage observation image; it contains no readable external claims.',
  },
  reuseReason: 'Homepage federal research orientation: connect the abstract question to mission-ready compute infrastructure.',
});

const homeInvitationMedia = homeMedia({
  url: '/img/about/about-image.avif',
  alt: 'An optical instrument with a violet beam at the center of a laboratory setup',
  sizes: '(min-width: 58rem) 30vw, 100vw',
  focalPoint: '50% 50%',
});

const homeProjects = [
  {
    href: '/labs/sovereign-ai/',
    kicker: 'Secure compute',
    title: 'Sovereign AI Laboratory',
    summary: 'Secure, private compute for frontier-model training, evaluation, and inference where data governance and mission assurance are part of the research problem.',
    cta: 'Review the capability',
    media: homeMedia({
      url: '/img/projects/homepage-sovereign-ai.avif',
      alt: 'Server racks in a secure computing facility for sovereign AI research',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/labs/biometric-security/',
    kicker: 'Applied sensing',
    title: 'Biometrics & drone sensing',
    summary: 'INSTAR researches advanced biometric sensing on phones and laptops without specialized hardware, alongside advanced drone sensing developed with a Department of War (DoW) federal contractor.',
    cta: 'Review the sensing program',
    media: homeMedia({
      url: '/img/projects/homepage-biometric-security.avif',
      alt: 'A modern smartphone and laptop with subtle biometric sensing cues beside a compact drone sensor platform in a dark laboratory',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/labs/cognitive-ai/',
    kicker: 'Machine intelligence',
    title: 'Cognitive AI & Persona Systems',
    summary: 'Research in language, cognition, and model behavior to improve reasoning, evaluation, and human-aligned AI systems.',
    cta: 'Review the research area',
    media: homeMedia({
      url: '/img/projects/homepage-cognitive-ai.avif',
      alt: 'Researchers working with code and machine-intelligence systems in a laboratory',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '50% 50%',
    }),
  },
] as const;

const homePathways = [
  {
    href: '/research/current-programs/',
    className: 'research',
    label: 'Research',
    title: 'Active programs and proposed directions.',
    summary: 'Review research questions, methods, and current areas where federal or institutional support can add capacity.',
    media: homeMedia({
      url: '/img/projects/cognitive-ai.avif',
      alt: 'A researcher working through a complex question at a warm-lit desk',
      caption: 'Research / review the program',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '52% 48%',
    }),
  },
  {
    href: '/technology/computer-science/',
    className: 'technology',
    label: 'Technology',
    title: 'Advanced methods and infrastructure.',
    summary: 'Examine AI, quantum, HPC, formal methods, and sensing capabilities that support ambitious science.',
    media: homeMedia({
      url: '/img/projects/quantum-lab.avif',
      alt: 'A high-performance computing room with illuminated racks and colorful cabling',
      caption: 'Technology / make the mechanism inspectable',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/sciences/physics/',
    className: 'sciences',
    label: 'Sciences',
    title: 'Applications across scientific domains.',
    summary: 'See how advanced AI and quantitative methods are applied across life, physical, earth, space, and social sciences.',
    media: homeMedia({
      url: '/img/projects/health-ai.avif',
      alt: 'An eye, hand, and fingerprint rendered as biometric research signals',
      caption: 'Sciences / follow the pattern across scales',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '50% 50%',
    }),
  },
] as const;

const homeGallery = [
  {
    href: '/technology/quantum-computing/',
    tone: 'quantum',
    media: homeMedia({
      url: '/img/gallery/gallery-one.avif',
      alt: 'Quantum processor with copper cooling lines in a close technical study',
      caption: 'Quantum systems',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/sciences/genetics/',
    tone: 'genetics',
    media: homeMedia({
      url: '/img/gallery/gallery-two.avif',
      alt: 'Illuminated DNA helix with cellular forms in the background',
      caption: 'Genetics and life sciences',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/technology/natural-language-processing/',
    tone: 'language',
    media: homeMedia({
      url: '/img/projects/nlp-tech-language-understanding.avif',
      alt: 'A researcher working across two monitors filled with language and systems notes',
      caption: 'Language and understanding',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '46% 50%',
    }),
  },
  {
    href: '/sciences/energy/',
    tone: 'warm-instrument',
    media: homeMedia({
      url: '/img/projects/tesla.avif',
      alt: 'A warm-lit electrical research apparatus on a laboratory workbench',
      caption: 'Energy systems',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 55%',
    }),
  },
  {
    href: '/technology/data-science/',
    tone: 'secure-compute',
    media: homeMedia({
      url: '/img/projects/devops.avif',
      alt: 'A secure server rack with amber and green status lights',
      caption: 'Data science and secure compute',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '56% 50%',
    }),
  },
  {
    href: '/technology/computer-science/',
    tone: 'robotic',
    media: homeMedia({
      url: '/img/projects/projects-seven.avif',
      alt: 'A robotic arm beside a transparent AI interface in a bright lab',
      caption: 'Robotics and applied AI',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '55% 50%',
    }),
  },
  {
    href: '/technology/machine-intelligence/',
    tone: 'network',
    media: homeMedia({
      url: '/img/gallery/gallery-three.avif',
      alt: 'Connected points forming a bright network against a dark field',
      caption: 'Networks and inference',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/research/facilities/',
    tone: 'orbital',
    media: homeMedia({
      url: '/img/gallery/gallery-eight.avif',
      alt: 'A polished scientific apparatus with solar panels against a dark field',
      caption: 'Lab systems and instrumentation',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
] as const;

const homeBriefMedia = [
  homeMedia({
    url: '/img/blog/blog-three.avif',
    alt: 'A machine-learning system visualized in a dark technical environment',
    sizes: '(min-width: 58rem) 25vw, 50vw',
    focalPoint: '58% 45%',
  }),
  homeMedia({
    url: '/img/pages/formal-methods/hero.avif',
    alt: 'A formal-methods workspace with equations and diagrams ready for inspection',
    sizes: '(min-width: 58rem) 25vw, 50vw',
    focalPoint: '50% 50%',
  }),
  homeMedia({
    url: '/img/blog/blog-two.avif',
    alt: 'Rows of servers carrying a high-performance computing workload',
    sizes: '(min-width: 58rem) 25vw, 50vw',
    focalPoint: '52% 50%',
  }),
  homeMedia({
    url: '/img/pages/law/hero.avif',
    alt: 'A law library and scales suggesting the governance questions around technology',
    sizes: '(min-width: 58rem) 25vw, 50vw',
    focalPoint: '50% 50%',
  }),
] as const;

const homeBriefCtas = [
  'Read the safety case',
  'Follow the proof',
  'See the compute constraints',
  'Read the governance frame',
] as const;

type HomePartnerInput = {
  readonly url: `/${string}`;
  readonly name: string;
  readonly alt: string;
  readonly href?: string;
};

const homePartner = (input: HomePartnerInput) => {
  const media = publicMediaFor(input.url, {
    alt: { kind: 'descriptive', status: 'approved', text: input.alt },
  });

  if (!media) {
    throw new Error(`[EditorialHome] Missing public media policy for ${input.url}`);
  }

  return { ...input, media };
};

const homePartnerMarks = [
  homePartner({ url: '/img/brand-logo/focus-hive.svg', name: 'Focus Hive', alt: 'Focus Hive Inc.', href: 'https://focushive.com' }),
  homePartner({ url: '/img/brand-logo/global-enterprise.svg', name: 'Global Enterprise', alt: 'Global Enterprise', href: 'https://globalenterprise.com' }),
  homePartner({ url: '/img/brand-logo/ravonics.svg', name: 'Ravonics', alt: 'Ravonics', href: 'https://ravonics.com' }),
  homePartner({ url: '/img/brand-logo/curiosity-research.svg', name: 'Curiosity Research', alt: 'Curiosity Research Corporation', href: 'https://curiositycorp.org' }),
  homePartner({ url: '/img/brand-logo/tao-learning.svg', name: 'Tao Learning', alt: 'Tao Learning', href: 'https://taolearning.org' }),
  homePartner({ url: '/img/brand-logo/dream-limited.svg', name: 'Dream Limited', alt: 'Dream Limited' }),
  homePartner({ url: '/img/brand-logo/world-enterprise-group.svg', name: 'World Enterprise Group', alt: 'World Enterprise Group' }),
] as const;

const homeLeadership = [
  {
    name: 'Suzanne Conejos',
    role: 'AI Lead Scientist · Board Member',
    media: homeMedia({
      url: '/img/volunteers/suzanne-conejos.avif',
      alt: 'Suzanne Conejos, AI Lead Scientist and Board Member',
      sizes: '(min-width: 58rem) 16vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    name: 'Sean Hackney',
    role: 'Board Member · AI Researcher',
    media: homeMedia({
      url: '/img/volunteers/sean-hackney.avif',
      alt: 'Sean Hackney, Board Member and AI Researcher',
      sizes: '(min-width: 58rem) 16vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    name: 'Dr. Spoogmay Khan',
    role: 'Applied Scientist · Materials Physics',
    media: homeMedia({
      url: '/img/volunteers/spoogmay-khan.avif',
      alt: 'Dr. Spoogmay Khan, Applied Scientist in Materials Physics',
      sizes: '(min-width: 58rem) 16vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    name: 'Maha Khan',
    role: 'Research Scientist',
    media: homeMedia({
      url: '/img/volunteers/maha-khan.avif',
      alt: 'Maha Khan, Research Scientist',
      sizes: '(min-width: 58rem) 16vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
] as const;
---

<SiteLayout
  title="INSTAR Lab — Research Institute"
  description="INSTAR Lab is a 501(c)(3) nonprofit research institute conducting applied research in artificial intelligence, quantum science, high-performance computing, health, energy, space, and the sciences for federal and institutional research partners."
  canonical="/"
  image="/img/slider/jupiterstar.avif"
  imageAlt="A deep-space field used as an orientation image for INSTAR Lab"
  bodyClass="editorial-home-page"
  mainClass="editorial-home-main"
>
  <article class="home-editorial" data-route="/" data-page-signature="orientation → observation → participation → evidence → connection → action">
    <HomeSlider slides={homeHeroSlides} id="home-hero-slider" ariaLabel="INSTAR Lab research highlights" titleId="home-title" />

    <section class="home-orientation home-container" aria-labelledby="home-orientation-title">
      <div class="home-section-label">For federal research partners</div>
      <div class="home-orientation__grid">
        <div class="home-orientation__copy">
          <h2 id="home-orientation-title">Put frontier science behind the question that matters.</h2>
          <p class="home-lead">INSTAR combines advanced AI, quantum research, high-performance computing, and domain science to turn ambitious objectives into testable programs. From energy and space to health, agriculture, and fundamental physics, we define the question, engineer the method, measure uncertainty, and deliver evidence, models, prototypes, or data a sponsor can evaluate.</p>
          <a class="home-orientation__cta" href="/research/our-process/">
            <span><small>Review the method</small>See how a program earns confidence</span>
            <Icon name="arrow-up-right" size="1.15rem" />
          </a>
          <a class="home-text-link" href="/contact-us/">Discuss a funding opportunity <Icon name="arrow-right" size="1rem" /></a>
        </div>
        <div class="home-orientation__media-shell">
          <EditorialMedia asset={homeOrientationMedia} figureClass="home-orientation__media" class="home-orientation__image" picture={false} />
        </div>
      </div>
    </section>

    <section class="home-observations" aria-labelledby="home-observations-title">
      <div class="home-container">
        <div class="home-observations__head">
          <div class="home-section-label">Research capacity</div>
          <h2 id="home-observations-title">Capabilities at the research frontier.</h2>
        </div>
        <ul class="home-projects">
          {homeProjects.map((project) => (
            <li class="home-project">
              <a class="home-project__link" href={project.href}>
                <EditorialMedia asset={project.media} figureClass="home-project__media" class="home-project__image" picture={false} />
                <div class="home-project__copy">
                  <span class="home-project__kicker">{project.kicker}</span>
                  <h3>{project.title}</h3>
                  <p>{project.summary}</p>
                  <span class="home-project__arrow">{project.cta} <Icon name="arrow-up-right" size="1rem" /></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-pathways" aria-labelledby="home-pathways-title">
      <div class="home-container">
        <div class="home-pathways__head">
          <div class="home-section-label home-section-label--light">Review the work by decision</div>
          <h2 id="home-pathways-title">Find the evidence a funding decision requires.</h2>
        </div>
        <div class="home-pathways__grid">
          {homePathways.map((pathway) => (
            <a class={`home-pathway home-pathway--${pathway.className}`} href={pathway.href}>
              <EditorialMedia asset={pathway.media} figureClass="home-pathway__media" class="home-pathway__image" picture={false} />
              <div class="home-pathway__copy">
                <span class="home-pathway__label">{pathway.label}</span>
                <h3>{pathway.title}</h3>
                <p>{pathway.summary}</p>
                <Icon name="arrow-up-right" size="1.15rem" class="home-pathway__arrow" />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ResearchConstellation />

    <section class="home-index home-container" aria-labelledby="home-index-title">
      <div class="home-index__head">
        <div class="home-index__lead">
          <div class="home-section-label">Research portfolio</div>
          <h2 id="home-index-title">Move from domain to program.</h2>
        </div>
        <p>Browse by research area, technical method, or scientific application, then review the program or capability behind it.</p>
      </div>
      <div class="home-index__columns">
        {[['Research', research], ['Technology', technology], ['Sciences', sciences]].map(([label, entries]) => (
          <section class="home-index__column" aria-labelledby={`home-index-${String(label).toLowerCase()}`}>
            <h3 id={`home-index-${String(label).toLowerCase()}`}>{label}</h3>
            <ul>
              {entries.map((entry) => (
                <li><a href={entry.path}><span>{entry.slug.replaceAll('-', ' ')}</span><Icon name="arrow-up-right" size="0.95rem" /></a></li>
              ))}
            </ul>
            <a class="home-text-link" href={label === 'Research' ? '/research/current-programs/' : label === 'Technology' ? '/technology/computer-science/' : '/sciences/physics/'}>Review {String(label).toLowerCase()} portfolio <Icon name="arrow-right" size="1rem" /></a>
          </section>
        ))}
      </div>
    </section>

    <section class="home-gallery" aria-labelledby="home-gallery-title">
      <div class="home-container">
        <div class="home-gallery__head">
          <div class="home-gallery__lead">
            <div class="home-section-label home-section-label--light">Advanced tools in the research stack</div>
            <h2 id="home-gallery-title">AI, quantum systems, data, and instrumentation.</h2>
          </div>
          <p>These are working methods for questions across the sciences—not technology claims detached from the research they are meant to support.</p>
        </div>
        <div class="home-gallery__grid">
          {homeGallery.map((item, index) => (
            <a class={`home-gallery__link home-gallery__link--${index + 1} home-gallery__link--tone-${item.tone}`} href={item.href} aria-label={`Explore ${item.media.caption ?? 'research'}`}>
              <EditorialMedia asset={item.media} figureClass="home-gallery__item" class="home-gallery__image" picture={false} />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-briefs" aria-labelledby="home-briefs-title">
      <div class="home-container">
        <div class="home-section-label home-section-label--light">Research briefs</div>
        <div class="home-briefs__head">
          <h2 id="home-briefs-title">Methods, risks, and findings in progress.</h2>
          <a class="home-text-link home-text-link--light" href="/news/">Read all research briefs <Icon name="arrow-right" size="1rem" /></a>
        </div>
        <ul class="home-briefs__grid">
          {briefs.map((brief, index) => (
            <li>
              <a href={brief.path}>
                <EditorialMedia asset={homeBriefMedia[index]} figureClass="home-briefs__media" class="home-briefs__image" picture={false} />
                <span class="home-briefs__family">{familyLabel(brief.family)}</span>
                <h3>{brief.title}</h3>
                <span class="home-briefs__arrow">{homeBriefCtas[index]} <Icon name="arrow-up-right" size="1rem" /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-partners" aria-labelledby="home-partners-title">
      <div class="home-container">
        <div class="home-partners__head">
          <div>
            <div class="home-section-label">Research network</div>
            <h2 id="home-partners-title">OUR PARTNERS</h2>
          </div>
          <div class="home-partners__intro">
            <a class="home-text-link" href="/research/consortium/">Review the INSTAR Consortium <Icon name="arrow-right" size="1rem" /></a>
          </div>
        </div>
        <div class="home-partners__grid" aria-label="INSTAR Consortium partner organizations">
          {homePartnerMarks.map((partner) => (
            partner.href ? (
              <a class="home-partner" href={partner.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${partner.name} (opens in a new tab)`}>
                <EditorialMedia asset={partner.media} figureClass="home-partner__mark" class="home-partner__image" picture={false} />
                <span class="home-partner__name">{partner.name}<Icon name="external-link" size="0.9rem" /></span>
              </a>
            ) : (
              <div class="home-partner" aria-label={partner.name}>
                <EditorialMedia asset={partner.media} figureClass="home-partner__mark" class="home-partner__image" picture={false} />
                <span class="home-partner__name">{partner.name}</span>
              </div>
            )
          ))}
        </div>
      </div>
    </section>

