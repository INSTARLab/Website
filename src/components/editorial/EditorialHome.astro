---
import ResearchConstellation from '../interactive/ResearchConstellation.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import EditorialMedia from './media/EditorialMedia.astro';
import {
  editorialRoutesForFamily,
  familyLabel,
} from '../../data/editorialRoutes';
import { publicMediaFor } from '../../data/media';
import type { MediaAsset } from '../../data/media/types';

type HomeMediaInput = {
  readonly url: `/${string}`;
  readonly alt: string;
  readonly caption?: string;
  readonly sizes: string;
  readonly loading?: 'eager' | 'lazy';
  readonly fetchpriority?: 'auto' | 'high' | 'low';
  readonly focalPoint?: `${number}% ${number}%`;
};

const homeMedia = (input: HomeMediaInput): MediaAsset => {
  const asset = publicMediaFor(input.url, {
    alt: { kind: 'contextual', status: 'approved', text: input.alt },
    caption: input.caption,
    sizes: input.sizes,
    loading: input.loading,
    fetchpriority: input.fetchpriority,
    focalPoint: input.focalPoint,
  });

  if (!asset) {
    throw new Error(`[EditorialHome] Missing public media policy for ${input.url}`);
  }

  return asset;
};

const research = editorialRoutesForFamily('research').slice(0, 4);
const technology = editorialRoutesForFamily('technology').slice(0, 3);
const sciences = editorialRoutesForFamily('sciences').slice(0, 3);
const briefs = editorialRoutesForFamily('news').filter((route) => route.path !== '/news/').slice(0, 4);

const homeHero = homeMedia({
  url: '/img/slider/jupiterstar.avif',
  alt: 'Jupiter and its rings against deep space, an orientation image for INSTAR Lab research',
  caption: '01 / Curiosity is a starting condition. Rigor is the direction.',
  sizes: '100vw',
  loading: 'eager',
  fetchpriority: 'high',
  focalPoint: '50% 50%',
});

const homeInvitationMedia = homeMedia({
  url: '/img/about/about-image.avif',
  alt: 'An optical instrument with a violet beam at the center of a laboratory setup',
  sizes: '(min-width: 58rem) 30vw, 100vw',
  focalPoint: '50% 50%',
});

const homeProjects = [
  {
    href: '/labs/sovereign-ai/',
    kicker: '01 / Secure compute',
    title: 'Sovereign AI Laboratory',
    summary: 'Air-gapped frontier model training, secure inference, and autonomous reasoning on private infrastructure.',
    media: homeMedia({
      url: '/img/projects/homepage-sovereign-ai.avif',
      alt: 'Server racks in a secure computing facility for sovereign AI research',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/labs/biometric-security/',
    kicker: '02 / Human signals',
    title: 'Biometric Security Systems',
    summary: 'Multi-modal bioinformatic authentication across genomic markers, neural gait, and vascular topology.',
    media: homeMedia({
      url: '/img/projects/homepage-biometric-security.avif',
      alt: 'Biometric imaging instruments in a laboratory environment',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/labs/cognitive-ai/',
    kicker: '03 / Machine intelligence',
    title: 'Cognitive AI & Persona Systems',
    summary: 'Psycholinguistic modeling, personality architectures, and AI personification through inference shaping.',
    media: homeMedia({
      url: '/img/projects/homepage-cognitive-ai.avif',
      alt: 'Researchers working with code and machine-intelligence systems in a laboratory',
      sizes: '(min-width: 58rem) 30vw, 100vw',
      focalPoint: '50% 50%',
    }),
  },
] as const;

const homeGallery = [
  {
    href: '/technology/quantum-computing/',
    media: homeMedia({
      url: '/img/gallery/gallery-one.avif',
      alt: 'Quantum processor with copper cooling lines in a close technical study',
      caption: 'Quantum systems',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/sciences/genetics/',
    media: homeMedia({
      url: '/img/gallery/gallery-two.avif',
      alt: 'Illuminated DNA helix with cellular forms in the background',
      caption: 'Health and life sciences',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/technology/natural-language-processing/',
    media: homeMedia({
      url: '/img/gallery/gallery-three.avif',
      alt: 'Connected points forming a bright network against a dark field',
      caption: 'Language and networks',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/sciences/energy/',
    media: homeMedia({
      url: '/img/gallery/gallery-four.avif',
      alt: 'A polished research apparatus framed by two solar panels',
      caption: 'Energy systems',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/technology/data-science/',
    media: homeMedia({
      url: '/img/gallery/gallery-five.avif',
      alt: 'Abstract data field suggesting high-dimensional analysis',
      caption: 'Data science',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/technology/computer-science/',
    media: homeMedia({
      url: '/img/gallery/gallery-six.avif',
      alt: 'A computational visualization for large-scale scientific simulation',
      caption: 'HPC simulation',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/technology/machine-intelligence/',
    media: homeMedia({
      url: '/img/gallery/gallery-seven.avif',
      alt: 'Glowing nodes and lines representing an AI platform architecture',
      caption: 'AI platforms',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
  {
    href: '/research/facilities/',
    media: homeMedia({
      url: '/img/gallery/gallery-eight.avif',
      alt: 'A scientific instrument with solar panels in a dark laboratory setting',
      caption: 'Lab systems',
      sizes: '(min-width: 58rem) 25vw, 50vw',
      focalPoint: '50% 50%',
    }),
  },
] as const;
---

<SiteLayout
  title="INSTAR Lab — Independent Nonprofit Research Institute"
  description="INSTAR Lab is an independent 501(c)(3) nonprofit research institute advancing applied research in AI, quantum science, HPC, health, energy, and space through interdisciplinary collaboration."
  canonical="/"
  image="/img/slider/jupiterstar.avif"
  imageAlt="A deep-space field used as an orientation image for INSTAR Lab"
  bodyClass="editorial-home-page"
  mainClass="editorial-home-main"
>
  <article class="home-editorial" data-route="/" data-page-signature="orientation → observation → participation → evidence → connection → action">
    <section class="home-masthead" aria-labelledby="home-title">
      <EditorialMedia asset={homeHero} figureClass="home-masthead__media" class="home-masthead__image" picture={false} />
      <div class="home-container home-masthead__grid">
        <div class="home-masthead__copy">
          <p class="home-kicker">Independent / interdisciplinary / public benefit</p>
          <h1 id="home-title">The next useful question is usually between fields.</h1>
          <p class="home-masthead__dek">INSTAR Lab is a nonprofit research institute for people who want to understand a hard problem deeply enough to move it forward.</p>
          <div class="home-masthead__actions">
            <a class="home-button home-button--solid" href="/research/current-programs/">Explore current programs <span aria-hidden="true">↗</span></a>
            <a class="home-button home-button--line" href="/mission/">Read the method</a>
          </div>
        </div>
      </div>
    </section>

    <section class="home-orientation home-container" aria-labelledby="home-orientation-title">
      <div class="home-section-label"><span>01</span><span>Orientation</span></div>
      <div class="home-orientation__grid">
        <h2 id="home-orientation-title">A lab for work that needs more than one lens.</h2>
        <div>
          <p class="home-lead">We connect scientific questions to methods, technologies, people, and public-benefit paths—without hiding the uncertainty between them.</p>
          <a class="home-text-link" href="/community/about-us/">Understand who we are <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="home-observations" aria-labelledby="home-observations-title">
      <div class="home-container">
        <div class="home-section-label"><span>02</span><span>Observation</span></div>
        <div class="home-observations__head">
          <h2 id="home-observations-title">Research, in the material world.</h2>
          <p>Three active directions show how questions become instruments, systems, and careful work.</p>
        </div>
        <ul class="home-projects">
          {homeProjects.map((project) => (
            <li class="home-project">
              <a class="home-project__link" href={project.href}>
                <EditorialMedia asset={project.media} figureClass="home-project__media" class="home-project__image" picture={false} />
                <div class="home-project__copy">
                  <span class="home-project__kicker">{project.kicker}</span>
                  <h3>{project.title}</h3>
                  <p>{project.summary}</p>
                  <span class="home-project__arrow" aria-hidden="true">Open the lab ↗</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-pathways" aria-labelledby="home-pathways-title">
      <div class="home-container">
        <div class="home-section-label home-section-label--light"><span>03</span><span>Choose a lens</span></div>
        <div class="home-pathways__head">
          <h2 id="home-pathways-title">Start where your question is most alive.</h2>
          <p>Three ways into the same commitment: open inquiry, careful method, useful transmission.</p>
        </div>
        <div class="home-pathways__grid">
          <a class="home-pathway home-pathway--research" href="/research/current-programs/">
            <span class="home-pathway__number">01 / Research</span>
            <h3>Programs with a question at the center.</h3>
            <p>See what the Lab is working on now and where collaborators can add leverage.</p>
            <span class="home-pathway__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="home-pathway home-pathway--technology" href="/technology/computer-science/">
            <span class="home-pathway__number">02 / Technology</span>
            <h3>Methods that make difficult work possible.</h3>
            <p>Trace the computing, sensing, formal, and machine-intelligence systems behind the questions.</p>
            <span class="home-pathway__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="home-pathway home-pathway--sciences" href="/sciences/physics/">
            <span class="home-pathway__number">03 / Sciences</span>
            <h3>Disciplines that refuse to stay separate.</h3>
            <p>Move from a field of study to the evidence, tools, and public questions it can illuminate.</p>
            <span class="home-pathway__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <ResearchConstellation />

    <section class="home-index home-container" aria-labelledby="home-index-title">
      <div class="home-section-label"><span>04</span><span>Field index</span></div>
      <div class="home-index__head">
        <h2 id="home-index-title">Move laterally.</h2>
        <p>Use adjacent routes to turn a broad interest into a more exact next step.</p>
      </div>
      <div class="home-index__columns">
        {[['Research', research], ['Technology', technology], ['Sciences', sciences]].map(([label, entries]) => (
          <section class="home-index__column" aria-labelledby={`home-index-${String(label).toLowerCase()}`}>
            <h3 id={`home-index-${String(label).toLowerCase()}`}>{label}</h3>
            <ul>
              {entries.map((entry) => (
                <li><a href={entry.path}><span>{entry.slug.replaceAll('-', ' ')}</span><span aria-hidden="true">↗</span></a></li>
              ))}
            </ul>
            <a class="home-text-link" href={label === 'Research' ? '/research/current-programs/' : label === 'Technology' ? '/technology/computer-science/' : '/sciences/physics/'}>Open {String(label).toLowerCase()} index <span aria-hidden="true">→</span></a>
          </section>
        ))}
      </div>
    </section>

    <section class="home-gallery" aria-labelledby="home-gallery-title">
      <div class="home-container">
        <div class="home-section-label home-section-label--light"><span>05</span><span>Research in view</span></div>
        <div class="home-gallery__head">
          <h2 id="home-gallery-title">Eight ways into the same questions.</h2>
          <p>Look closely at the instruments, systems, and abstractions that give interdisciplinary work somewhere to begin.</p>
        </div>
        <div class="home-gallery__grid">
          {homeGallery.map((item, index) => (
            <a class={`home-gallery__link home-gallery__link--${index + 1}`} href={item.href} aria-label={`Explore ${item.media.caption ?? 'research'}`}>
              <EditorialMedia asset={item.media} figureClass="home-gallery__item" class="home-gallery__image" picture={false} />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-briefs" aria-labelledby="home-briefs-title">
      <div class="home-container">
        <div class="home-section-label home-section-label--light"><span>06</span><span>Research briefs</span></div>
        <div class="home-briefs__head">
          <h2 id="home-briefs-title">Ideas in motion.</h2>
          <a class="home-text-link home-text-link--light" href="/news/">View all briefs <span aria-hidden="true">→</span></a>
        </div>
        <ul class="home-briefs__grid">
          {briefs.map((brief, index) => (
            <li>
              <a href={brief.path}>
                <span class="home-briefs__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="home-briefs__family">{familyLabel(brief.family)}</span>
                <h3>{brief.title}</h3>
                <span class="home-briefs__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="home-invitation home-container" aria-labelledby="home-invitation-title">
      <EditorialMedia asset={homeInvitationMedia} figureClass="home-invitation__media" class="home-invitation__image" picture={false} />
      <div class="home-invitation__copy">
        <div class="home-section-label"><span>07</span><span>Invitation</span></div>
        <h2 id="home-invitation-title">Bring the question that does not have a home yet.</h2>
        <p>Tell us what you are trying to learn, build, test, or make public. The first useful step is often a better framing.</p>
        <a class="home-button home-button--solid" href="/contact-us/">Start a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </article>
</SiteLayout>

<style>
  .home-editorial { --home-dark: #0b1626; --home-teal: #7fd7ea; background: var(--color-canvas); }
  .home-container { width: min(100% - 2 * var(--spacing-gutter), 90rem); margin-inline: auto; }

  .home-masthead { position: relative; isolation: isolate; min-block-size: min(46rem, calc(100svh - 8rem)); overflow: clip; color: #fff; background: var(--home-dark); }
  :global(.home-masthead__media) { position: absolute; z-index: -1; inset: 0; margin: 0; background: var(--home-dark); }
  :global(.home-masthead__media::after) { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(11 22 38 / 0.96) 0%, rgb(11 22 38 / 0.82) 32%, rgb(11 22 38 / 0.22) 72%, rgb(11 22 38 / 0.1) 100%), linear-gradient(0deg, rgb(11 22 38 / 0.48), transparent 38%); content: ''; }
  :global(.home-masthead__media img) { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: center; filter: saturate(0.86) contrast(1.06); }
  :global(.home-masthead__media figcaption) { position: absolute; z-index: 1; inset-inline: var(--spacing-gutter); inset-block-end: 1.5rem; display: flex; gap: 0.7rem; max-inline-size: 30rem; color: #fff; font: 0.74rem/1.4 var(--font-ui); text-shadow: 0 1px 12px rgb(0 0 0 / 0.6); }
  :global(.home-masthead__media figcaption::before) { inline-size: 1.8rem; block-size: 2px; flex: none; margin-block-start: 0.55rem; background: var(--home-teal); content: ''; }
  .home-masthead__grid { position: relative; z-index: 1; display: flex; align-items: center; min-block-size: inherit; }
  .home-masthead__copy { inline-size: min(100%, 44rem); padding-block: clamp(4.5rem, 9vw, 7rem); padding-inline-end: clamp(2rem, 6vw, 7rem); }
  .home-kicker, .home-section-label, .home-pathway__number, .home-briefs__family, .home-project__kicker { font: 700 0.72rem/1.25 var(--font-ui); letter-spacing: 0.13em; text-transform: uppercase; }
  .home-kicker { margin-block-end: 1.6rem; color: var(--home-teal); }
  .home-masthead h1 { max-inline-size: 15ch; margin: 0; color: #fff; font-size: clamp(2.55rem, 4.2vw, 4.75rem); letter-spacing: -0.045em; line-height: 0.99; }
  .home-masthead__dek { max-inline-size: 48ch; margin-block: 1.75rem 0; color: rgb(255 255 255 / 0.78); font-size: clamp(1rem, 0.96rem + 0.22vw, 1.2rem); line-height: 1.55; }
  .home-masthead__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-block-start: 1.8rem; }
  .home-button { display: inline-flex; align-items: center; gap: 0.7rem; min-block-size: 2.85rem; padding: 0.8rem 1rem; font: 700 0.78rem/1 var(--font-ui); text-decoration: none; transition: transform 180ms ease, background-color 180ms ease, color 180ms ease; }
  .home-button:hover { transform: translateY(-2px); }
  .home-button--solid { color: #06121c; background: var(--home-teal); }
  .home-button--solid:hover { color: #fff; background: var(--color-brand); }
  .home-button--line { border: 1px solid rgb(255 255 255 / 0.42); color: #fff; }
  .home-button--line:hover { color: var(--home-dark); background: #fff; }

  .home-section-label { display: flex; align-items: center; gap: 0.75rem; color: var(--color-brand); }
  .home-section-label span:first-child { color: var(--color-muted); }
  .home-section-label--light { color: var(--home-teal); }
  .home-section-label--light span:first-child { color: rgb(255 255 255 / 0.55); }
  .home-orientation { padding-block: clamp(4.5rem, 9vw, 7.5rem); }
  .home-orientation__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr); gap: clamp(2rem, 8vw, 8rem); margin-block-start: 2rem; }
  .home-orientation h2, .home-pathways h2, .home-index h2, .home-gallery h2, .home-briefs h2, .home-invitation h2 { margin: 0; font-size: clamp(2rem, 3.2vw, 3.7rem); letter-spacing: -0.045em; line-height: 1.02; }
  .home-orientation h2 { max-inline-size: 18ch; }
  .home-lead { max-inline-size: 50ch; margin: 0; color: var(--color-muted-strong); font-size: clamp(1.05rem, 1rem + 0.22vw, 1.24rem); line-height: 1.6; }
  .home-text-link { display: inline-flex; gap: 0.65rem; margin-block-start: 1.25rem; color: var(--color-ink); font: 700 0.78rem/1 var(--font-ui); text-decoration: none; }
  .home-text-link:hover { color: var(--color-brand); }

  .home-observations { padding-block: clamp(4.5rem, 9vw, 7.5rem); border-block: 1px solid var(--color-rule); background: var(--color-surface); }
  .home-observations__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.6fr); align-items: end; gap: 2rem; margin-block: 1.8rem 2.8rem; }
  .home-observations h2 { max-inline-size: 16ch; }
  .home-observations__head p { max-inline-size: 34ch; margin: 0; color: var(--color-muted-strong); line-height: 1.55; }
  .home-projects { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 2rem); padding: 0; margin: 0; list-style: none; }
  .home-project { min-inline-size: 0; border: 1px solid var(--color-rule); background: var(--color-surface-raised); }
  .home-project__link { display: flex; flex-direction: column; block-size: 100%; color: inherit; text-decoration: none; }
  :global(.home-project__media) { aspect-ratio: 4 / 3; overflow: hidden; margin: 0; background: #0c1a2a; }
  :global(.home-project__media img) { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 240ms ease; }
  :global(.home-project__media figcaption) { display: none; }
  .home-project__copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 1.2rem 1.3rem 1.35rem; }
  .home-project__kicker { color: var(--color-brand-deep); }
  .home-project h3 { max-inline-size: 18ch; margin: 1rem 0 0; font-size: clamp(1.35rem, 1.7vw, 1.8rem); letter-spacing: -0.025em; line-height: 1.08; }
  .home-project p { max-inline-size: 34ch; margin-block: 0.75rem 0; color: var(--color-muted-strong); font-size: 0.96rem; line-height: 1.5; }
  .home-project__arrow { margin-block-start: auto; padding-block-start: 1.25rem; color: var(--color-brand-deep); font: 700 0.78rem/1 var(--font-ui); }
  :global(.home-project__link:hover .home-project__media img) { transform: scale(1.035); }

  .home-pathways, .home-briefs { padding-block: clamp(4.5rem, 9vw, 7.5rem); color: #fff; background: var(--home-dark); }
  .home-pathways__head, .home-briefs__head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block: 1.8rem 3rem; }
  .home-pathways h2, .home-briefs h2 { max-inline-size: 16ch; color: #fff; }
  .home-pathways__head p { max-inline-size: 30ch; margin: 0; color: rgb(255 255 255 / 0.68); }
  .home-pathways__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; border-block-start: 1px solid rgb(255 255 255 / 0.2); }
  .home-pathway { position: relative; min-block-size: 19rem; padding: 1.35rem; border-inline-end: 1px solid rgb(255 255 255 / 0.2); border-block-end: 1px solid rgb(255 255 255 / 0.2); color: #fff; text-decoration: none; }
  .home-pathway:last-child { border-inline-end: 0; }
  .home-pathway__number { color: var(--home-teal); }
  .home-pathway h3 { max-inline-size: 16ch; margin: 3.6rem 0 0; color: #fff; font-size: clamp(1.35rem, 1.8vw, 1.8rem); letter-spacing: -0.025em; line-height: 1.05; }
  .home-pathway p { max-inline-size: 30ch; margin-block: 1rem 0; color: rgb(255 255 255 / 0.66); font-size: 0.94rem; line-height: 1.5; }
  .home-pathway__arrow { position: absolute; inset-inline-end: 1.35rem; inset-block-end: 1.1rem; color: var(--home-teal); font-size: 1.25rem; }
  .home-pathway:hover { background: rgb(255 255 255 / 0.06); }

  .home-index { padding-block: clamp(4.5rem, 9vw, 7.5rem); }
  .home-index__head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block: 1.8rem 3rem; }
  .home-index h2 { max-inline-size: 12ch; }
  .home-index__head p { max-inline-size: 28ch; margin: 0; color: var(--color-muted-strong); }
  .home-index__columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 4rem); }
  .home-index__column { border-block-start: 3px solid var(--color-brand); }
  .home-index__column:nth-child(2) { border-color: #07858d; }
  .home-index__column:nth-child(3) { border-color: #6254a4; }
  .home-index__column h3 { margin-block: 1rem 1.3rem; font-size: 1.2rem; }
  .home-index__column ul { padding: 0; margin: 0; list-style: none; }
  .home-index__column li { border-block-end: 1px solid var(--color-rule); }
  .home-index__column li a { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.72rem; color: var(--color-ink); font-size: 0.96rem; text-decoration: none; text-transform: capitalize; }
