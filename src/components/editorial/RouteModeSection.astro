---
import type { EditorialRoute, EditorialRouteMedia, EditorialVisualMode } from '../../data/editorialRoutes';
import { familyLabel, familyRoot } from '../../data/editorialRoutes';
import EditorialMedia from './media/EditorialMedia.astro';
import { createPublicMedia } from '../../utils/media/records';

interface Props {
  readonly mode: Exclude<EditorialVisualMode, 'orientation' | 'connection'>;
  readonly index: number;
  readonly route: EditorialRoute;
}

const { mode, index, route } = Astro.props;
const headingId = `route-mode-${index}-${mode}`;
const media = route.primaryMedia
  ? createPublicMedia({
      id: `media:route-${route.slug}-support` as `media:${string}`,
      url: route.primaryMedia.src,
      type: 'photography-or-illustration',
      role: 'observation',
      alt: {
        kind: 'contextual',
        status: 'review-required',
        text: route.primaryMedia.alt,
      },
      dimensions: {
        width: route.primaryMedia.width,
        height: route.primaryMedia.height,
      },
      sizes: '(min-width: 64rem) 42vw, 100vw',
      loading: 'lazy',
      fetchpriority: 'auto',
      focalPoint: route.primaryMedia.focalPoint,
      provenance: {
        status: 'unverified',
        source: 'Repository asset; original source is not recorded.',
        license: 'Unverified; confirm ownership or license before publication.',
        note: 'Inherited route visual. Confirm source and usage rights with the media owner before publication.',
      },
      caption: route.primaryMedia.caption,
    })
  : undefined;

const modeLabels: Record<Exclude<EditorialVisualMode, 'orientation' | 'connection'>, string> = {
  evidence: 'Evidence board',
  observation: 'Field note',
  sequence: 'Working sequence',
  contrast: 'Boundary check',
  participation: 'Choose a next move',
};

const modeDescriptions: Record<Exclude<EditorialVisualMode, 'orientation' | 'connection'>, string> = {
  evidence: 'A claim is more useful when the reader can see the question, the context, and the limit together.',
  observation: 'A concrete visual gives the question a place to land before the reader moves into interpretation.',
  sequence: 'Use this order as a practical way to move from a broad question to a more specific decision.',
  contrast: 'The most credible route names what still needs evidence, context, or a different kind of conversation.',
  participation: 'Choose the next action that matches how much context you have and what you are ready to do.',
};

const subject = route.title.replace(/\s+—.*$/, '').trim();
---

<section class:list={['route-mode', `route-mode--${mode}`]} aria-labelledby={headingId}>
  <div class="route-mode__container">
    <div class="route-mode__label">
      <span>{String(index).padStart(2, '0')}</span>
      <span>{modeLabels[mode]}</span>
    </div>

    {mode === 'observation' ? (
      <div class="route-mode__observation">
        {media ? (
          <EditorialMedia
            asset={media}
            figureClass="route-mode__figure"
            class="route-mode__image"
            picture={false}
          />
        ) : (
          <div class="route-mode__field-mark" aria-hidden="true">
            <span>INSTAR</span>
            <strong>FIELD<br />NOTE</strong>
          </div>
        )}
        <div class="route-mode__copy">
          <p class="route-mode__eyebrow">Observation / {familyLabel(route.family)}</p>
          <h2 id={headingId}>Hold the question in view.</h2>
          <p>{modeDescriptions[mode]}</p>
          <p class="route-mode__lead">{route.pageJob}</p>
        </div>
      </div>
    ) : mode === 'evidence' ? (
      <div class="route-mode__evidence">
        <div class="route-mode__intro">
          <p class="route-mode__eyebrow">Evidence / {subject}</p>
          <h2 id={headingId}>Make the reasoning inspectable.</h2>
          <p>{modeDescriptions[mode]}</p>
        </div>
        <ol class="route-mode__evidence-grid">
          <li>
            <span>01 / Question</span>
            <strong>What brought you here?</strong>
            <p>{route.pageJob}</p>
          </li>
          <li>
            <span>02 / Context</span>
            <strong>What context should shape the examination?</strong>
            <p>{route.description}</p>
          </li>
          <li>
            <span>03 / Boundary</span>
            <strong>What needs a closer conversation?</strong>
            <p>{route.earlyAction}</p>
          </li>
        </ol>
      </div>
    ) : mode === 'sequence' ? (
      <div class="route-mode__sequence">
        <div class="route-mode__intro">
          <p class="route-mode__eyebrow">Sequence / a usable approach</p>
          <h2 id={headingId}>Move from question to next step.</h2>
          <p>{modeDescriptions[mode]}</p>
        </div>
        <ol class="route-mode__steps">
          <li><span>01</span><div><strong>Frame</strong><p>{route.pageJob}</p></div></li>
          <li><span>02</span><div><strong>Examine</strong><p>{route.description}</p></div></li>
          <li><span>03</span><div><strong>Move</strong><p>{route.readyAction}</p></div></li>
        </ol>
      </div>
    ) : mode === 'contrast' ? (
      <div class="route-mode__contrast">
        <p class="route-mode__eyebrow">Boundary / keep the limit visible</p>
        <h2 id={headingId}>A useful page does not close the question too early.</h2>
        <div class="route-mode__contrast-copy">
          <p>{modeDescriptions[mode]}</p>
          <p><strong>Still exploring?</strong> {route.earlyAction}</p>
          <p><strong>Ready to act?</strong> {route.readyAction}</p>
        </div>
      </div>
    ) : (
      <div class="route-mode__participation">
        <div class="route-mode__intro">
          <p class="route-mode__eyebrow">Participation / choose a direction</p>
          <h2 id={headingId}>Leave with a move you can actually make.</h2>
          <p>{modeDescriptions[mode]}</p>
        </div>
        <div class="route-mode__choices">
          <a href="/contact-us/">
            <span>Ready</span>
            <strong>{route.readyAction}</strong>
            <em aria-hidden="true">↗</em>
          </a>
          <a href={familyRoot(route.family)}>
            <span>Exploring</span>
            <strong>{route.earlyAction}</strong>
            <em aria-hidden="true">→</em>
          </a>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .route-mode { border-block-start: 1px solid var(--color-rule); }
  .route-mode__container { width: min(100% - 2 * var(--spacing-gutter), 90rem); margin-inline: auto; padding-block: clamp(4.5rem, 10vw, 9rem); }
  .route-mode__label, .route-mode__eyebrow, .route-mode__evidence-grid span, .route-mode__choices span { color: var(--route-accent); font-family: var(--font-ui); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.13em; line-height: 1.3; text-transform: uppercase; }
  .route-mode__label { display: flex; gap: 0.75rem; align-items: center; margin-block-end: 2.5rem; }
  .route-mode__label span:first-child { color: var(--color-muted); }
  .route-mode h2 { max-inline-size: 13ch; margin: 0; color: var(--color-ink); font-size: clamp(2.3rem, 5vw, 5.5rem); letter-spacing: -0.07em; line-height: 0.94; }
  .route-mode p { color: var(--color-muted-strong); }
  .route-mode__intro > p:last-child { max-inline-size: 34rem; margin-block-start: 1.3rem; }

  .route-mode--observation { background: var(--color-surface); }
  .route-mode__observation { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr); align-items: center; gap: clamp(2rem, 8vw, 9rem); }
  .route-mode__figure { min-inline-size: 0; margin: 0; overflow: hidden; background: var(--route-dark); }
  .route-mode__image { inline-size: 100%; aspect-ratio: 1.5; object-fit: cover; filter: saturate(0.88) contrast(1.04); }
  .route-mode__figure figcaption { padding: 0.8rem 1rem; color: var(--color-muted-strong); font-family: var(--font-ui); font-size: 0.74rem; }
  .route-mode__copy h2 { margin-block-start: 1rem; }
  .route-mode__copy > p:not(.route-mode__eyebrow) { max-inline-size: 36ch; margin-block-start: 1.3rem; }
  .route-mode__copy .route-mode__lead { color: var(--color-ink); font-size: clamp(1.15rem, 1rem + 0.45vw, 1.4rem); line-height: 1.5; }
  .route-mode__field-mark { display: grid; place-items: center; aspect-ratio: 1.5; border: 1px solid var(--route-accent); color: var(--route-accent); font-family: var(--font-ui); letter-spacing: 0.15em; text-align: center; }
  .route-mode__field-mark strong { margin-block-start: 1rem; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 4.5rem); letter-spacing: -0.07em; line-height: 0.85; }

  .route-mode--evidence { background: var(--color-canvas); }
  .route-mode__evidence { display: grid; grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 8vw, 9rem); }
  .route-mode__evidence-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; align-self: start; padding: 0; margin: 0; list-style: none; background: var(--color-rule); }
  .route-mode__evidence-grid li { min-block-size: 20rem; padding: 1.25rem; background: var(--color-surface); }
  .route-mode__evidence-grid strong { display: block; margin-block-start: 2.5rem; color: var(--color-ink); font-family: var(--font-display); font-size: 1.45rem; line-height: 1.05; }
  .route-mode__evidence-grid p { margin-block-start: 1rem; font-size: 0.94rem; }

  .route-mode--sequence { background: var(--color-canvas); }
  .route-mode__sequence { display: grid; grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 8vw, 9rem); }
  .route-mode__steps { display: grid; gap: 0; padding: 0; margin: 0; list-style: none; border-block-start: 1px solid var(--color-rule); }
  .route-mode__steps li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1.25rem; padding-block: 1.5rem; border-block-end: 1px solid var(--color-rule); }
  .route-mode__steps li > span { color: var(--route-accent); font: 800 0.75rem/1.3 var(--font-ui); }
  .route-mode__steps strong { color: var(--color-ink); font-family: var(--font-display); font-size: 1.5rem; }
  .route-mode__steps p { margin-block-start: 0.35rem; }

  .route-mode--contrast { color: #fff; background: var(--route-dark); }
  .route-mode--contrast h2 { color: #fff; }
  .route-mode--contrast .route-mode__label { color: var(--route-accent-on-dark); }
  .route-mode--contrast .route-mode__label span:first-child { color: rgb(255 255 255 / 0.68); }
  .route-mode--contrast .route-mode__eyebrow { color: var(--route-accent-on-dark); }
  .route-mode__contrast { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(15rem, 0.7fr); gap: clamp(2rem, 6vw, 7rem); align-items: start; }
  .route-mode__contrast-copy { padding-block-start: 0.35rem; }
  .route-mode__contrast-copy p { color: rgb(255 255 255 / 0.7); }
  .route-mode__contrast-copy p + p { margin-block-start: 1.2rem; }
  .route-mode__contrast-copy strong { color: #fff; }

  .route-mode--participation { background: var(--color-surface); }
  .route-mode__participation { display: grid; grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 8vw, 9rem); }
  .route-mode__choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; align-self: start; background: var(--color-rule); }
  .route-mode__choices a { position: relative; display: flex; flex-direction: column; min-block-size: 16rem; padding: 1.4rem; color: var(--color-ink); background: var(--color-canvas); text-decoration: none; }
  .route-mode__choices a:hover { background: var(--color-surface-raised); }
  .route-mode__choices strong { max-inline-size: 18ch; margin-block-start: 2.6rem; font-family: var(--font-display); font-size: clamp(1.3rem, 2vw, 2rem); line-height: 1.05; }
  .route-mode__choices em { position: absolute; inset-inline-end: 1.25rem; inset-block-end: 1rem; color: var(--route-accent); font-size: 1.4rem; font-style: normal; }

  @media (max-width: 58rem) {
    .route-mode__observation, .route-mode__evidence, .route-mode__sequence, .route-mode__participation, .route-mode__contrast { grid-template-columns: 1fr; gap: 2.5rem; }
    .route-mode__contrast { display: grid; }
  }

  @media (max-width: 42rem) {
    .route-mode__evidence-grid, .route-mode__choices { grid-template-columns: 1fr; }
    .route-mode__evidence-grid li { min-block-size: auto; }
    .route-mode__choices a { min-block-size: 13rem; }
  }
</style>
