---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  familyLabel,
  familyRoot,
  type EditorialVisualMode,
  type EditorialRoute as EditorialRouteData,
} from '../../data/editorialRoutes';
import { publicMediaFor } from '../../data/media';
import { createPublicMedia } from '../../utils/media/records';
import EditorialMedia from './media/EditorialMedia.astro';
import RouteModeSection from './RouteModeSection.astro';

interface Props {
  route: EditorialRouteData;
  related: readonly EditorialRouteData[];
}

const { route, related } = Astro.props;
const modeLabel = (mode: string) => mode.replaceAll('-', ' ');
const primaryHref = familyRoot(route.family);
const isArticle = route.type === 'article';
const signature = route.signature.slice(0, 5);
const modeSections = route.signature.filter(
  (mode): mode is Exclude<EditorialVisualMode, 'orientation' | 'connection'> => mode !== 'orientation' && mode !== 'connection',
);
const heroUrl = route.hero as `/${string}`;
const heroAsset = publicMediaFor(heroUrl, {
  alt: { kind: 'contextual', status: 'approved', text: route.heroAlt },
  caption: `${route.eyebrow}. A visual orientation point for the work ahead.`,
  sizes: '(min-width: 58rem) 54vw, 100vw',
  loading: 'eager',
  fetchpriority: 'high',
  focalPoint: route.path === '/labs/biometric-security/' ? '30% 50%' : '50% 50%',
}) ?? createPublicMedia({
  id: `media:hero-${route.slug}` as `media:${string}`,
  url: heroUrl,
  type: 'photography-or-illustration',
  role: 'orientation',
  alt: { kind: 'contextual', status: 'approved', text: route.heroAlt },
  dimensions: { width: 1920, height: 600 },
  sizes: '(min-width: 58rem) 54vw, 100vw',
  loading: 'eager',
  fetchpriority: 'high',
  focalPoint: route.path === '/labs/biometric-security/' ? '30% 50%' : '50% 50%',
  provenance: {
    status: 'unverified',
    source: 'Repository asset; original source is not recorded.',
    license: 'Unverified; confirm ownership or license before publication.',
  },
  caption: `${route.eyebrow}. A visual orientation point for the work ahead.`,
});
---

<SiteLayout
  title={route.title}
  description={route.description}
  canonical={route.path}
  image={route.hero}
  imageAlt={route.heroAlt}
  type={route.type ?? 'website'}
  bodyClass={`editorial-page editorial-page--${route.family}`}
  mainClass="editorial-main"
>
  <article
    class:list={['editorial-route', `editorial-route--${route.family}`, route.composition && `editorial-route--${route.composition}`]}
    data-route={route.path}
    data-page-signature={signature.join(' → ')}
  >
    <header class="editorial-hero">
      <div class="editorial-container editorial-hero__grid">
        <div class="editorial-hero__copy">
          <p class="editorial-eyebrow"><span>{familyLabel(route.family)}</span><span aria-hidden="true">/</span><span>{route.slug.replaceAll('-', ' ')}</span></p>
          <p class="editorial-folio">INSTAR RESEARCH PORTFOLIO</p>
          <h1>{route.title}</h1>
          <p class="editorial-dek">{route.description}</p>
          <div class="editorial-actions">
            <a class="editorial-button editorial-button--primary" href={primaryHref}>Review {familyLabel(route.family).toLowerCase()} portfolio <span aria-hidden="true">↗</span></a>
            <a class="editorial-button editorial-button--quiet" href="/contact-us/">Discuss a research requirement</a>
          </div>
        </div>
        <EditorialMedia asset={heroAsset} figureClass="editorial-hero__media" class="editorial-hero__image" picture={false} />
      </div>
    </header>

    <nav class="editorial-map" aria-label="Page map">
      <div class="editorial-container editorial-map__inner">
        <p class="editorial-map__label">Read this page as</p>
        <ul>
          {signature.map((mode) => (
            <li>{modeLabel(mode)}</li>
          ))}
        </ul>
      </div>
    </nav>

    <section class="editorial-brief editorial-container" aria-labelledby="editorial-brief-title">
      <div class="editorial-section-label">Decision brief</div>
      <div class="editorial-brief__grid">
        <h2 id="editorial-brief-title">{isArticle ? 'What the evidence supports.' : 'What a sponsor should be able to evaluate.'}</h2>
        <div class="editorial-brief__body">
          <p class="editorial-lead">{route.pageJob}</p>
          <p>INSTAR states the question, the method, the evidence, the limitations, and the next decision so a researcher, program officer, or contracting team can assess fit.</p>
        </div>
      </div>
    </section>

    {modeSections.map((mode) => (
      <RouteModeSection mode={mode} route={route} />
    ))}

    {!modeSections.includes('participation') ? (
      <section class="editorial-decision editorial-container" aria-labelledby="editorial-decision-title">
        <div class="editorial-decision__stamp" aria-hidden="true">INSTAR<br />/ / /</div>
        <div class="editorial-decision__copy">
          <div class="editorial-section-label">Sponsor or collaborator</div>
          <h2 id="editorial-decision-title">{route.readyAction}</h2>
          <p>{route.earlyAction}</p>
        </div>
        <a class="editorial-button editorial-button--primary" href="/contact-us/">Discuss a research requirement <span aria-hidden="true">↗</span></a>
      </section>
    ) : null}

    <section class="editorial-related editorial-container" aria-labelledby="editorial-related-title">
      <div class="editorial-related__head">
        <div>
          <div class="editorial-section-label">Related research</div>
          <h2 id="editorial-related-title">Review the surrounding portfolio.</h2>
        </div>
        <a href={primaryHref}>Review all {familyLabel(route.family).toLowerCase()} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="editorial-related__grid">
        {related.map((entry) => (
          <li>
            <a href={entry.path}>
              <span class="editorial-related__eyebrow">{familyLabel(entry.family)}</span>
              <h3>{entry.title}</h3>
              <span class="editorial-related__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</SiteLayout>

<style>
  .editorial-route {
    --route-accent: #0a5a78;
    --route-accent-on-dark: #54c9ed;
    --route-dark: #0b1626;
    background: var(--color-canvas);
  }

  .editorial-route--technology { --route-accent: #076c70; --route-accent-on-dark: #53d7d6; }
  .editorial-route--sciences { --route-accent: #554a92; --route-accent-on-dark: #b0a3ff; }
  .editorial-route--labs { --route-accent: #6b3fb6; --route-accent-on-dark: #c5a6ff; }
  .editorial-route--news { --route-accent: #a8472b; --route-accent-on-dark: #ff9a78; }
  .editorial-route--fellowship { --route-accent: #067061; --route-accent-on-dark: #63e3c9; }
  .editorial-route--tech-transfer { --route-accent: #8e6000; --route-accent-on-dark: #f3c563; }

  .editorial-container { width: calc(100% - 2 * var(--spacing-gutter)); margin-inline: auto; }
  .editorial-hero { color: #fff; background: var(--route-dark); overflow: clip; }
  .editorial-hero__grid { display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); block-size: min(42rem, calc(100svh - var(--layout-chrome-offset))); min-block-size: min(42rem, calc(100svh - var(--layout-chrome-offset))); }
  .editorial-hero__copy { display: flex; flex-direction: column; justify-content: center; padding-block: clamp(3.5rem, 7vw, 6rem); padding-inline-end: clamp(2rem, 4vw, 5rem); }
  .editorial-eyebrow, .editorial-folio, .editorial-map, .editorial-section-label, .editorial-related__eyebrow { font-family: var(--font-ui); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .editorial-eyebrow { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-end: 2.2rem; color: var(--route-accent-on-dark); }
  .editorial-folio { margin-block-end: 1.1rem; color: rgb(255 255 255 / 0.55); font-size: 0.68rem; letter-spacing: 0.18em; }
  .editorial-hero h1 { max-inline-size: 13ch; margin: 0; color: #fff; font-size: clamp(2.35rem, 4vw, 4.75rem); letter-spacing: -0.045em; line-height: 0.99; text-wrap: balance; }
  .editorial-dek { max-inline-size: 48ch; margin-block: clamp(1.4rem, 2.5vw, 2.2rem) 0; color: rgb(255 255 255 / 0.75); font-size: clamp(1.05rem, 1rem + 0.28vw, 1.25rem); line-height: 1.55; }
  .editorial-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: 1.8rem; }
  .editorial-button { display: inline-flex; align-items: center; justify-content: center; gap: 0.7rem; min-block-size: 3rem; padding: 0.8rem 1.1rem; border: 1px solid transparent; font-family: var(--font-ui); font-size: 0.82rem; font-weight: 800; text-decoration: none; transition: transform 180ms ease, background-color 180ms ease, color 180ms ease; }
  .editorial-button:hover { transform: translateY(-2px); }
  .editorial-button--primary { background: var(--route-accent); color: #fff; }
  .editorial-button--primary:hover { background: #fff; color: var(--route-dark); }
  .editorial-button--quiet { border-color: rgb(255 255 255 / 0.28); color: #fff; }
  .editorial-button--quiet:hover { border-color: #fff; background: #fff; color: var(--route-dark); }
  :global(.editorial-hero__media) { position: relative; block-size: 100%; min-block-size: 100%; margin: 0; background: #132339; }
  :global(.editorial-hero__media::after) { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(11 22 38 / 0.45), transparent 35%, rgb(11 22 38 / 0.08)); content: ''; pointer-events: none; }
  :global(.editorial-hero__media img) { inline-size: 100%; block-size: 100%; min-block-size: 26rem; object-fit: cover; object-position: center; filter: saturate(0.85) contrast(1.06); }
  :global(.editorial-hero__media figcaption) { position: absolute; z-index: 1; inset-inline: 1.5rem; inset-block-end: 1.5rem; display: flex; align-items: center; gap: 0.65rem; color: #fff; font-family: var(--font-ui); font-size: 0.72rem; text-shadow: 0 1px 12px rgb(0 0 0 / 0.6); }
  .editorial-caption-mark { inline-size: 1.8rem; block-size: 2px; background: var(--route-accent-on-dark); }
  .editorial-map { color: var(--color-ink); border-block-end: 1px solid var(--color-rule); background: var(--color-surface); }
  .editorial-map__inner { display: flex; align-items: center; gap: 2rem; min-block-size: 4.5rem; }
  .editorial-map__label { flex: none; color: var(--route-accent); }
  .editorial-map ul { display: flex; flex-wrap: wrap; gap: 0.45rem 1.25rem; padding: 0; margin: 0; list-style: none; }
  .editorial-map li { display: flex; align-items: center; gap: 0.45rem; color: var(--color-muted-strong); }
  .editorial-map li::before { inline-size: 0.4rem; block-size: 0.4rem; flex: none; border-radius: 50%; background: var(--route-accent); content: ''; }
  .editorial-brief { padding-block: clamp(4rem, 7vw, 6.5rem); }
  .editorial-section-label { display: flex; align-items: center; gap: 0.75rem; color: var(--route-accent); }
  .editorial-section-label::before { inline-size: 1.4rem; block-size: 2px; background: currentColor; content: ''; }
  .editorial-brief__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.75fr); gap: clamp(2rem, 5vw, 5rem); margin-block-start: 2rem; }
  .editorial-brief h2, .editorial-sequence h2, .editorial-decision h2, .editorial-related h2 { margin: 0; font-size: clamp(2rem, 3.6vw, 4rem); letter-spacing: -0.055em; line-height: 1; }
  .editorial-brief h2 { max-inline-size: 10ch; }
  .editorial-brief__body { max-inline-size: 50ch; }
  .editorial-brief__body p { color: var(--color-muted-strong); }
  .editorial-brief__body .editorial-lead { margin-block-end: 1.4rem; color: var(--color-ink); font-size: clamp(1.2rem, 1.05rem + 0.4vw, 1.5rem); line-height: 1.45; }
  .editorial-sequence { padding-block: clamp(4rem, 7vw, 6.5rem); color: #fff; background: var(--route-dark); }
  .editorial-section-label--light { color: var(--route-accent-on-dark); }
  .editorial-sequence__intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block: 1.8rem 2.8rem; }
  .editorial-sequence h2 { max-inline-size: 11ch; color: #fff; }
  .editorial-sequence__intro p { max-inline-size: 28ch; margin: 0; color: rgb(255 255 255 / 0.65); }
  .editorial-mode-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; padding: 0; margin: 0; list-style: none; border-block-start: 1px solid rgb(255 255 255 / 0.2); }
  .editorial-mode-card { min-block-size: 13rem; padding: 1.4rem; border-inline-end: 1px solid rgb(255 255 255 / 0.2); border-block-end: 1px solid rgb(255 255 255 / 0.2); }
  .editorial-mode-card:nth-child(3n) { border-inline-end: 0; }
  .editorial-mode-card h3 { margin: 0 0 0.7rem; color: #fff; font-size: clamp(1.3rem, 2vw, 2rem); text-transform: capitalize; }
  .editorial-mode-card p { margin: 0; color: rgb(255 255 255 / 0.63); font-size: 0.94rem; }
  .editorial-decision { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(4rem, 7vw, 6.5rem); }
  .editorial-decision__stamp { display: grid; place-items: center; inline-size: 7rem; block-size: 7rem; border: 1px solid var(--route-accent); border-radius: 50%; color: var(--route-accent); font-family: var(--font-ui); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.12em; line-height: 1.6; text-align: center; }
  .editorial-decision__copy h2 { max-inline-size: 15ch; margin-block: 1.1rem; font-size: clamp(2rem, 3.3vw, 4rem); }
  .editorial-decision__copy p { max-inline-size: 50ch; margin: 0; color: var(--color-muted-strong); }
  .editorial-decision > .editorial-button { white-space: nowrap; }
  .editorial-related { padding-block: 0 clamp(4rem, 7vw, 6.5rem); }
  .editorial-related__head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block-end: 1.8rem; }
  .editorial-related h2 { margin-block-start: 1rem; }
  .editorial-related__head > a { color: var(--color-ink); font-family: var(--font-ui); font-size: 0.82rem; font-weight: 800; text-decoration: none; }
  .editorial-related__head > a:hover { color: var(--route-accent); }
  .editorial-related__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; padding: 0; margin: 0; list-style: none; }
  .editorial-related__grid li { min-block-size: 15rem; border-block-start: 3px solid var(--route-accent); background: var(--color-surface); }
  .editorial-related__grid a { position: relative; display: flex; flex-direction: column; block-size: 100%; padding: 1.25rem; color: var(--color-ink); text-decoration: none; }
  .editorial-related__eyebrow { color: var(--route-accent); font-size: 0.65rem; }
  .editorial-related__grid h3 { max-inline-size: 15ch; margin: 1.4rem 0 0; font-size: 1.25rem; line-height: 1.1; }
  .editorial-related__arrow { position: absolute; inset-inline-end: 1.25rem; inset-block-end: 1.1rem; color: var(--route-accent); font-size: 1.4rem; }
  .editorial-related__grid a:hover h3 { text-decoration: underline; text-decoration-thickness: 0.08em; text-underline-offset: 0.14em; }

  @media (max-width: 58rem) {
    .editorial-hero__grid, .editorial-brief__grid { grid-template-columns: 1fr; }
    .editorial-hero__grid { block-size: auto; }
    .editorial-hero__copy { padding-inline-end: 0; }
    :global(.editorial-hero__media) { block-size: auto; min-block-size: auto; }
    :global(.editorial-hero__media img) { min-block-size: 24rem; max-block-size: 50svh; }
    .editorial-mode-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .editorial-mode-card:nth-child(3n) { border-inline-end: 1px solid rgb(255 255 255 / 0.2); }
    .editorial-mode-card:nth-child(2n) { border-inline-end: 0; }
    .editorial-decision { grid-template-columns: auto minmax(0, 1fr); }
    .editorial-decision > .editorial-button { grid-column: 2; justify-self: start; }
    .editorial-related__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 42rem) {
    .editorial-map__inner { align-items: start; flex-direction: column; gap: 0.7rem; padding-block: 1.2rem; }
    .editorial-map ul { gap: 0.35rem 0.8rem; }
    .editorial-sequence__intro, .editorial-related__head { align-items: start; flex-direction: column; }
    .editorial-mode-grid, .editorial-related__grid { grid-template-columns: 1fr; }
    .editorial-mode-card, .editorial-mode-card:nth-child(2n), .editorial-mode-card:nth-child(3n) { border-inline-end: 0; }
    .editorial-decision { grid-template-columns: 1fr; gap: 1.6rem; }
    .editorial-decision > .editorial-button { grid-column: auto; }
    .editorial-decision__stamp { inline-size: 5.5rem; block-size: 5.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-button { transition: none; }
    .editorial-button:hover { transform: none; }
  }
</style>
