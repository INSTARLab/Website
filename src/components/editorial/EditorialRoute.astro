---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {
  familyLabel,
  familyRoot,
  type EditorialVisualMode,
  type EditorialRoute as EditorialRouteData,
} from '../../data/editorialRoutes';
import { publicMediaFor } from '../../data/media';
import { createPublicMedia } from '../../utils/media/records';
import EditorialMedia from './media/EditorialMedia.astro';
import RouteModeSection from './RouteModeSection.astro';
import Icon from '../primitives/Icon.astro';

interface Props {
  route: EditorialRouteData;
  related: readonly EditorialRouteData[];
}

const { route, related } = Astro.props;
const jobsDataUrl = `${import.meta.env.BASE_URL}data/jobs.json`;
const grantsDataUrl = `${import.meta.env.BASE_URL}data/grants.json`;
const modeLabel = (mode: string) => mode.replaceAll('-', ' ');
const primaryHref = familyRoot(route.family);
const isArticle = route.type === 'article';
const signature = route.signature.slice(0, 5);
const routeFraming = route.path === '/community/careers/'
  ? {
      briefHeading: 'What a prospective researcher should know before applying.',
      briefContext: 'Review the role families, current openings, and fellowship pathway before choosing a next step.',
      heroActionLabel: 'Explore roles and fellowships',
      heroActionHref: '/fellowship/',
      decisionLabel: 'Future roles and fellowships',
      decisionActionLabel: 'Express interest in a future role',
      decisionActionHref: '/contact-us/',
    }
  : route.path === '/community/support/'
    ? {
        briefHeading: 'How to choose a way to support the work.',
        briefContext: 'Review the one-time gift and Friends membership options described on this page.',
        heroActionLabel: 'Ask about support options',
        heroActionHref: '/contact-us/',
        decisionLabel: 'Support the research',
        decisionActionLabel: 'Ask about supporting INSTAR',
        decisionActionHref: '/contact-us/',
      }
    : route.path === '/tech-transfer/workshops-events/'
      ? {
          briefHeading: 'What a participant should know before joining an exchange.',
          briefContext: 'Compare the workshop, seminar, and knowledge-exchange formats before requesting a briefing.',
          heroActionLabel: 'Request a research briefing or technical exchange',
          heroActionHref: '/contact-us/',
          decisionLabel: 'Knowledge exchange',
          decisionActionLabel: 'Request a research briefing',
          decisionActionHref: '/contact-us/',
        }
      : route.family === 'fellowship'
        ? {
            briefHeading: 'What a prospective fellow should know before applying.',
            briefContext: 'Compare the program choices and application handoff before selecting a fellowship pathway.',
            heroActionLabel: 'Compare fellowship pathways',
            heroActionHref: '/fellowship/',
            decisionLabel: 'Fellowship application',
            decisionActionLabel: 'Ask about fellowship pathways',
            decisionActionHref: '/contact-us/',
          }
        : isArticle
          ? {
              briefHeading: 'What the evidence supports.',
              briefContext: 'Keep the question, evidence, and limits visible while deciding what to inspect next.',
              heroActionLabel: 'Discuss a research question',
              heroActionHref: '/contact-us/',
              decisionLabel: 'Research conversation',
              decisionActionLabel: 'Discuss a research question',
              decisionActionHref: '/contact-us/',
            }
          : {
              briefHeading: route.family === 'community' ? 'What to understand before choosing a next step.' : 'What a sponsor should be able to evaluate.',
              briefContext: route.family === 'community'
                ? 'Review the route details and source-defined next action before contacting INSTAR.'
                : 'INSTAR states the question, the method, the evidence, the limitations, and the next decision so a researcher, program officer, or contracting team can assess fit.',
              heroActionLabel: route.family === 'community' ? 'Continue with INSTAR' : 'Discuss a research requirement',
              heroActionHref: '/contact-us/',
              decisionLabel: route.family === 'community' ? 'Next step' : 'Sponsor or collaborator',
              decisionActionLabel: route.family === 'community' ? 'Continue with INSTAR' : 'Discuss a research requirement',
              decisionActionHref: '/contact-us/',
            };
const shellRoute = route.family === 'community'
  ? {
      ...route,
      // The About Us source job predates this audience-aware shell and names
      // institutional readers in a way that leaks sponsor language into every
      // mode section. Keep the source-defined task while making the public
      // framing readable for any community visitor.
      pageJob: route.pageJob.replace('a program officer, contracting team, or research collaborator', 'a reader'),
    }
  : route;
const modeSections = route.signature.filter(
  (mode): mode is Exclude<EditorialVisualMode, 'orientation' | 'connection'> => mode !== 'orientation' && mode !== 'connection',
);
const heroUrl = route.hero as `/${string}`;
const heroAsset = publicMediaFor(heroUrl, {
  alt: { kind: 'contextual', status: 'approved', text: route.heroAlt },
  caption: `${route.eyebrow}. A visual orientation point for the work ahead.`,
  sizes: '(min-width: 58rem) 54vw, 100vw',
  loading: 'eager',
  fetchpriority: 'high',
  focalPoint: route.path === '/labs/biometric-security/' ? '30% 50%' : '50% 50%',
}) ?? createPublicMedia({
  id: `media:hero-${route.slug}` as `media:${string}`,
  url: heroUrl,
  type: 'photography-or-illustration',
  role: 'orientation',
  alt: { kind: 'contextual', status: 'approved', text: route.heroAlt },
  dimensions: { width: 1920, height: 600 },
  sizes: '(min-width: 58rem) 54vw, 100vw',
  loading: 'eager',
  fetchpriority: 'high',
  focalPoint: route.path === '/labs/biometric-security/' ? '30% 50%' : '50% 50%',
  provenance: {
    status: 'unverified',
    source: 'Repository asset; original source is not recorded.',
    license: 'Unverified; confirm ownership or license before publication.',
  },
  caption: `${route.eyebrow}. A visual orientation point for the work ahead.`,
});
---

<SiteLayout
  title={route.title}
  description={route.description}
  canonical={route.path}
  image={route.hero}
  imageAlt={route.heroAlt}
  type={route.type ?? 'website'}
  bodyClass={`editorial-page editorial-page--${route.family}`}
  mainClass="editorial-main"
>
  <article
    class:list={['editorial-route', `editorial-route--${route.family}`, route.composition && `editorial-route--${route.composition}`]}
    data-route={route.path}
    data-page-signature={signature.join(' → ')}
  >
    <header class="editorial-hero">
      <div class="editorial-container editorial-hero__grid">
        <div class="editorial-hero__copy">
          <p class="editorial-eyebrow"><span>{familyLabel(route.family)}</span><span aria-hidden="true">/</span><span>{route.slug.replaceAll('-', ' ')}</span></p>
          <p class="editorial-folio">INSTAR RESEARCH PORTFOLIO</p>
          <h1>{route.title}</h1>
          <p class="editorial-dek">{route.description}</p>
          <div class="editorial-actions">
            <a class="editorial-button editorial-button--primary" href={primaryHref}>Explore {familyLabel(route.family).toLowerCase()} <Icon name="arrow-up-right" size="1rem" /></a>
            <a class="editorial-button editorial-button--quiet" href={routeFraming.heroActionHref}>{routeFraming.heroActionLabel} <Icon name="arrow-right" size="1rem" /></a>
          </div>
        </div>
        <EditorialMedia asset={heroAsset} figureClass="editorial-hero__media" class="editorial-hero__image" picture={false} />
      </div>
    </header>

    <nav class="editorial-map" aria-label="Page map">
      <div class="editorial-container editorial-map__inner">
        <p class="editorial-map__label">Read this page as</p>
        <ul>
          {signature.map((mode) => (
            <li>{modeLabel(mode)}</li>
          ))}
        </ul>
      </div>
    </nav>

    <section class="editorial-brief editorial-container" aria-labelledby="editorial-brief-title">
      <div class="editorial-section-label">Decision brief</div>
      <div class="editorial-brief__grid">
        <h2 id="editorial-brief-title">{routeFraming.briefHeading}</h2>
        <div class="editorial-brief__body">
          <p class="editorial-lead">{shellRoute.pageJob}</p>
          <p>{routeFraming.briefContext}</p>
        </div>
      </div>
    </section>

    {modeSections.map((mode) => (
      <RouteModeSection mode={mode} route={shellRoute} />
    ))}

    {!modeSections.includes('participation') ? (
      <section class="editorial-decision editorial-container" aria-labelledby="editorial-decision-title">
        <div class="editorial-decision__stamp" aria-hidden="true">INSTAR<br />/ / /</div>
        <div class="editorial-decision__copy">
          <div class="editorial-section-label">{routeFraming.decisionLabel}</div>
          <h2 id="editorial-decision-title">{route.readyAction}</h2>
          <p>{route.earlyAction}</p>
        </div>
        <a class="editorial-button editorial-button--primary" href={routeFraming.decisionActionHref}>{routeFraming.decisionActionLabel} <Icon name="arrow-up-right" size="1rem" /></a>
      </section>
    ) : null}

    {route.path === '/community/careers/' ? (
      /*
       * JSON-driven listings (gh#259) with an honest empty-state (gh#312).
       * /data/jobs.json carries only verified current openings; the static
       * fallback below stays visible without JS and whenever the list is
       * empty, so the page never implies openings that do not exist and
       * never hides content from no-JS readers. Each rendered listing also
       * emits JobPosting JSON-LD for Google Jobs eligibility.
       */
      <section class="editorial-decision editorial-container" aria-labelledby="careers-openings-title">
        <div class="editorial-decision__stamp" aria-hidden="true">INSTAR<br />/ / /</div>
        <div class="editorial-decision__copy">
          <div class="editorial-section-label">Current openings</div>
          <h2 id="careers-openings-title">No open positions are listed right now.</h2>
          <div data-jobs-list>
            <p>To be considered for a future research or technical role, send your background and interests through the contact page, or compare the fellowship pathways.</p>
          </div>
        </div>
        <a class="editorial-button editorial-button--primary" href="/contact-us/">Express interest in a future role <Icon name="arrow-up-right" size="1rem" /></a>
      </section>
      <script define:vars={{ jobsDataUrl }}>
        (async () => {
          const mount = document.querySelector('[data-jobs-list]');
          if (!(mount instanceof HTMLElement)) return;
          let payload = null;
          try {
            const response = await fetch(jobsDataUrl, { headers: { accept: 'application/json' } });
            if (!response.ok) return;
            payload = await response.json();
          } catch {
            return;
          }
          const openings = Array.isArray(payload?.openings) ? payload.openings : [];
          if (openings.length === 0) return;
          const heading = document.getElementById('careers-openings-title');
          if (heading) heading.textContent = `Open positions (${openings.length}).`;
          const list = document.createElement('ul');
          for (const job of openings) {
            if (!job || typeof job.title !== 'string' || typeof job.url !== 'string') continue;
            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = job.url;
            link.textContent = job.title;
            item.append(link);
            if (typeof job.location === 'string' && job.location) {
              const where = document.createElement('span');
              where.textContent = ` — ${job.location}`;
              item.append(where);
            }
            if (typeof job.closing === 'string' && job.closing) {
              const due = document.createElement('span');
              due.textContent = ` (closes ${job.closing})`;
              item.append(due);
            }
            list.append(item);
            const structured = document.createElement('script');
            structured.type = 'application/ld+json';
            structured.textContent = JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'JobPosting',
              title: job.title,
              hiringOrganization: { '@type': 'Organization', name: 'INSTAR Lab', sameAs: 'https://www.instarlab.org/' },
              jobLocationType: typeof job.remote === 'boolean' && job.remote ? 'TELECOMMUTE' : undefined,
              applicantLocationRequirements: typeof job.location === 'string' ? job.location : undefined,
              validThrough: typeof job.closing === 'string' ? job.closing : undefined,
              url: new URL(job.url, window.location.origin).href,
            });
            mount.append(structured);
          }
          if (list.children.length > 0) {
            mount.replaceChildren(list);
          }
        })();
      </script>
    ) : null}

    {route.path === '/research/opportunities/' ? (
      /*
       * Grants lookup structure (gh#260). /data/grants.json carries only
       * real, verified opportunities; with none confirmed, the table stands
       * with an honest empty-state and curation stays with the team. The
       * filter and sortable headers operate on whatever rows the dataset
       * provides, so no code change is needed when opportunities are added.
       */
      <section class="editorial-container" aria-labelledby="grants-title" data-grants>
        <div class="editorial-section-label">Funding lookup</div>
        <h2 id="grants-title">Current funding opportunities.</h2>
        <p>
          <label for="grants-filter">Filter opportunities</label>
          <input id="grants-filter" data-grants-filter type="search" placeholder="e.g. NSF, quantum, STTR" autocomplete="off" />
        </p>
        <div style="overflow-x: auto">
          <table data-grants-table>
            <thead>
              <tr>
                <th><button type="button" data-grants-sort="title" aria-pressed="false">Opportunity</button></th>
                <th><button type="button" data-grants-sort="sponsor" aria-pressed="false">Sponsor</button></th>
                <th><button type="button" data-grants-sort="due" aria-pressed="false">Due</button></th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody data-grants-rows>
              <tr data-grants-empty>
                <td colspan="4">No verified opportunities are listed right now. Check back, or contact INSTAR about a specific program or solicitation.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      <script define:vars={{ grantsDataUrl }}>
        (async () => {
          const root = document.querySelector('[data-grants]');
          if (!(root instanceof HTMLElement)) return;
          const rows = root.querySelector('[data-grants-rows]');
          const filter = root.querySelector('[data-grants-filter]');
          const sorters = [...root.querySelectorAll('[data-grants-sort]')];
          if (!(rows instanceof HTMLElement)) return;
          let items = [];
          try {
            const response = await fetch(grantsDataUrl, { headers: { accept: 'application/json' } });
            if (!response.ok) return;
            const payload = await response.json();
            if (Array.isArray(payload?.opportunities)) items = payload.opportunities;
          } catch {
            return;
          }
          if (items.length === 0) return;
          let sortKey = 'due';
          let ascending = true;
          const render = () => {
            const term = filter instanceof HTMLInputElement ? filter.value.trim().toLowerCase() : '';
            const visible = items
              .filter((item) => item && typeof item.title === 'string' && typeof item.url === 'string')
              .filter((item) =>
                !term ||
                [item.title, item.sponsor, item.due].filter((v) => typeof v === 'string').join(' ').toLowerCase().includes(term),
              )
              .sort((a, b) => String(a[sortKey] ?? '').localeCompare(String(b[sortKey] ?? '')) * (ascending ? 1 : -1));
            rows.replaceChildren();
            if (visible.length === 0) {
              const row = document.createElement('tr');
              const cell = document.createElement('td');
              cell.colSpan = 4;
              cell.textContent = 'No opportunities match this filter.';
              row.append(cell);
              rows.append(row);
              return;
            }
            for (const item of visible) {
              const row = document.createElement('tr');
              const title = document.createElement('td');
              title.textContent = item.title;
              const sponsor = document.createElement('td');
              sponsor.textContent = typeof item.sponsor === 'string' ? item.sponsor : '—';
              const due = document.createElement('td');
              due.textContent = typeof item.due === 'string' ? item.due : 'Rolling';
              const details = document.createElement('td');
              const link = document.createElement('a');
              link.href = item.url;
              link.textContent = 'Details';
              details.append(link);
              row.append(title, sponsor, due, details);
              rows.append(row);
            }
          };
          for (const button of sorters) {
            button.addEventListener('click', () => {
              const key = button.getAttribute('data-grants-sort') ?? 'due';
              if (key === sortKey) ascending = !ascending;
              else {
                sortKey = key;
                ascending = true;
              }
              for (const other of sorters) other.setAttribute('aria-pressed', String(other === button));
              render();
            });
          }
          filter?.addEventListener('input', render);
          render();
        })();
      </script>
    ) : null}

    {related.length > 0 ? (
    <section class="editorial-related editorial-container" aria-labelledby="editorial-related-title">
      <div class="editorial-related__head">
        <div>
          <div class="editorial-section-label">Related research</div>
          <h2 id="editorial-related-title">Review the surrounding portfolio.</h2>
        </div>
        <a href={primaryHref}>{isArticle ? 'More research briefs' : `Continue in ${familyLabel(route.family).toLowerCase()}`} <Icon name="arrow-right" size="1rem" /></a>
      </div>
      <ul class="editorial-related__grid">
        {related.map((entry) => (
          <li>
            <a href={entry.path}>
              <span class="editorial-related__eyebrow">{familyLabel(entry.family)}</span>
              <h3>{entry.title}</h3>
              <span class="editorial-related__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    ) : null}
  </article>
</SiteLayout>

<style>
  .editorial-route {
    --route-accent: #0a5a78;
    --route-accent-on-dark: #54c9ed;
    --route-dark: #0b1626;
    background: var(--color-canvas);
  }

  .editorial-route--technology { --route-accent: #076c70; --route-accent-on-dark: #53d7d6; }
  .editorial-route--sciences { --route-accent: #554a92; --route-accent-on-dark: #b0a3ff; }
  .editorial-route--labs { --route-accent: #6b3fb6; --route-accent-on-dark: #c5a6ff; }
  .editorial-route--news { --route-accent: #a8472b; --route-accent-on-dark: #ff9a78; }
  .editorial-route--fellowship { --route-accent: #067061; --route-accent-on-dark: #63e3c9; }
  .editorial-route--tech-transfer { --route-accent: #8e6000; --route-accent-on-dark: #f3c563; }

  .editorial-container { width: calc(100% - 2 * var(--spacing-gutter)); margin-inline: auto; }
  .editorial-hero { color: #fff; background: var(--route-dark); overflow: clip; }
  .editorial-hero__grid { display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); block-size: min(42rem, calc(100svh - var(--layout-chrome-offset))); min-block-size: min(42rem, calc(100svh - var(--layout-chrome-offset))); }
  .editorial-hero__copy { display: flex; flex-direction: column; justify-content: center; padding-block: clamp(3.5rem, 7vw, 6rem); padding-inline-end: clamp(2rem, 4vw, 5rem); }
  .editorial-eyebrow, .editorial-folio, .editorial-map, .editorial-section-label, .editorial-related__eyebrow { font-family: var(--font-ui); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .editorial-eyebrow { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-end: 2.2rem; color: var(--route-accent-on-dark); }
  .editorial-folio { margin-block-end: 1.1rem; color: rgb(255 255 255 / 0.55); font-size: 0.68rem; letter-spacing: 0.18em; }
  .editorial-hero h1 { max-inline-size: 13ch; margin: 0; color: #fff; font-size: clamp(2.35rem, 4vw, 4.75rem); letter-spacing: -0.045em; line-height: 0.99; text-wrap: balance; }
  .editorial-dek { max-inline-size: 48ch; margin-block: clamp(1.4rem, 2.5vw, 2.2rem) 0; color: rgb(255 255 255 / 0.75); font-size: clamp(1.05rem, 1rem + 0.28vw, 1.25rem); line-height: 1.55; }
  .editorial-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block-start: 1.8rem; }
  .editorial-button { display: inline-flex; align-items: center; justify-content: center; gap: 0.7rem; min-block-size: 3rem; padding: 0.8rem 1.1rem; border: 1px solid transparent; font-family: var(--font-ui); font-size: 0.82rem; font-weight: 800; text-decoration: none; transition: transform 180ms ease, background-color 180ms ease, color 180ms ease; }
  .editorial-button:hover { transform: translateY(-2px); }
  .editorial-button--primary { background: var(--route-accent); color: #fff; }
  .editorial-button--primary:hover { background: #fff; color: var(--route-dark); }
  .editorial-button--quiet { border-color: rgb(255 255 255 / 0.28); color: #fff; }
  .editorial-button--quiet:hover { border-color: #fff; background: #fff; color: var(--route-dark); }
  :global(.editorial-hero__media) { position: relative; block-size: 100%; min-block-size: 100%; margin: 0; background: #132339; }
  :global(.editorial-hero__media::after) { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(11 22 38 / 0.45), transparent 35%, rgb(11 22 38 / 0.08)); content: ''; pointer-events: none; }
  :global(.editorial-hero__media img) { inline-size: 100%; block-size: 100%; min-block-size: 26rem; object-fit: cover; object-position: center; filter: saturate(0.85) contrast(1.06); }
  :global(.editorial-hero__media figcaption) { position: absolute; z-index: 1; inset-inline: 1.5rem; inset-block-end: 1.5rem; display: flex; align-items: center; gap: 0.65rem; color: #fff; font-family: var(--font-ui); font-size: 0.72rem; text-shadow: 0 1px 12px rgb(0 0 0 / 0.6); }
  .editorial-caption-mark { inline-size: 1.8rem; block-size: 2px; background: var(--route-accent-on-dark); }
  .editorial-map { color: var(--color-ink); border-block-end: 1px solid var(--color-rule); background: var(--color-surface); }
  .editorial-map__inner { display: flex; align-items: center; gap: 2rem; min-block-size: 4.5rem; }
  .editorial-map__label { flex: none; color: var(--route-accent); }
  .editorial-map ul { display: flex; flex-wrap: wrap; gap: 0.45rem 1.25rem; padding: 0; margin: 0; list-style: none; }
  .editorial-map li { display: flex; align-items: center; gap: 0.45rem; color: var(--color-muted-strong); }
  .editorial-map li::before { inline-size: 0.4rem; block-size: 0.4rem; flex: none; border-radius: 50%; background: var(--route-accent); content: ''; }
  .editorial-brief { padding-block: clamp(4rem, 7vw, 6.5rem); }
  .editorial-section-label { display: flex; align-items: center; gap: 0.75rem; color: var(--route-accent); }
  .editorial-section-label::before { inline-size: 1.4rem; block-size: 2px; background: currentColor; content: ''; }
  .editorial-brief__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.75fr); gap: clamp(2rem, 5vw, 5rem); margin-block-start: 2rem; }
  .editorial-brief h2, .editorial-sequence h2, .editorial-decision h2, .editorial-related h2 { margin: 0; font-size: clamp(2rem, 3.6vw, 4rem); letter-spacing: -0.055em; line-height: 1; }
  .editorial-brief h2 { max-inline-size: 10ch; }
  .editorial-brief__body { max-inline-size: 50ch; }
  .editorial-brief__body p { color: var(--color-muted-strong); }
  .editorial-brief__body .editorial-lead { margin-block-end: 1.4rem; color: var(--color-ink); font-size: clamp(1.2rem, 1.05rem + 0.4vw, 1.5rem); line-height: 1.45; }
  .editorial-sequence { padding-block: clamp(4rem, 7vw, 6.5rem); color: #fff; background: var(--route-dark); }
  .editorial-section-label--light { color: var(--route-accent-on-dark); }
  .editorial-sequence__intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-block: 1.8rem 2.8rem; }
  .editorial-sequence h2 { max-inline-size: 11ch; color: #fff; }
  .editorial-sequence__intro p { max-inline-size: 28ch; margin: 0; color: rgb(255 255 255 / 0.65); }
  .editorial-mode-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; padding: 0; margin: 0; list-style: none; border-block-start: 1px solid rgb(255 255 255 / 0.2); }
  .editorial-mode-card { min-block-size: 13rem; padding: 1.4rem; border-inline-end: 1px solid rgb(255 255 255 / 0.2); border-block-end: 1px solid rgb(255 255 255 / 0.2); }
