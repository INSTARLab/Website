---
import type { ArticleEntry, AuthorEntry } from '../../../data/articles';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles: readonly ArticleEntry[];
  authors: readonly AuthorEntry[];
}

const { articles, authors } = Astro.props;
const featured = articles[0];
const rest = featured ? articles.slice(1) : [];
// Topic filter (gh#322) and feed discovery (gh#264) run off metadata the
// collection already carries — no new taxonomy to maintain by hand.
const allTopics = [...new Set(articles.flatMap((article) => article.data.topics))].sort((a, b) =>
  a.localeCompare(b),
);
const topicsFor = (article: ArticleEntry) => article.data.topics.join(' | ');
---

<SiteLayout
  title="News — INSTAR Lab"
  description="Research briefs, methods, and evidence from INSTAR Lab’s work in AI, quantum science, computing, health, energy, space, and the sciences."
  canonical="/news/"
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="INSTAR Lab News" href="/rss.xml" />
  <div class="article-index" data-route="/news/" data-page-signature="orientation → evidence → observation → connection">
    <header class="article-index__header">
      <div class="article-index__header-inner">
        <p class="article-index__kicker">INSTAR / Newsroom</p>
        <h1>Research, in the open.</h1>
        <p class="article-index__dek">
          Briefs from the questions, methods, risks, and limits shaping INSTAR’s research portfolio.
        </p>
      </div>
    </header>

    <div class="article-index__main site-container">
      <div class="article-index__intro">
        <div>
          <p class="article-index__label">Latest research briefs</p>
          <h2>Read the evidence, not just the headline.</h2>
        </div>
        <p>
          Each brief names its point of view, the evidence it rests on, and what remains unresolved.
        </p>
      </div>

      {featured ? (
        <div data-topic-card data-topics={topicsFor(featured)}>
          <ArticleCard article={featured} authors={authors} featured />
        </div>
      ) : (
        <p class="article-index__empty">No published briefs are available yet.</p>
      )}

      {allTopics.length > 1 ? (
        <div class="article-index__filters" data-topic-filters>
          <p class="article-index__label" id="article-filter-label">Filter by topic</p>
          <div class="article-index__filter-buttons" role="group" aria-labelledby="article-filter-label">
            <button type="button" data-topic-filter="all" aria-pressed="true">All topics</button>
            {allTopics.map((topic) => (
              <button type="button" data-topic-filter={topic} aria-pressed="false">{topic}</button>
            ))}
          </div>
          <p class="article-index__filter-status" data-topic-status role="status" aria-live="polite"></p>
        </div>
      ) : null}

      {rest.length > 0 ? (
        <section class="article-index__archive" aria-labelledby="article-archive-title">
          <div class="article-index__archive-heading">
            <p class="article-index__label">The archive</p>
            <h2 id="article-archive-title">Keep reading</h2>
          </div>
          <div class="article-index__grid">
            {rest.map((article) => (
              <div data-topic-card data-topics={topicsFor(article)}>
                <ArticleCard article={article} authors={authors} />
              </div>
            ))}
          </div>
          <p class="article-index__empty" data-topic-empty hidden>No briefs match this topic yet. Try another topic.</p>
        </section>
      ) : null}
    </div>
  </div>

  {allTopics.length > 1 ? (
    <script>
      // Progressive enhancement: without JS every brief stays visible and the
      // filter group degrades to inert buttons, so this never hides content
      // from no-JS readers or crawlers.
      const root = document.querySelector('[data-topic-filters]');
      const scope = root?.closest('.article-index');
      const buttons = [...(root?.querySelectorAll('[data-topic-filter]') ?? [])];
      const cards = [...(scope?.querySelectorAll('[data-topic-card]') ?? [])];
      const status = root?.querySelector('[data-topic-status]');
      const emptyNote = scope?.querySelector('[data-topic-empty]');

      const applyFilter = (topic: string) => {
        let visible = 0;
        for (const card of cards) {
          const topics = (card.getAttribute('data-topics') ?? '').split(' | ');
          const show = topic === 'all' || topics.includes(topic);
          card.toggleAttribute('hidden', !show);
          if (show) visible += 1;
        }
        for (const button of buttons) {
          button.setAttribute('aria-pressed', String(button.getAttribute('data-topic-filter') === topic));
        }
        if (status) {
          status.textContent =
            topic === 'all' ? '' : `${String(visible)} ${visible === 1 ? 'brief' : 'briefs'} on ${topic}.`;
        }
        emptyNote?.toggleAttribute('hidden', visible !== 0);
      };

      // The status line starts empty; announce only after a filter is chosen.
      if (status) status.textContent = '';
      for (const button of buttons) {
        button.addEventListener('click', () => applyFilter(button.getAttribute('data-topic-filter') ?? 'all'));
      }
      // Keep a pre-selected (e.g. back-button) filter honest on load.
      const pressed = buttons.find((button) => button.getAttribute('aria-pressed') === 'true');
      if (pressed && pressed.getAttribute('data-topic-filter') !== 'all') {
        applyFilter(pressed.getAttribute('data-topic-filter') ?? 'all');
      }
    </script>
  ) : null}
</SiteLayout>

<style>
  .article-index {
    background: var(--color-canvas);
  }

  .article-index__header {
    color: var(--color-on-brand);
    background: var(--color-footer-deep);
  }

  .article-index__header-inner {
    width: calc(100% - 2 * var(--spacing-gutter));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(3rem, 6vw, 5rem);
  }

  .article-index__kicker,
  .article-index__label {
    font-family: var(--font-ui);
    font-size: var(--text-kicker);
    font-weight: 700;
    letter-spacing: var(--text-kicker--letter-spacing);
    text-transform: uppercase;
  }

  .article-index__kicker {
    color: var(--color-brand-cool);
  }

  .article-index h1 {
    max-inline-size: 9ch;
    margin-block: 1.3rem 1rem;
    color: var(--color-on-brand);
    font-size: clamp(2.5rem, 4.2vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 0.99;
  }

  .article-index__dek {
    max-inline-size: 44ch;
    color: rgb(255 255 255 / 0.76);
    font-size: var(--text-lead);
  }

  .article-index__main {
    padding-block: var(--spacing-section-compact) var(--spacing-section);
  }

  .article-index__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.65fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-block-end: clamp(2rem, 5vw, 4rem);
  }

  .article-index__label {
    margin-block-end: 0.9rem;
    color: var(--color-brand-deep);
  }

  .article-index h2 {
    max-inline-size: 16ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 4rem);
    letter-spacing: -0.04em;
  }

  .article-index__intro > p {
    max-inline-size: 36ch;
    color: var(--color-muted-strong);
  }

  .article-index__archive {
    margin-block-start: clamp(4rem, 9vw, 8rem);
  }

  .article-index__archive-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-block-end: 1.5rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid var(--color-rule);
  }

  .article-index__archive-heading h2 {
    font-size: clamp(1.8rem, 3vw, 3rem);
  }

  .article-index__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-grid);
  }

  .article-index__empty {
    padding: 2rem;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }

  .article-index__filters {
    margin-block: clamp(2rem, 5vw, 3.5rem);
    padding-block-start: clamp(1.5rem, 3vw, 2.5rem);
    border-block-start: 1px solid var(--color-rule);
  }

  .article-index__filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 1rem;
  }

  .article-index__filter-buttons button {
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    font: 700 0.82rem/1.2 var(--font-ui);
    cursor: pointer;
  }

  .article-index__filter-buttons button[aria-pressed="true"] {
    border-color: var(--color-brand-deep);
    background: var(--color-brand-deep);
    color: #fff;
  }

  .article-index__filter-buttons button:hover {
    border-color: var(--color-brand-deep);
  }

  .article-index__filter-status:empty {
    display: none;
  }

  .article-index__filter-status {
    margin-block: 1rem 0;
    color: var(--color-muted-strong);
    font-size: 0.95rem;
  }

  [data-topic-card][hidden] {
    display: none;
  }

  @media (max-width: 48rem) {
    .article-index__intro,
    .article-index__grid {
      grid-template-columns: 1fr;
    }

    .article-index__archive-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
