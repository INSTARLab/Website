---
import EditorialRoute from './EditorialRoute.astro';
import {
  editorialRelatedRoutes,
  editorialRouteAtPath,
  type EditorialRoute as EditorialRouteData,
} from '../../data/editorialRoutes';
import type { InstarResearchTechnologySciencesRoute as SourceRoute } from '../../data/instar-research-technology-sciences';

interface Props {
  route: SourceRoute;
}

const { route } = Astro.props;
const source = editorialRouteAtPath(route.path) satisfies EditorialRouteData;
---

<EditorialRoute route={source} related={editorialRelatedRoutes(source)} />
