---
import { quickFooterLinks, researchFooterLinks } from '../../data/siteNavigation';
import Icon from '../primitives/Icon.astro';

interface Props {
  newsletterAction?: string;
  newsletterMethod?: 'get' | 'post';
}

const { newsletterAction, newsletterMethod = 'post' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__main">
    <div class="site-container site-footer__grid">
      <section class="site-footer__panel site-footer__panel--about" aria-labelledby="footer-about-title">
        <h2 id="footer-about-title">About us</h2>
        <p>INSTAR Lab is a 501(c)(3) nonprofit research institute conducting applied research in AI, quantum science, high-performance computing, health, energy, space, and the sciences for federal and institutional research partners.</p>
        <div class="site-footer__contact">
          <h3>Contact us</h3>
          <a href="tel:9292292918"><Icon name="phone" size="1rem" /><span>Phone: 929-229-2918</span></a>
          <a href="mailto:info@instarlab.org"><Icon name="mail" size="1rem" /><span>Email: info@instarlab.org</span></a>
          <a href="https://maps.google.com/?q=125+Frederick+St+Marietta+OH+45750"><Icon name="map-pin" size="1rem" /><span>Address: 125 Frederick St, Marietta, OH 45750-3407</span></a>
        </div>
      </section>

      <section class="site-footer__panel" aria-labelledby="footer-research-title">
        <h2 id="footer-research-title">Our research</h2>
        <nav aria-label="Our research">
          <ul>
            {researchFooterLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </section>

      <section class="site-footer__panel" aria-labelledby="footer-quick-title">
        <h2 id="footer-quick-title">Quick link</h2>
        <nav aria-label="Quick link">
          <ul>
            {quickFooterLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </section>

      <section class="site-footer__panel site-footer__panel--newsletter" aria-labelledby="footer-newsletter-title">
        <h2 id="footer-newsletter-title">Research updates</h2>
        <p>Receive research briefs and institutional updates from INSTAR Lab.</p>
        {newsletterAction ? (
          <form class="site-footer__form" action={newsletterAction} method={newsletterMethod}>
            <label class="sr-only" for="footer-email">Email address</label>
            <input id="footer-email" name="email" type="email" autocomplete="email" placeholder="Email address" required />
            <button type="submit">Subscribe <Icon name="arrow-right" size="0.95rem" /></button>
          </form>
        ) : null}
      </section>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="site-container site-footer__bottom-inner">
      <p>INSTAR Lab Inc. is a registered 501(c)(3) nonprofit. Copyright © {year} INSTAR Lab Inc. All Rights Reserved.</p>
      <a href="#top">Back to top <Icon name="arrow-up-right" size="0.9rem" /></a>
    </div>
  </div>
</footer>

<style>
  /* Keep footer text above WCAG AA contrast across route families. */
  .site-footer__panel p,
  .site-footer__panel a {
    color: #f0f4f8 !important;
  }

  .site-footer__bottom p,
  .site-footer__bottom a {
    color: #dbe7f0 !important;
  }

  .site-footer__contact a,
  .site-footer__bottom a,
  .site-footer__form button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-footer__contact a {
    width: auto;
  }

  .site-footer__contact .icon {
    flex: none;
    color: var(--color-brand-cool);
  }

  .site-footer__form button {
    justify-content: center;
  }
</style>
