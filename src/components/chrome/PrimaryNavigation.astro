---
import {
  primaryNavigation,
  type NavigationItem,
  type PrimaryNavigationEntry,
} from '../../data/siteNavigation';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const normalizePath = (path: string) => {
  const normalized = path.split('?')[0].replace(/\/+$/, '');
  return normalized || '/';
};

const current = normalizePath(currentPath);

const isCurrent = (item: NavigationItem) => {
  const target = normalizePath(item.href);
  return target === current || (target !== '/' && current.startsWith(`${target}/`));
};

const hasCurrentChild = (entry: PrimaryNavigationEntry) => {
  if ('href' in entry) return isCurrent(entry);
  return Boolean(
    entry.items?.some(isCurrent) || entry.sections?.some((section) => section.items.some(isCurrent)),
  );
};

const chevron = '<path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />';

const scienceIcons: Record<string, string> = {
  Agriculture: '<path d="M5 19c6.8-.1 11.8-4 14-13-5.4.5-10.6 2.5-12.8 7.2C5.4 14.9 5 17 5 19Z" /><path d="M5 19c2.4-3 5.3-5.1 9-6.8" />',
  Geology: '<path d="m3 8 9-4 9 4-9 4-9-4Z" /><path d="m3 12 9 4 9-4M3 16l9 4 9-4" />',
  'Ocean Science': '<path d="M3 8c2.3 0 2.3 2 4.7 2s2.4-2 4.7-2 2.4 2 4.7 2S19.4 8 21 8" /><path d="M3 14c2.3 0 2.3 2 4.7 2s2.4-2 4.7-2 2.4 2 4.7 2 2.3-2 4.6-2" />',
  'Outer Space': '<circle cx="12" cy="12" r="2.5" /><ellipse cx="12" cy="12" rx="9" ry="4.5" transform="rotate(-30 12 12)" /><circle cx="19.5" cy="6.6" r="1.2" />',
  Anthropology: '<circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.5" /><path d="M3.5 20c.4-3.5 2.4-5.3 5.5-5.3s5.1 1.8 5.5 5.3M14 14.8c3.2-.4 5.7 1.3 6.5 5.2" />',
  Archaeology: '<path d="m5 19 8.8-8.8M13 4l7 7-3 3-7-7 3-3Z" /><path d="m4 20 4-1" />',
  Economics: '<path d="M4 19V5M4 19h16" /><path d="m7 15 3-4 3 2 5-6" />',
  Law: '<path d="M12 4v16M7 5h10" /><path d="M5 8h4l-2 5H3l2-5ZM15 8h4l2 5h-4l-2-5ZM7 20h10" />',
  Linguistics: '<path d="M4 5h16v10H9l-5 4V5Z" /><path d="M8 9h8M8 12h5" />',
  Psychology: '<path d="M9.5 5.5A3 3 0 0 0 5 8.2 3.2 3.2 0 0 0 6 14a3.1 3.1 0 0 0 3.5 4.5 3 3 0 0 0 5 0A3.1 3.1 0 0 0 18 14a3.2 3.2 0 0 0 1-5.8 3 3 0 0 0-4.5-2.7 3 3 0 0 0-5 0Z" /><path d="M12 5v14M8 9h4M12 13h4M8 16h4" />',
  Sociology: '<circle cx="6" cy="7" r="2" /><circle cx="18" cy="7" r="2" /><circle cx="12" cy="17" r="2" /><path d="m7.7 8.2 2.8 6.1M16.3 8.2l-2.8 6.1M8 7h8" />',
  Biology: '<circle cx="12" cy="12" r="7" /><circle cx="10" cy="10" r="2" /><path d="M16.5 16c-2-1.1-3.4-2.8-4.1-5" />',
  Genetics: '<path d="M7 4c8 4 2 12 10 16M17 4c-8 4-2 12-10 16M9 7h6M8 12h8M9 17h6" />',
  Medicine: '<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6V3Z" />',
  'Cognitive Sciences': '<path d="M9 5a3.5 3.5 0 0 0-4.5 3.3A3.5 3.5 0 0 0 6 14.5 3.5 3.5 0 0 0 9.5 19 3.5 3.5 0 0 0 12 17V7a3.5 3.5 0 0 0-3-2Z" /><path d="M15 5a3.5 3.5 0 0 1 4.5 3.3A3.5 3.5 0 0 1 18 14.5a3.5 3.5 0 0 1-3.5 4.5A3.5 3.5 0 0 1 12 17V7a3.5 3.5 0 0 1 3-2Z" /><path d="M8 10h4M12 14h4" />',
  Neuroscience: '<circle cx="6" cy="12" r="2" /><circle cx="12" cy="6" r="2" /><circle cx="18" cy="12" r="2" /><circle cx="12" cy="18" r="2" /><path d="m7.5 10.5 3-3M13.5 7.5l3 3M16.5 13.5l-3 3M10.5 16.5l-3-3" />',
  Physiology: '<path d="M12 20S4 15.5 4 9.7A4.7 4.7 0 0 1 12 7a4.7 4.7 0 0 1 8 2.7C20 15.5 12 20 12 20Z" /><path d="M5 12h3l1.5-3 2.5 6 1.5-3H19" />',
  Kinesiology: '<circle cx="15" cy="5" r="2" /><path d="m13.5 8-3 4 3.5 3 2.5 5M10.5 12 7 10 5 14M14 9l4 2" />',
  Chemistry: '<path d="M9 3h6M10 3v6l-6 9a2 2 0 0 0 1.7 3h12.6A2 2 0 0 0 20 18l-6-9V3" /><path d="M7 15h10" />',
  Physics: '<ellipse cx="12" cy="12" rx="9" ry="4" /><ellipse cx="12" cy="12" rx="9" ry="4" transform="rotate(60 12 12)" /><circle cx="12" cy="12" r="1.8" />',
  'Materials Science': '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" /><path d="m4 7.5 8 4.5 8-4.5M12 12v9" />',
  Energy: '<path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z" />',
};

const scienceIconFor = (label: string) => scienceIcons[label] ?? '<circle cx="12" cy="12" r="7" /><path d="M12 8v8M8 12h8" />';
---

<div class="site-navigation">
  <nav class="site-nav__desktop" aria-label="Primary">
    <ul>
      {primaryNavigation.map((entry) => (
        <li
          class:list={[
            'site-nav__item',
            {
              'site-nav__item--group': !('href' in entry),
              'site-nav__item--mega': 'sections' in entry,
              'site-nav__item--current': !('href' in entry) && hasCurrentChild(entry),
            },
          ]}
        >
          {'href' in entry ? (
            <a class="site-nav__link" href={entry.href} aria-current={isCurrent(entry) ? 'page' : undefined}>
              {entry.label}
            </a>
          ) : (
            <details class="site-nav__details" data-current={hasCurrentChild(entry) ? 'true' : undefined} data-nav-dropdown>
              <summary class="site-nav__trigger" data-nav-summary>
                {entry.label}
                <svg class="site-nav__chevron" viewBox="0 0 10 6" aria-hidden="true"
                  set:html={chevron}></svg>
              </summary>
              {entry.sections ? (
                <div class="site-nav__mega">
                  {entry.sections.map((section) => (
                    <div class="site-nav__section">
                      <span class="site-nav__section-heading">{section.label}</span>
                      <ul>
                        {section.items.map((item) => (
                          <li>
                            <a class="site-nav__science-link" href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
                              <svg class="site-nav__item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={scienceIconFor(item.label)}></svg>
                              <span>{item.label}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ) : (
                <ul class="site-nav__dropdown">
                  {entry.items?.map((item) => (
                    <li>
                      <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </details>
          )}
        </li>
      ))}
    </ul>
  </nav>

  <details class="site-nav__mobile">
    <summary class="site-nav__mobile-trigger">
      <span>Menu</span>
      <svg class="site-nav__mobile-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" />
      </svg>
    </summary>
    <div class="site-nav__mobile-panel">
      <nav aria-label="Mobile primary">
        <ul>
          {primaryNavigation.map((entry) => (
            <li class="site-nav__mobile-item">
              {'href' in entry ? (
                <a href={entry.href} aria-current={isCurrent(entry) ? 'page' : undefined}>{entry.label}</a>
              ) : (
                <details open={hasCurrentChild(entry) || undefined} data-nav-dropdown>
                  <summary data-nav-summary>
                    {entry.label}
                    <svg class="site-nav__chevron" viewBox="0 0 10 6" aria-hidden="true"
                      set:html={chevron}></svg>
                  </summary>
                  {entry.sections ? (
                    <ul>
                      {entry.sections.map((section) => (
                        <li>
                          <span class="site-nav__section-heading">{section.label}</span>
                          <ul>
                            {section.items.map((item) => (
                              <li>
                                <a class="site-nav__science-link" href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
                                  <svg class="site-nav__item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={scienceIconFor(item.label)}></svg>
                                  <span>{item.label}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <ul>
                      {entry.items?.map((item) => (
                        <li><a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a></li>
                      ))}
                    </ul>
                  )}
                </details>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </details>
</div>

<script>
  const navDropdownSelector = 'details[data-nav-dropdown]';

  const closeNavDropdowns = (except?: HTMLDetailsElement) => {
    document.querySelectorAll<HTMLDetailsElement>(`${navDropdownSelector}[open]`).forEach((details) => {
      if (details !== except) details.removeAttribute('open');
    });
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const summary = target.closest<HTMLElement>('summary[data-nav-summary]');
    if (summary) {
      const details = summary.closest<HTMLDetailsElement>(navDropdownSelector);
      if (details) closeNavDropdowns(details);
      return;
    }

    if (!target.closest('.site-navigation')) closeNavDropdowns();
  });

  document.addEventListener('focusin', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('.site-navigation')) closeNavDropdowns();
  });

  document.addEventListener('astro:before-preparation', () => closeNavDropdowns());
  document.addEventListener('astro:before-swap', () => closeNavDropdowns());
</script>
