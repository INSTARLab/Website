---
import {
  primaryNavigation,
  type NavigationItem,
  type PrimaryNavigationEntry,
} from '../../data/siteNavigation';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const normalizePath = (path: string) => {
  const normalized = path.split('?')[0].replace(/\/+$/, '');
  return normalized || '/';
};

const current = normalizePath(currentPath);

const isCurrent = (item: NavigationItem) => {
  const target = normalizePath(item.href);
  return target === current || (target !== '/' && current.startsWith(`${target}/`));
};

const hasCurrentChild = (entry: PrimaryNavigationEntry) => {
  if ('href' in entry) return isCurrent(entry);
  return Boolean(
    entry.items?.some(isCurrent) || entry.sections?.some((section) => section.items.some(isCurrent)),
  );
};

const chevron = '<path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />';
---

<div class="site-navigation">
  <nav class="site-nav__desktop" aria-label="Primary">
    <ul>
      {primaryNavigation.map((entry) => (
        <li
          class:list={[
            'site-nav__item',
            { 'site-nav__item--group': !('href' in entry), 'site-nav__item--mega': 'sections' in entry },
          ]}
        >
          {'href' in entry ? (
            <a class="site-nav__link" href={entry.href} aria-current={isCurrent(entry) ? 'page' : undefined}>
              {entry.label}
            </a>
          ) : (
            <details class="site-nav__details" open={hasCurrentChild(entry) || undefined}>
              <summary class="site-nav__trigger">
                {entry.label}
                <svg class="site-nav__chevron" viewBox="0 0 10 6" aria-hidden="true"
                  set:html={chevron}></svg>
              </summary>
              {entry.sections ? (
                <div class="site-nav__mega">
                  {entry.sections.map((section) => (
                    <div class="site-nav__section">
                      <h2>{section.label}</h2>
                      <ul>
                        {section.items.map((item) => (
                          <li>
                            <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ) : (
                <ul class="site-nav__dropdown">
                  {entry.items?.map((item) => (
                    <li>
                      <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </details>
          )}
        </li>
      ))}
    </ul>
  </nav>

  <details class="site-nav__mobile">
    <summary class="site-nav__mobile-trigger">
      <span>Menu</span>
      <svg class="site-nav__mobile-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" />
      </svg>
    </summary>
    <div class="site-nav__mobile-panel">
      <nav aria-label="Mobile primary">
        <ul>
          {primaryNavigation.map((entry) => (
            <li class="site-nav__mobile-item">
              {'href' in entry ? (
                <a href={entry.href} aria-current={isCurrent(entry) ? 'page' : undefined}>{entry.label}</a>
              ) : (
                <details open={hasCurrentChild(entry) || undefined}>
                  <summary>
                    {entry.label}
                    <svg class="site-nav__chevron" viewBox="0 0 10 6" aria-hidden="true"
                      set:html={chevron}></svg>
                  </summary>
                  {entry.sections ? (
                    <ul>
                      {entry.sections.map((section) => (
                        <li>
                          <span class="site-nav__section-heading">{section.label}</span>
                          <ul>
                            {section.items.map((item) => (
                              <li><a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a></li>
                            ))}
                          </ul>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <ul>
                      {entry.items?.map((item) => (
                        <li><a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a></li>
                      ))}
                    </ul>
                  )}
                </details>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </details>
</div>
