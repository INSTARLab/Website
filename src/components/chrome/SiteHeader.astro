---
import { utilityNavigation } from '../../data/siteNavigation';
import PrimaryNavigation from './PrimaryNavigation.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="site-header">
  <div class="site-utility">
    <div class="site-container site-utility__inner">
      <nav aria-label="Contact">
        <ul>
          {utilityNavigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="site-header__main">
    <div class="site-container site-header__inner">
      <a class="site-brand" href="/" aria-label="INSTAR Lab home">
        <img src="/img/logo/instar.svg" alt="INSTAR Lab" width="188" height="52" />
      </a>

      <div class="site-header__nav">
        <PrimaryNavigation {currentPath} />
      </div>

      <a class="site-header__donate" href="/community/support/">Donate</a>
    </div>
  </div>
</header>
