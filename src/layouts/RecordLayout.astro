---
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/record-theme.css';
import '../styles/record.css';
import type { SeoProps } from '../components/seo/Seo.astro';
import Seo from '../components/seo/Seo.astro';
import SkipLink from '../components/chrome/SkipLink.astro';

interface Props extends SeoProps {
  lang?: string;
  bodyClass?: string;
  mainClass?: string;
}

const {
  lang = 'en',
  bodyClass,
  mainClass,
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-record-shell="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* RR-101. The Record room's grouped top navigation needs script for its
      * dropdown behaviour, so `data-record-js` separates the two states: with
      * JavaScript the four group menus take over at desktop widths and the
      * flat strip carries small screens; without it the flat strip carries all
      * sixteen destinations in flow at every width. The flag therefore has to
      * be resolved during head parsing, before the browser's first layout and
      * paint.
      *
      * It used to be set by the deferred module below. Module scripts always
      * execute after HTML parsing, so the browser painted the flat strip first
      * and then swapped the navigation row once the module ran. `is:inline`
      * keeps this tiny script out of the bundle so it runs synchronously, in
      * place, ahead of the stylesheets.
      *
      * With JavaScript disabled the attribute is never set, so the no-JS
      * fallback below is unchanged: all sixteen navigation links in flow. */}
    <script is:inline>
      document.documentElement.dataset.recordJs = 'true';
    </script>
    <Seo {...seoProps} />
    <slot name="head" />
  </head>
  <body id="top" data-bs-theme="light" class:list={['record-body', bodyClass]}>
    <SkipLink />
    <main class:list={['record-main', mainClass]}>
      <slot />
    </main>
  </body>
</html>

<script>
  /**
   * The Record room keeps ordinary document links as its source of truth.
   * This small enhancement gives the four top-bar group buttons their
   * dropdown behaviour: one menu opens at a time, a button tap toggles,
   * choosing a destination closes, outside interaction closes, Escape closes
   * and refocuses the owning button, and the arrow/Home/End keys walk the
   * buttons and the open menu's links. A closed menu carries the `hidden`
   * attribute (enforced by record.css), so it is never focusable, and the
   * flat strip below the groups keeps every destination reachable without
   * script. The *visibility* switch is not here — it is driven by the
   * `data-record-js` flag set synchronously in the head, so the navigation
   * row is correct at first paint (see the note in <head>).
   */
  const groupsNav = document.querySelector<HTMLElement>('[data-record-groups]');

  if (groupsNav) {
    const groupButtons = () =>
      [...groupsNav.querySelectorAll<HTMLButtonElement>('.record-topbar__group > button')];

    const closeGroups = (except: Element | null = null) => {
      groupsNav.querySelectorAll('.record-topbar__group').forEach((item) => {
        if (item === except) return;
        item.querySelector(':scope > button')?.setAttribute('aria-expanded', 'false');
        const menu = item.querySelector(':scope > .record-topbar__menu');
        if (menu instanceof HTMLElement) menu.hidden = true;
      });
    };

    const openGroup = (item: Element) => {
      const button = item.querySelector(':scope > button');
      const menu = item.querySelector(':scope > .record-topbar__menu');
      if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
      closeGroups(item);
      button.setAttribute('aria-expanded', 'true');
      menu.hidden = false;
    };

    const menuLinks = (item: Element) =>
      [...item.querySelectorAll<HTMLAnchorElement>('.record-topbar__menu a')];

    const focusButton = (index: number) => {
      const buttons = groupButtons();
      if (buttons.length === 0) return;
      const next = buttons[(index + buttons.length) % buttons.length];
      closeGroups();
      next.focus();
    };

    groupsNav.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const button = target?.closest('.record-topbar__group > button');
      if (button instanceof HTMLButtonElement) {
        const item = button.closest('.record-topbar__group');
        if (button.getAttribute('aria-expanded') === 'true') closeGroups();
        else if (item) openGroup(item);
        return;
      }
      if (target?.closest('.record-topbar__menu a')) closeGroups();
    });

    groupsNav.addEventListener('keydown', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const buttons = groupButtons();
      const button = target?.closest('.record-topbar__group > button');
      if (button instanceof HTMLButtonElement) {
        const at = buttons.indexOf(button);
        const item = button.closest('.record-topbar__group');
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          focusButton(at + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          focusButton(at - 1);
        } else if (event.key === 'Home') {
          event.preventDefault();
          focusButton(0);
        } else if (event.key === 'End') {
          event.preventDefault();
          focusButton(buttons.length - 1);
        } else if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          if (item) {
            openGroup(item);
            menuLinks(item)[0]?.focus();
          }
        } else if (event.key === 'Escape') {
          event.preventDefault();
          closeGroups();
        }
        return;
      }

      const link = target?.closest('.record-topbar__menu a');
      if (!(link instanceof HTMLAnchorElement)) return;
      const group = link.closest('.record-topbar__group');
      if (!group) return;
      const links = menuLinks(group);
      const position = links.indexOf(link);
      if (event.key === 'Escape') {
        event.preventDefault();
        closeGroups();
        group.querySelector<HTMLElement>(':scope > button')?.focus();
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        links[position + 1]?.focus();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (position <= 0) group.querySelector<HTMLElement>(':scope > button')?.focus();
        else links[position - 1]?.focus();
      } else if (event.key === 'Home') {
        event.preventDefault();
        links[0]?.focus();
      } else if (event.key === 'End') {
        event.preventDefault();
        links[links.length - 1]?.focus();
      }
    });

    groupsNav.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && groupsNav.contains(event.relatedTarget)) return;
      closeGroups();
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target?.closest('.record-topbar__group')) closeGroups();
    });

    // A menu left open across the desktop/small-screen switch would strand an
    // `aria-expanded="true"` button on a hidden group list (or a stale closed
    // menu on return), so every breakpoint crossing closes all four.
    const desktopQuery = window.matchMedia('(min-width: 62rem)');
    desktopQuery.addEventListener('change', () => closeGroups());
  }
</script>
