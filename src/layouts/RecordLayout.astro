---
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/record-theme.css';
import '../styles/record.css';
import type { SeoProps } from '../components/seo/Seo.astro';
import Seo from '../components/seo/Seo.astro';
import SkipLink from '../components/chrome/SkipLink.astro';

interface Props extends SeoProps {
  lang?: string;
  bodyClass?: string;
  mainClass?: string;
}

const {
  lang = 'en',
  bodyClass,
  mainClass,
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-record-shell="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* RR-301 BLK-1. The Record room's small-screen shell is an off-canvas
      * panel when `data-record-js` is present on the root element and an
      * in-flow navigation list when it is not — a 891px difference in where
      * `ARTICLE.record-document` starts. The flag therefore has to be resolved
      * during head parsing, before the browser's first layout and paint.
      *
      * It used to be set by the deferred module below. Module scripts always
      * execute after HTML parsing, so the browser painted the in-flow layout
      * first and then moved the entire document: a single layout-shift entry
      * of 1.0 (the maximum) on the first load of every page. `is:inline` keeps
      * this tiny script out of the bundle so it runs synchronously, in place,
      * ahead of the stylesheets.
      *
      * With JavaScript disabled the attribute is never set, so the no-JS
      * fallback below is unchanged: all twelve navigation links in flow. */}
    <script is:inline>
      document.documentElement.dataset.recordJs = 'true';
    </script>
    <Seo {...seoProps} />
    <slot name="head" />
  </head>
  <body id="top" data-bs-theme="light" class:list={['record-body', bodyClass]}>
    <SkipLink />
    <main class:list={['record-main', mainClass]}>
      <slot />
    </main>
  </body>
</html>

<script>
  /**
   * The Record room keeps ordinary document links as its source of truth.
   * This small enhancement gives the Bootstrap-shaped sidebar its off-canvas
   * behaviour on small screens: focus trapping, Escape, backdrop and focus
   * return. The *geometry* switch is not here — it is driven by the
   * `data-record-js` flag set synchronously in the head, so that the panel's
   * layout is correct at first paint (see the note in <head>).
   */
  const body = document.body;
  const sidebar = document.querySelector<HTMLElement>('#record-sidebar');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-record-menu-toggle]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-record-menu-close]');
  const backdrop = document.querySelector<HTMLElement>('[data-record-sidebar-backdrop]');
  const mainContent = document.querySelector<HTMLElement>('#main-content');

  if (body && sidebar && menuButton) {
    let returnFocus: HTMLElement | null = null;

    const setOpen = (open: boolean) => {
      sidebar.classList.toggle('show', open);
      backdrop?.classList.toggle('show', open);
      body.classList.toggle('record-menu-open', open);
      menuButton.setAttribute('aria-expanded', String(open));
      const offcanvasHidden = !open && window.matchMedia('(max-width: 991.98px)').matches;
      sidebar.setAttribute('aria-hidden', String(offcanvasHidden));
      // Keep the closed panel out of the focus order immediately. The panel
      // transitions `visibility`, which stays `visible` for the full 250ms, so
      // aria-hidden alone would leave focusable links inside a hidden subtree
      // during that window.
      sidebar.toggleAttribute('inert', offcanvasHidden);
      if (open) {
        sidebar.setAttribute('role', 'dialog');
        sidebar.setAttribute('aria-modal', 'true');
        // `aria-modal` asserts that everything outside the dialog is
        // unavailable. The Tab trap below enforces that for Tab, but a virtual
        // cursor can still reach the document behind the panel, so the claim
        // was not true. `inert` makes it true for every input path.
        //
        // It goes on the document article rather than on `main`: the sidebar
        // is itself inside `main`, and inerting an ancestor would inert the
        // panel along with the background.
        mainContent?.setAttribute('inert', '');
      } else {
        sidebar.removeAttribute('role');
        sidebar.removeAttribute('aria-modal');
        mainContent?.removeAttribute('inert');
      }

      if (open) {
        returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : menuButton;
        window.setTimeout(() => {
          const firstLink = sidebar.querySelector<HTMLAnchorElement>('a[href]');
          firstLink?.focus();
        }, 0);
      } else {
        const desktop = window.matchMedia('(min-width: 992px)').matches;
        const canRestoreFocus = returnFocus instanceof HTMLElement
          && returnFocus.isConnected
          && getComputedStyle(returnFocus).display !== 'none';
        const fallback = desktop
          ? sidebar.querySelector<HTMLElement>('a[href]')
          : menuButton;
        (canRestoreFocus ? returnFocus : fallback)?.focus();
        returnFocus = null;
      }
    };

    menuButton.addEventListener('click', () => setOpen(true));
    closeButton?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));

    sidebar.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a[href]')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (!sidebar.classList.contains('show')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        return;
      }

      if (event.key !== 'Tab') return;
      const focusable = [...sidebar.querySelectorAll<HTMLElement>('a[href], button:not([hidden]), [tabindex]:not([tabindex="-1"])')]
        .filter((element) => getComputedStyle(element).visibility !== 'hidden' && getComputedStyle(element).display !== 'none');
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && (document.activeElement === first || !sidebar.contains(document.activeElement))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (document.activeElement === last || !sidebar.contains(document.activeElement))) {
        event.preventDefault();
        first.focus();
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 992px)');
    const syncViewportState = () => {
      const offcanvasHidden = !desktopQuery.matches;
      sidebar.setAttribute('aria-hidden', String(offcanvasHidden));
      sidebar.toggleAttribute('inert', offcanvasHidden);
    };
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
      syncViewportState();
    });

    syncViewportState();
  }
</script>
