---
import W5EditorialDocument from '../../../components/workstream5/W5EditorialDocument.astro';
import { routesForFamily } from '../../../data/workstream5/manifest';
import type { W5RouteRecord } from '../../../data/workstream5/types';

export const prerender = true;

interface Props {
  record: W5RouteRecord;
}

export function getStaticPaths() {
  return routesForFamily('news')
    .filter((record) => record.path !== '/news/')
    .map((record) => ({
      params: { slug: record.path.split('/')[2] },
      props: { record },
    }));
}

const { record } = Astro.props;
---

<W5EditorialDocument record={record} />
