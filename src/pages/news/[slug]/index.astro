---
import { getCollection } from 'astro:content';
import ArticleDocument from '../../../components/editorial/article/ArticleDocument.astro';
import {
  articleSlug,
  publishedArticles,
  relatedArticles,
  type ArticleEntry,
} from '../../../data/articles';

export const prerender = true;

interface Props {
  article: ArticleEntry;
}

export async function getStaticPaths() {
  const articles = publishedArticles(await getCollection('articles', ({ data }) => !data.draft));

  return articles.map((article) => ({
    params: { slug: articleSlug(article) },
    props: { article },
  }));
}

const { article } = Astro.props;
const articles = publishedArticles(await getCollection('articles', ({ data }) => !data.draft));
const authors = await getCollection('authors');
const related = relatedArticles(article, articles);
---

<ArticleDocument article={article} authors={authors} related={related} />
