---
import { getCollection } from 'astro:content';
import ArticleIndex from '../../components/editorial/article/ArticleIndex.astro';
import { publishedArticles } from '../../data/articles';

export const prerender = true;

const articles = publishedArticles(await getCollection('articles', ({ data }) => !data.draft));
const authors = await getCollection('authors');
---

<ArticleIndex articles={articles} authors={authors} />
