---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import FlowDiagram from '../../../components/record/viz/FlowDiagram.astro';
import { recordHref, recordJourneys, recordRouteAtPath } from '../../../data/record';

const route = recordRouteAtPath('/record/journeys/');
const totalSteps = recordJourneys.reduce((sum, journey) => sum + journey.steps.length, 0);
const programOfficer = recordJourneys.find((journey) => journey.id === 'program-officer');
const institutionalPartner = recordJourneys.find((journey) => journey.id === 'institutional-partner');
---

<RecordDocument {route}>
  <div class="container-fluid px-0">
    <section class="mb-5" aria-labelledby="journeys-brief-title">
      <div class="row g-4 align-items-end"><div class="col-12 col-xl-8"><p class="text-uppercase small fw-bold text-primary mb-2">Decision briefs / linked route flows</p><h2 id="journeys-brief-title" class="display-6 fw-semibold mb-3">Start with the question; follow the public route.</h2><p class="lead mb-0">These flows are assembled from existing journey records. They organize orientation, evidence, and a next conversation without claiming eligibility, conversion, availability, or program performance.</p></div><div class="col-12 col-xl-4"><div class="alert alert-info mb-0" role="note"><strong>How to read this.</strong> Each numbered node is a linked public route. The final action is a destination suggested by the source record, not a promise of acceptance or response.</div></div></div>
    </section>

    <section class="mb-5" aria-labelledby="journeys-stats-title"><h2 id="journeys-stats-title" class="visually-hidden">Decision brief summary</h2><div class="row g-3"><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Recorded paths</p><p class="display-6 fw-semibold mb-1">{recordJourneys.length}</p><p class="mb-0 text-body-secondary">Role-specific route flows in the current public record.</p></div></div></div><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Linked route steps</p><p class="display-6 fw-semibold mb-1">{totalSteps}</p><p class="mb-0 text-body-secondary">Existing route nodes across all recorded journeys.</p></div></div></div><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Next actions</p><p class="display-6 fw-semibold mb-1">{recordJourneys.length}</p><p class="mb-0 text-body-secondary">One source-defined next action for each path.</p></div></div></div></div></section>

    <section class="mb-5" aria-labelledby="journeys-map-title">
      <div class="d-flex flex-wrap justify-content-between gap-3 align-items-end mb-3"><div><p class="text-uppercase small fw-bold text-primary mb-2">Route flow map</p><h2 id="journeys-map-title" class="h3 mb-1">Five ways into the same public evidence graph</h2><p class="text-body-secondary mb-0">The ordered lists remain fully available when JavaScript is disabled.</p></div><span class="badge text-bg-light border text-dark">No performance funnel</span></div>
      <div class="row g-4">{recordJourneys.map((journey) => <div class="col-12 col-lg-6"><article class="card h-100 shadow-sm" id={journey.id}><div class="card-body d-flex flex-column"><div class="d-flex justify-content-between gap-3 align-items-start mb-3"><div><p class="text-uppercase small fw-bold text-primary mb-2">{journey.id}</p><h3 class="h4 mb-2">{journey.label}</h3></div><span class="badge rounded-pill text-bg-primary">{journey.steps.length} steps</span></div><p class="mb-4">{journey.question}</p><div class="mb-4"><FlowDiagram title={`${journey.label} route sequence`} steps={journey.steps.map((step) => ({ label: step.label, href: recordHref(step.href), description: step.href }))} description="A linked sequence from the existing journey record." source="Record journey manifest" sourceHref={recordHref('/record/verify/')} /></div><div class="border-top pt-3 mt-auto"><p class="text-uppercase small fw-bold text-secondary mb-2">Next action from source record</p><a class="btn btn-outline-primary" href={recordHref(journey.nextAction.href)}>{journey.nextAction.label} <span aria-hidden="true">→</span></a></div></div></article></div>)}</div>
    </section>

    <section aria-labelledby="journeys-crosslinks-title"><div class="row g-4"><div class="col-12 col-lg-6"><div class="card border-primary h-100"><div class="card-body"><p class="text-uppercase small fw-bold text-primary mb-2">Federal pathway</p><h2 id="journeys-crosslinks-title" class="h4">Program officer flow</h2><p class="mb-0">{programOfficer?.steps.map((step) => step.label).join(' → ') ?? 'No source-defined federal path is available.'}</p><a class="btn btn-link px-0" href={recordHref('/record/federal/')}>Inspect federal record <span aria-hidden="true">↗</span></a></div></div></div><div class="col-12 col-lg-6"><div class="card border-primary h-100"><div class="card-body"><p class="text-uppercase small fw-bold text-primary mb-2">Institutional pathway</p><h2 class="h4">Partner flow</h2><p class="mb-0">{institutionalPartner?.steps.map((step) => step.label).join(' → ') ?? 'No source-defined partner path is available.'}</p><a class="btn btn-link px-0" href={recordHref('/community/partner/')}>Inspect partner route <span aria-hidden="true">↗</span></a></div></div></div></div></section>

    <section class="mt-5" aria-labelledby="journeys-method-title"><div class="alert alert-warning mb-0" role="note"><h2 id="journeys-method-title" class="h4">A route is not a promise.</h2><p class="mb-0">Use the destination route for current scope, fit, and contact instructions. This record room only makes the existing path easier to inspect.</p></div></section>
  </div>
</RecordDocument>
