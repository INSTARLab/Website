---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import { editorialRoutes, familyLabel, type EditorialFamily } from '../../../data/editorialRoutes';
import { recordHref, recordRouteAtPath } from '../../../data/record';
import { siteIdentity } from '../../../data/seo/site';

const route = recordRouteAtPath('/record/marketing/');
const families = [...new Set(editorialRoutes.map((entry) => entry.family))] as EditorialFamily[];
const familyBreakdown = families.map((family) => {
  const routes = editorialRoutes.filter((entry) => entry.family === family);
  return { family, label: familyLabel(family), count: routes.length };
});
const researchRouteCount = editorialRoutes.filter((entry) => entry.family === 'research').length;
const audienceSignals = [
  { label: 'Federal and institutional research partners', route: '/research/funding/', capability: 'Inspect research, funding, and sponsored-program context before opening a conversation.' },
  { label: 'Technical collaborators and industry partners', route: '/community/work-with-us/', capability: 'Compare research, technology transfer, enterprise R&D, and co-investigation pathways.' },
  { label: 'Researchers, fellows, and staff', route: '/fellowship/', capability: 'Move from research themes to fellowship, careers, and current public briefs.' },
  { label: 'Supporters and Friends of INSTAR', route: '/community/support/', capability: 'Understand the mission and the public support route.' },
] as const;
---

<RecordDocument {route}>
  <div class="container-fluid px-0">
    <section class="mb-5" aria-labelledby="marketing-brief-title">
      <div class="row g-4 align-items-end">
        <div class="col-12 col-xl-8"><p class="text-uppercase small fw-bold text-primary mb-2">Positioning / route inventory</p><h2 id="marketing-brief-title" class="mb-3">The public profile is a map of research questions.</h2><p class="lead mb-0">This register counts the editorial route manifest and pairs its audience signals with the next public route. It describes site architecture and language; it does not turn those signals into traffic, conversion, customer, or funding performance.</p></div>
        <div class="col-12 col-xl-4"><div class="card border-primary shadow-sm h-100"><div class="card-body"><p class="text-uppercase small fw-bold text-primary mb-2">Published positioning</p><h3>{siteIdentity.name}</h3><p class="mb-3">{siteIdentity.description}</p><a class="btn btn-primary" href={recordHref('/mission/')}>Read the mission <span aria-hidden="true">↗</span></a></div></div></div>
      </div>
    </section>

    <section class="mb-5" aria-labelledby="marketing-stats-title"><h2 id="marketing-stats-title" class="visually-hidden">Market profile summary</h2><div class="row g-3"><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Manifest routes</p><p class="display-6 fw-semibold mb-1">{editorialRoutes.length}</p><p class="mb-0 text-body-secondary">Editorial routes represented in the current source graph.</p></div></div></div><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Route families</p><p class="display-6 fw-semibold mb-1">{familyBreakdown.length}</p><p class="mb-0 text-body-secondary">Research, technology, sciences, community, labs, news, fellowship, and transfer families.</p></div></div></div><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Research routes</p><p class="display-6 fw-semibold mb-1">{researchRouteCount}</p><p class="mb-0 text-body-secondary">Research-domain routes in the manifest; this is not a measure of program activity.</p></div></div></div></div></section>

    <section class="mb-5" aria-labelledby="marketing-domains-title">
      <div class="d-flex flex-wrap justify-content-between gap-3 align-items-end mb-3"><div><p class="text-uppercase small fw-bold text-primary mb-2">Source graph visualization</p><h2 id="marketing-domains-title" class="mb-1">Where the route vocabulary is concentrated</h2><p class="text-body-secondary mb-0">Counts are derived from the editorial manifest. The bars compare route inventory, not demand or outcomes.</p></div><span class="badge text-bg-light border text-dark">Repository measurement</span></div>
      <div class="card shadow-sm"><div class="card-body"><BarChart level={3} title="Editorial route families" items={familyBreakdown.map((entry) => ({ label: entry.label, value: entry.count }))} description="Counts are derived from the current editorial route manifest. They describe information architecture, not demand or outcomes." source="Route manifests (SRC-002)" sourceHref={recordHref('/record/verify/')} /></div></div>
    </section>

    <section class="mb-5" aria-labelledby="marketing-audience-title">
      <div class="d-flex flex-wrap justify-content-between gap-3 align-items-end mb-3"><div><p class="text-uppercase small fw-bold text-primary mb-2">Curated audience map</p><h2 id="marketing-audience-title" class="mb-1">Reader job → public capability route</h2><p class="text-body-secondary mb-0">These audience labels are editorial groupings inferred from existing route copy and calls to action.</p></div><a class="btn btn-outline-primary" href={recordHref('/record/journeys/')}>Open decision briefs <span aria-hidden="true">↗</span></a></div>
      <div class="table-responsive border rounded-3 shadow-sm" tabindex="0" role="region" aria-label="Audience coverage"><table class="table table-striped align-middle mb-0"><caption class="visually-hidden">Curated audience to capability route matrix</caption><thead class="table-light"><tr><th scope="col">Audience signal</th><th scope="col">What the route helps them inspect</th><th scope="col">Public starting point</th></tr></thead><tbody>{audienceSignals.map((signal) => <tr><th scope="row">{signal.label}</th><td>{signal.capability}</td><td><a href={recordHref(signal.route)}>{signal.route}</a></td></tr>)}</tbody></table></div>
    </section>

    <section aria-labelledby="marketing-discipline-title"><div class="alert alert-warning mb-0" role="note"><h2 id="marketing-discipline-title">Claim discipline</h2><p class="mb-0">Words such as “advanced,” “frontier,” or “qualified” remain descriptions from the public route data. This page does not treat them as proof of a contract, customer outcome, active award, or external validation.</p></div></section>
  </div>
</RecordDocument>
