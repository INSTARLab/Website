---
import RecordDocument from '../../components/record/RecordDocument.astro';
import MetricGrid from '../../components/record/ui/MetricGrid.astro';
import BarChart from '../../components/record/viz/BarChart.astro';
import {
  recordHref,
  recordRouteAtPath,
  recordSourceRegister,
  sitePageRecords,
} from '../../data/record';
import {
  recordBiIsStale,
  recordBiMetricDefinitions,
  recordBiSnapshot,
  recordBiValueStateForMetric,
} from '../../data/record-bi';
import { latestMetricAggregate, periodLabel } from '../../data/record-bi/selectors.mjs';

const route = recordRouteAtPath('/record/');

const routeFamilies = [...new Set(sitePageRecords.map((entry) => entry.family))]
  .map((family) => ({
    family,
    count: sitePageRecords.filter((entry) => entry.family === family).length,
  }))
  .sort((left, right) => right.count - left.count || left.family.localeCompare(right.family));
const sourceStatuses = [
  { label: 'Verified in repository', count: recordSourceRegister.filter((source) => source.status === 'verified-in-repository').length },
  { label: 'Review required', count: recordSourceRegister.filter((source) => source.status === 'review-required').length },
  { label: 'Not public', count: recordSourceRegister.filter((source) => source.status === 'not-public').length },
] as const;

// Three states, three renderings. A measure the institution has measured —
// including a measured zero — shows its number; a measure that is approved but
// has no publishable value says so and gives the reason; a measure with no
// approved observation says that instead. They are carried into the DOM as
// `data-record-value-state` so the distinction is machine-checkable.
const biCards = recordBiMetricDefinitions.map((definition) => {
  const aggregate = latestMetricAggregate(definition, recordBiSnapshot.observations);
  const observations = aggregate?.observations ?? [];
  const declared = recordBiValueStateForMetric(definition.id);
  // `measured` is only claimed when a number actually reaches the page. A
  // measure whose latest observations are not a comparable period has no value
  // to publish, whatever its rows say.
  const value = declared === 'measured' && aggregate ? aggregate.value : null;
  const state = declared === 'measured' && value === null ? 'unavailable' : declared;
  const staleCount = observations.filter((observation) => recordBiIsStale(observation)).length;
  const freshness = staleCount === 0 ? 'Reported' : staleCount === observations.length ? 'Stale' : 'Mixed freshness';
  const sourceLabels = [...new Set((aggregate?.sources ?? []).map((source) => source.label))].join('; ');
  const detail = state === 'measured'
    ? [freshness, definition.unit, aggregate ? periodLabel(aggregate) : '', sourceLabels].filter(Boolean).join(' · ')
    : state === 'unavailable'
      ? ['Not reported', aggregate ? periodLabel(aggregate) : '', aggregate?.unavailableReason ?? ''].filter(Boolean).join(' · ')
      : 'Not reported · no approved observation is published for this measure';
  return { label: definition.label, value, state, note: detail };
});
const biMeasuredCount = biCards.filter((card) => card.state === 'measured').length;
const biUnavailableCount = biCards.filter((card) => card.state === 'unavailable').length;
const biNoSnapshotCount = biCards.filter((card) => card.state === 'no-snapshot').length;
const biHeading = biMeasuredCount === 0
  ? `${recordBiMetricDefinitions.length} measures awaiting approved values`
  : 'Operational measures in the current snapshot';
const biLead = recordBiSnapshot.status === 'empty'
  ? recordBiSnapshot.note ?? 'No approved operational snapshot is loaded.'
  : `${biMeasuredCount} of ${recordBiMetricDefinitions.length} measures carry an approved value, ${biUnavailableCount} are approved with no published value, and ${biNoSnapshotCount} have no approved observation. A published zero is a measured figure, not a missing one.`;
const familyBars = routeFamilies.map((entry) => ({ label: entry.family, value: entry.count }));
const evidenceBars = sourceStatuses.map((entry) => ({ label: entry.label, value: entry.count }));
---

<RecordDocument {route}>
  <div class="container-fluid px-0">
    {/* RR-301 SF-12. This block used to be a `<section>` whose only label was a
      * `<p>` holding a sentence. A region whose name is a sentence fragment is
      * not a region a reader can navigate to; it is a paragraph with two
      * buttons, so it is markup'd as one.
      *
      * It keeps the `record-section` class because that class is not inert:
      * `src/styles/record.css:422` declares `.record-section p { max-width: 70ch;
      * color: var(--color-muted-strong) }`, which this paragraph depends on.
      * Dropping the class here would silently un-cap the measure and change the
      * ink. See the wave report for the CSS change that has to land first. */}
    <div class="record-section d-flex flex-wrap align-items-center justify-content-between gap-3">
      <p class="mb-0 text-body-secondary">Use the source register for limits, the site map for every route, and the decision briefs for a role-specific path.</p>
      <div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-primary" href={recordHref('/record/verify/')}>Source register</a><a class="btn btn-sm btn-outline-primary" href={recordHref('/record/journeys/')}>Decision briefs</a></div>
    </div>

    <section class="record-section mt-4" aria-labelledby="record-operational-title">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3"><div><p class="record-section__label mb-2">Operational BI</p><h2 id="record-operational-title" class="mb-2">{biHeading}</h2><p class="mb-0 text-body-secondary">{biLead}</p></div><a class="btn btn-sm btn-outline-primary" href={recordHref('/record/ops/')}>Open business status</a></div>
      <MetricGrid title="Operational BI measures" items={biCards} columns={4} />
    </section>

    <section class="record-section mt-5" aria-labelledby="record-inventory-title">
      {/* RR-301 BLK-2. `aria-labelledby="record-inventory-title"` pointed at an
        * id that existed nowhere, so this section had no accessible name and
        * the reference was silently discarded. The section holds two cards with
        * no heading of their own, so it needs a real target. Hidden rather than
        * visible because the two card labels ("Inventory", "Evidence coverage")
        * already name the content on screen. */}
      <h2 id="record-inventory-title" class="visually-hidden">Route inventory and evidence coverage</h2>
      <div class="row g-4">
        <div class="col-12 col-xl-7">
          <div class="card h-100 shadow-sm"><div class="card-body p-4">
            <p class="record-section__label mb-2">Inventory</p>
            <BarChart level={3} title="The public route graph by family" items={familyBars} description="Counts are derived from the current route manifests." source="Route manifests (SRC-002)" sourceHref={recordHref('/record/verify/')} />
            <a class="small" href={recordHref('/record/metrics/')}>View the full inventory and method.</a>
          </div></div>
        </div>
        <div class="col-12 col-xl-5">
          <div class="card h-100 shadow-sm"><div class="card-body p-4">
            <p class="record-section__label mb-2">Evidence coverage</p>
            <BarChart level={3} title="Source register states" items={evidenceBars} description="Repository source states, not external claim validation." source="Source register" sourceHref={recordHref('/record/verify/')} />
          </div></div>
        </div>
      </div>
    </section>

    <section class="record-section mt-5" aria-labelledby="record-next-title">
      <div class="card border-primary-subtle bg-primary-subtle">
        <div class="card-body p-4 p-lg-5">
          <div class="row g-4 align-items-center">
            <div class="col-12 col-lg-8">
              <p class="record-section__label mb-2">Next inspection</p>
              <h2 id="record-next-title" class="mb-2">Choose the evidence path that matches your question.</h2>
              <p class="mb-0">The site map covers every public route. Decision briefs explain where a program officer, collaborator, researcher, institutional partner, or supporter can begin.</p>
            </div>
            <div class="col-12 col-lg-4 d-flex flex-wrap gap-2 justify-content-lg-end">
              <a class="btn btn-primary" href={recordHref('/record/nav/')}>Browse all routes</a>
              <a class="btn btn-outline-primary" href={recordHref('/record/journeys/')}>Open decision briefs</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</RecordDocument>
