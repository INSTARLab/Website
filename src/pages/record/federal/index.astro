---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import LineChart from '../../../components/record/viz/LineChart.astro';
import { editorialRoutes } from '../../../data/editorialRoutes';
import { recordHref, recordJourneys, recordRouteAtPath } from '../../../data/record';
import { recordBiApprovalBasisLabel, recordBiApprovalLabel, recordBiIsStale, recordBiMetricDefinition, recordBiObservations, recordBiSnapshot } from '../../../data/record-bi';
import {
  comparableMetricSeries,
  latestMetricPeriod,
  observationDimensionsLabel,
  observationSourceLabel,
  periodLabel,
} from '../../../data/record-bi/selectors.mjs';

const route = recordRouteAtPath('/record/federal/');
const fundingRoute = editorialRoutes.find((entry) => entry.path === '/research/funding/');
const contactRoute = editorialRoutes.find((entry) => entry.path === '/community/contact/');
const programOfficer = recordJourneys.find((journey) => journey.id === 'program-officer');
const fundingDefinition = recordBiMetricDefinition('grants-awarded');
const fundingObservations = recordBiObservations.filter((observation) => observation.metricId === 'grants-awarded');
const latestFundingObservations = fundingDefinition ? latestMetricPeriod(fundingDefinition, fundingObservations) : [];
const fundingBars = latestFundingObservations.length > 0
  ? latestFundingObservations.map((observation) => ({ label: `${observationDimensionsLabel(observation)} · ${periodLabel(observation)}`, value: observation.value }))
  : [{ label: 'Grants awarded', value: null }];
const comparableSeries = fundingDefinition ? comparableMetricSeries(fundingDefinition, fundingObservations) : [];
const comparableCategory = comparableSeries.length > 0 ? observationDimensionsLabel(comparableSeries[0]) : null;
const fundingLine = comparableSeries.map((observation) => ({ period: periodLabel(observation), value: observation.value }));
// Finding-4 residual. The snapshot envelope may only stand in for attribution
// when there is no per-row observation to attribute at all — `latestMetricPeriod`
// can return [] on a same-end-date tie while `fundingObservations` is non-empty,
// and the snapshot label would then speak for rows it does not describe.
const fundingSource = latestFundingObservations.length > 0
  ? observationSourceLabel(latestFundingObservations.flatMap((observation) => observation.observations ?? [observation]))
  : fundingObservations.length > 0
    ? observationSourceLabel(fundingObservations)
    : recordBiSnapshot.status === 'published' ? recordBiSnapshot.source.label : 'No approved operational source';
const fundingLineSource = comparableSeries.length > 0
  ? observationSourceLabel(comparableSeries.flatMap((observation) => observation.observations ?? [observation]))
  : fundingSource;
const evidenceRows = [
  { field: 'Research topics', value: 'AI, quantum science, computing, health, energy, space, and the sciences', href: '/research/current-programs/', evidence: 'Current programs route', limit: 'Topic coverage is not proof of an active funded program or completed result.' },
  { field: 'Funding and sponsored programs', value: fundingRoute?.title ?? 'Federal research and sponsored programs', href: '/research/funding/', evidence: 'Funding route', limit: 'No current award, contract vehicle, schedule, or amount is asserted here.' },
  { field: 'Institutional engagement', value: 'Research, partnership, technology transfer, and enterprise R&D paths', href: '/community/partner/', evidence: 'Partner and transfer routes', limit: 'A route describes a possible conversation; it does not establish a current agreement.' },
  { field: 'Federal inquiry', value: contactRoute?.title ?? 'Public contact route', href: '/contact-us/', evidence: 'Contact route', limit: 'Mission, scope, timeline, and response must be confirmed with INSTAR.' },
] as const;
---

<RecordDocument {route}>
  <div class="container-fluid px-0">
    <section class="mb-5" aria-labelledby="federal-brief-title"><div class="row g-4 align-items-end"><div class="col-12 col-xl-8"><p class="text-uppercase small fw-bold text-primary mb-2">Research / acquisition evidence</p><h2 id="federal-brief-title" class="mb-3">A useful federal pathway without invented credentials.</h2><p class="lead mb-0">The public route graph names federal research, sponsored programs, institutional partnerships, and contact pathways. This page organizes those facts while keeping award status, contract details, registrations, and current availability outside the record until an approved source is present.</p></div><div class="col-12 col-xl-4"><div class="alert alert-info mb-0" role="note"><strong>Source boundary.</strong> A route-backed federal pathway is not evidence of an award, contract, customer, credential, or performance result.</div></div></div></section>

    <section class="mb-5" aria-labelledby="federal-stats-title"><h2 id="federal-stats-title" class="visually-hidden">Federal record summary</h2><div class="row g-3"><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Route-backed pathways</p><p class="display-6 fw-semibold mb-1">{evidenceRows.length}</p><p class="mb-0 text-body-secondary">Topic, funding, partnership, and inquiry routes in the public graph.</p></div></div></div><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Funding observations</p><p class="display-6 fw-semibold mb-1">{fundingObservations.length || '—'}</p><p class="mb-0 text-body-secondary">Approved grant observations available to publish; a measure with no approved observation remains Not reported.</p></div></div></div><div class="col-12 col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><p class="text-uppercase small fw-bold text-secondary mb-2">Snapshot state</p><p class="h3 fw-semibold mb-1">{recordBiSnapshot.status === 'published' ? 'Approved' : 'Not reported'}</p><p class="mb-0 text-body-secondary">Only a data-owner-approved snapshot can populate funding visuals.</p></div></div></div></div></section>

    <section class="mb-5" aria-labelledby="federal-funding-title"><div class="d-flex flex-wrap justify-content-between gap-3 align-items-end mb-3"><div><p class="text-uppercase small fw-bold text-primary mb-2">Business intelligence</p><h2 id="federal-funding-title" class="mb-1">Funding history and distribution</h2><p class="text-body-secondary mb-0">Bars show the latest comparable observation date by category. A time series is drawn only when one category has comparable, non-overlapping periods.</p></div><span class="badge text-bg-secondary">{recordBiSnapshot.status === 'published' ? 'Published snapshot' : 'Not reported'}</span></div><div class="row g-4"><div class="col-12 col-xl-6"><div class="card h-100 shadow-sm"><div class="card-body"><BarChart level={3} title="Funding awarded in the latest period" items={fundingBars} unit={fundingDefinition?.unit ?? 'USD'} approval={recordBiSnapshot.approval.status} description="Bars retain each category and exact latest period label. Unavailable categories remain Not reported." source={fundingSource} sourceHref={recordHref('/record/verify/')} /></div></div></div><div class="col-12 col-xl-6"><div class="card h-100 shadow-sm"><div class="card-body"><LineChart level={3} title="Funding awarded over time" data={fundingLine} unit={fundingDefinition?.unit ?? 'USD'} approval={recordBiSnapshot.approval.status} description={comparableCategory ? `Comparable ${comparableCategory} observations only.` : 'No comparable single-category series is available; no aggregate line is drawn.'} source={fundingLineSource} sourceHref={recordHref('/record/verify/')} /></div></div></div></div><div class="table-responsive border rounded-3 mt-4" tabindex="0" role="region" aria-label="Funding observations with exact period, source, and freshness state"><table class="table table-sm table-striped align-middle mb-0"><caption class="caption-top">Funding observations with exact period, source, and freshness state</caption><thead class="table-light"><tr><th scope="col">Category</th><th scope="col">Period</th><th scope="col">Value</th><th scope="col">Source</th><th scope="col">State</th></tr></thead><tbody>{fundingObservations.length === 0 ? <tr><th scope="row">Grants awarded</th><td>Not reported</td><td>Not reported</td><td>{fundingSource}</td><td><span class="badge text-bg-secondary">Not reported</span></td></tr> : fundingObservations.map((observation) => <tr><th scope="row">{observationDimensionsLabel(observation)}</th><td>{periodLabel(observation)}</td><td>{observation.value === null ? 'Not reported' : `${observation.value.toLocaleString('en-US')} ${observation.unit}`}</td><td>{observation.source.label} · retrieved {observation.source.retrievedAt}</td><td><span class:list={['badge', observation.value === null ? 'text-bg-secondary' : recordBiIsStale(observation) ? 'text-bg-warning' : 'text-bg-success']}>{observation.value === null ? 'Not reported' : recordBiIsStale(observation) ? 'Stale' : 'Current'}</span></td></tr>)}</tbody></table></div><p class="small text-body-secondary mt-3 mb-0">Snapshot approval: <strong>{recordBiApprovalLabel(recordBiSnapshot.approval.status)}</strong> · <strong>{recordBiApprovalBasisLabel(recordBiSnapshot.approval.basis)}</strong>. As of: <strong>{recordBiSnapshot.asOf ?? 'Not reported'}</strong>. {fundingDefinition?.exclusions}</p></section>

    <section class="mb-5" aria-labelledby="federal-evidence-title"><div class="d-flex flex-wrap justify-content-between gap-3 align-items-end mb-3"><div><p class="text-uppercase small fw-bold text-primary mb-2">Factual evidence taxonomy</p><h2 id="federal-evidence-title" class="mb-1">What each public route can establish</h2><p class="text-body-secondary mb-0">The limits are part of the data, so readers can distinguish a pathway from a credential.</p></div><a class="btn btn-outline-primary" href={recordHref('/record/verify/')}>Open source register <span aria-hidden="true">↗</span></a></div><div class="table-responsive border rounded-3 shadow-sm" tabindex="0" role="region" aria-label="Federal public evidence taxonomy and limits"><table class="table table-striped align-middle mb-0"><caption class="visually-hidden">Federal public evidence taxonomy and limits</caption><thead class="table-light"><tr><th scope="col">Evidence field</th><th scope="col">Public value</th><th scope="col">Source route</th><th scope="col">Limit</th></tr></thead><tbody>{evidenceRows.map((row) => <tr><th scope="row">{row.field}</th><td>{row.value}</td><td><a href={recordHref(row.href)}>{row.evidence} <span aria-hidden="true">↗</span></a></td><td>{row.limit}</td></tr>)}</tbody></table></div></section>

    <section class="mb-5" aria-labelledby="federal-flow-title"><div class="d-flex flex-wrap justify-content-between gap-3 align-items-end mb-3"><div><p class="text-uppercase small fw-bold text-primary mb-2">Engagement flow</p><h2 id="federal-flow-title" class="mb-1">From mission question to a human conversation</h2><p class="text-body-secondary mb-0">This linked sequence is copied from the existing program-officer journey record.</p></div><span class="badge text-bg-light border text-dark">Source-defined sequence</span></div><div class="card shadow-sm"><div class="card-body"><ol class="list-group list-group-numbered list-group-flush" aria-label="Federal program officer engagement flow">{programOfficer?.steps.map((step) => <li class="list-group-item d-flex align-items-start gap-3 px-0"><div><a class="fw-semibold" href={recordHref(step.href)}>{step.label} <span aria-hidden="true">↗</span></a><p class="small text-body-secondary mb-0">{step.href}</p></div></li>) ?? <li class="list-group-item px-0">No source-defined engagement sequence is available.</li>}<li class="list-group-item d-flex align-items-start gap-3 px-0"><div><a class="fw-semibold" href={recordHref('/contact-us/')}>Discuss a research requirement <span aria-hidden="true">→</span></a><p class="small text-body-secondary mb-0">Final action in the program-officer journey.</p></div></li></ol></div></div></section>

    <section aria-labelledby="federal-next-title"><div class="alert alert-warning mb-0" role="note"><h2 id="federal-next-title">For a live requirement</h2><p class="mb-0">Bring the mission, technical question, timeline, and expected evidence to the contact route. The record room is a map, not a procurement submission.</p></div></section>
  </div>
</RecordDocument>
