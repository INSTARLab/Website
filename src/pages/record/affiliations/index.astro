---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import { recordHref, recordRouteAtPath } from '../../../data/record';
import {
  affiliationRegisterRetrievedAt,
  recordConsortiumAffiliations,
  recordConsortiumClaim,
  recordNamedPeople,
  recordOwnerConfirmedAffiliationCount,
  registerStatusDefinition,
} from '../../../data/record-registers';

const route = recordRouteAtPath('/record/affiliations/');

const unconfirmedCount = recordConsortiumAffiliations.length - recordOwnerConfirmedAffiliationCount;
const affiliationBars = [
  { label: 'Owner confirmed', value: recordOwnerConfirmedAffiliationCount },
  { label: 'Named by the site, no source attached', value: unconfirmedCount },
];
const linkedCount = recordConsortiumAffiliations.filter((affiliation) => affiliation.outbound !== null).length;
---

<RecordDocument {route}>
  <section class="record-section container-fluid px-0" aria-labelledby="affiliations-brief-title">
    <div class="row align-items-end g-4 mb-4">
      <div class="col-lg-8">
        <p class="record-section__label mb-2">Affiliation worksheet</p>
        <h2 id="affiliations-brief-title">The register states the evidence, not the relationship.</h2>
        <p class="record-section__lede mb-0">This register carries every partner organization and every named person the public site presents, next to what establishes them. Nothing here removes a name or a mark: the homepage and the consortium route are unchanged, and that is deliberate. What changes is that a reader can now see which affiliations the institution has confirmed and which it has only published.</p>
      </div>
      <div class="col-lg-4">
        <div class="alert alert-info mb-0" role="note"><strong>Evidence rule.</strong> An “unverified” row does not say the affiliation is false. It says no source in this repository, and no external record this register cites, establishes it.</div>
      </div>
    </div>
    <div class="row g-3" aria-label="Affiliation register summary">
      <div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="record-kicker d-block mb-2">Affiliations carried</span><strong class="record-stat__value d-block">{recordConsortiumAffiliations.length}</strong><span class="record-stat__label">organizations named as consortium partners</span></div></article></div>
      <div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="record-kicker d-block mb-2">Owner confirmed</span><strong class="record-stat__value d-block">{recordOwnerConfirmedAffiliationCount}</strong><span class="record-stat__label">of those affiliations are confirmed by the institution&rsquo;s owner</span></div></article></div>
      <div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="record-kicker d-block mb-2">Named people</span><strong class="record-stat__value d-block">{recordNamedPeople.length}</strong><span class="record-stat__label">people presented on the homepage, none established by a repository source</span></div></article></div>
    </div>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="affiliations-network-title">
    <div class="row g-4 align-items-start">
      <div class="col-12 col-xl-7">
        <div class="card h-100"><div class="card-body p-3 p-xl-4">
          <p class="record-section__label mb-2">The claim</p>
          <h2 id="affiliations-network-title" class="mb-3">The consortium, as the site states it.</h2>
          <blockquote class="blockquote fs-6 mb-3">{recordConsortiumClaim.statement}</blockquote>
          <p class="mb-2">{recordConsortiumClaim.where}</p>
          <p class="mb-2">{recordConsortiumClaim.countEstablished}</p>
          <p class="small text-body-secondary mb-3">{recordConsortiumClaim.limits}</p>
          <p class="mb-0">Status: <span class:list={['badge', registerStatusDefinition(recordConsortiumClaim.status).className]}>{registerStatusDefinition(recordConsortiumClaim.status).label}</span></p>
        </div></div>
      </div>
      <div class="col-12 col-xl-5">
        <div class="card h-100"><div class="card-body p-3 p-xl-4">
          <BarChart
            level={3}
            id="affiliations-basis"
            title="Affiliations by what establishes them"
            items={affiliationBars}
            unit="affiliations"
            description="Derived from the register below. This is the whole finding of this page stated as a number: one affiliation is confirmed, and the rest are published without a source."
            source="Institutional registers (SRC-008)"
            sourceHref={recordHref('/record/verify/')}
          />
        </div></div>
      </div>
    </div>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="affiliations-register-title">
    <div class="row align-items-end g-4 mb-4">
      <div class="col-lg-8"><p class="record-section__label mb-2">Affiliation register</p><h2 id="affiliations-register-title">Each partner organization, and what is behind it.</h2></div>
      <div class="col-lg-4"><p class="small text-body-secondary mb-0">{linkedCount} of {recordConsortiumAffiliations.length} rows publish an outbound link, so the rest cannot be checked from this page at all. The mark&rsquo;s provenance is a separate question from the relationship and is recorded separately.</p></div>
    </div>
    <div class="table-responsive border rounded bg-white" tabindex="0" role="region" aria-label="Affiliation register with relationship, mark provenance, basis and limits">
      <table class="record-table table table-hover align-middle mb-0">
        <caption class="caption-top px-3 py-3">Partner organization, the published relationship, the basis, and the limit</caption>
        <thead class="table-light"><tr><th scope="col">Organization</th><th scope="col">Published relationship</th><th scope="col">Mark provenance</th><th scope="col">Basis</th><th scope="col">Status</th><th scope="col">Limit</th></tr></thead>
        <tbody>
          {recordConsortiumAffiliations.map((affiliation) => (
            <tr>
              <th scope="row">
                {affiliation.organization}
                {affiliation.outbound && <a class="record-link d-block small mt-1" href={affiliation.outbound} target="_blank" rel="noopener noreferrer" aria-label={`${affiliation.organization} public site (opens in a new tab)`}>Public site <span aria-hidden="true">↗</span></a>}
                <code class="d-block mt-2 text-break">{affiliation.markPath}</code>
              </th>
              <td>{affiliation.relationship}</td>
              <td class="small text-body-secondary">Media policy records this mark as {affiliation.markProvenance}.</td>
              <td>{affiliation.basis}</td>
              <td><span class:list={['badge', registerStatusDefinition(affiliation.status).className]}>{registerStatusDefinition(affiliation.status).label}</span></td>
              <td class="small text-body-secondary">{affiliation.limits}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="affiliations-people-title">
    <div class="row align-items-end g-4 mb-4">
      <div class="col-lg-8"><p class="record-section__label mb-2">Named people</p><h2 id="affiliations-people-title">The people the homepage presents.</h2><p class="record-section__lede mb-0">No repository source establishes any of these appointments. The register records the name and the role line as the site gives them, and it does not carry a credential the institution has not evidenced.</p></div>
      <div class="col-lg-4"><div class="alert alert-warning mb-0" role="note"><strong>Credential rule.</strong> One homepage entry is rendered with a doctoral honorific. Nothing in this repository establishes a doctorate, so the register does not carry the honorific and records it here as an unevidenced credential instead.</div></div>
    </div>
    <div class="table-responsive border rounded bg-white" tabindex="0" role="region" aria-label="Named people with the role as published, the basis and the limits">
      <table class="record-table table table-hover align-middle mb-0">
        <caption class="caption-top px-3 py-3">Person, the role line as published, the basis, and the limit</caption>
        <thead class="table-light"><tr><th scope="col">Person</th><th scope="col">Role as published</th><th scope="col">Basis</th><th scope="col">Status</th><th scope="col">Limit</th></tr></thead>
        <tbody>
          {recordNamedPeople.map((person) => (
            <tr>
              <th scope="row">{person.name}<code class="d-block mt-2 text-break">{person.portraitPath}</code></th>
              <td>{person.displayedRole}</td>
              <td>{person.basis}</td>
              <td><span class:list={['badge', registerStatusDefinition(person.status).className]}>{registerStatusDefinition(person.status).label}</span></td>
              <td class="small text-body-secondary">{person.limits}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small text-body-secondary mt-3 mb-0">Register checked {affiliationRegisterRetrievedAt}. Board appointments named here are also carried, with the seat count the state filing reports, in the <a href={recordHref('/record/governance/')}>governance register</a>.</p>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="affiliations-boundary-title">
    <div class="card border-warning"><div class="card-body p-3 p-xl-4">
      <p class="record-kicker mb-2">Publication boundary</p>
      <h2 id="affiliations-boundary-title" class="mb-3">This register does not change the homepage.</h2>
      <p>The partner names, marks and links on the consortium route and the homepage are public-facing branding and they are the owner&rsquo;s call. This register flags the state of the evidence behind them; it does not remove, rename, relink or reorder any of it.</p>
      <p class="mb-0">Where an affiliation is not established, the honest output is a row that says so — not a source invented to make the row look clean, and not a deletion that hides the question. Closing any of the rows above needs a partner-provided record or an owner confirmation, and either one is a change to the data, not to this page.</p>
    </div></div>
  </section>
</RecordDocument>
