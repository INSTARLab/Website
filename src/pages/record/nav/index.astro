---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import RouteDirectory from '../../../components/record/RouteDirectory.astro';
import InboundRanking from '../../../components/record/InboundRanking.astro';
import RouteFinder from '../../../components/record/RouteFinder.astro';
import RouteGraph from '../../../components/record/RouteGraph.astro';
import RoutePreview, { type PreviewEntry } from '../../../components/record/RoutePreview.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import { buildNavUniverse, inboundRanking, padNumber } from '../../../components/record/nav-graph.mjs';
import { recordHref, recordJourneys, recordRouteAtPath, recordVisuals, sitePageRecords } from '../../../data/record';

const route = recordRouteAtPath('/record/nav/');
const familyOrder = ['Home', 'Core', 'Research', 'Technology', 'Sciences', 'Community', 'Labs', 'Research brief', 'Fellowship', 'Tech transfer', 'Public record'];
const families = [...new Set(sitePageRecords.map((entry) => entry.family))].sort((left, right) => {
  const rank = (family: string) => { const index = familyOrder.findIndex((label) => label.toLowerCase() === family.toLowerCase()); return index < 0 ? familyOrder.length : index; };
  return rank(left) - rank(right) || left.localeCompare(right);
});
const familyCounts = families.map((family) => ({ family, count: sitePageRecords.filter((entry) => entry.family === family).length }));
const familyBars = familyCounts.map((entry) => ({ label: entry.family, value: entry.count }));
const routeKindLabel = (kind: (typeof sitePageRecords)[number]['kind']) => ({ core: 'Core', editorial: 'Editorial', section: 'Section', record: 'Record' })[kind];

// Visual sitemap derivations. The universe joins the route inventory with the
// journey-only stops the recorded paths traverse; the ranking, finder, graph,
// and preview all read this one derivation so they cannot disagree.
const universe = buildNavUniverse(sitePageRecords, recordJourneys);
const ranking = inboundRanking(universe);
const directoryEntries = families.flatMap((family) => sitePageRecords.filter((entry) => entry.family === family));
const directoryNumber = new Map(directoryEntries.map((entry, index) => [entry.path, padNumber(index + 1, directoryEntries.length)]));
const inventoryByPath = new Map(sitePageRecords.map((entry) => [entry.path, entry]));
const visualByHref = new Map(recordVisuals.map((visual) => [visual.href, visual]));
const previewEntries: PreviewEntry[] = universe.nodes.map((node) => {
  const inventory = inventoryByPath.get(node.path);
  const visual = visualByHref.get(node.path);
  return {
    path: node.path,
    number: directoryNumber.get(node.path) ?? '—',
    title: node.title,
    description: inventory?.description ?? `A recorded journey stop from ${node.journeys.join(', ') || 'the journey manifest'} — a real route with no inventory row.`,
    family: inventory?.family ?? null,
    kind: inventory?.kind ?? null,
    indexable: inventory?.indexable ?? null,
    journeys: node.journeys,
    visual: visual ? { src: visual.src, alt: visual.alt, width: visual.width, height: visual.height, caption: visual.caption, href: visual.href } : null,
  };
});
const previewByPath = new Map(previewEntries.map((entry) => [entry.path, entry]));
const defaultPreview = (ranking[0] ? previewByPath.get(ranking[0].path) : undefined) ?? previewEntries[0];
const finderOptions = [
  ...sitePageRecords.map((entry) => ({ path: entry.path, title: entry.title, family: entry.family, inInventory: true as const })),
  ...universe.nodes.filter((node) => !node.inInventory).map((node) => ({ path: node.path, title: node.title, family: null, inInventory: false as const })),
];
---

<RecordDocument {route}>
  <div class="container-fluid px-0">
    <section class="record-section mt-5" aria-labelledby="nav-distribution-title">
      <div class="row g-4">
        <div class="col-12 col-xl-7">
          <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
              {/* RR-301 SF-3. The section heading and the chart title both read
                * "Routes by family", so the page rendered the same `<h2>` text
                * twice in a row. The section heading now names the section
                * (matching the prose headings on /record/metrics/) and the
                * chart keeps the title its table caption and CSV filename are
                * built from. */}
              <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3"><div><p class="record-section__label mb-2">Distribution</p><h2 id="nav-distribution-title" class="mb-0">How the public route graph is distributed</h2></div><span class="badge text-bg-light">{sitePageRecords.length} routes</span></div>
              <BarChart level={3} title="Routes by family" items={familyBars} description="Each bar is a count of source-derived routes." source="Route manifests (SRC-002)" sourceHref={recordHref('/record/verify/')} />
              <a class="small" href={recordHref('/record/metrics/')}>Compare the inventory measures.</a>
            </div>
          </div>
        </div>
        <div class="col-12 col-xl-5">
          <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
              <p class="record-section__label mb-2">Legend</p>
              <h2 class="mb-3">Route kinds</h2>
              <dl class="row gy-3 mb-0 small">
                <dt class="col-4">Core</dt><dd class="col-8 mb-0">Primary site pages from the core route manifest.</dd>
                <dt class="col-4">Editorial</dt><dd class="col-8 mb-0">Article and publication routes.</dd>
                <dt class="col-4">Section</dt><dd class="col-8 mb-0">Family index routes representing a larger area.</dd>
                <dt class="col-4">Record</dt><dd class="col-8 mb-0">Pages in this public record room.</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="record-section mt-5" aria-labelledby="nav-directory-title">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <div><p class="record-section__label mb-2">Visual sitemap</p><h2 id="nav-directory-title" class="mb-0">Browse every route, then inspect one</h2></div>
        <p class="small text-body-secondary mb-0">Directory order matches the inventory table below.</p>
      </div>
      <div class="row g-4 align-items-start">
        <div class="col-12 col-xl-7">
          <RouteDirectory entries={directoryEntries} currentPath={route.path} level={3} />
        </div>
        <div class="col-12 col-xl-5">
          {defaultPreview && <RoutePreview current={defaultPreview} routes={previewEntries} level={3} />}
        </div>
      </div>
    </section>

    <section class="record-section mt-5" aria-labelledby="nav-flow-title">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <div><p class="record-section__label mb-2">Flow</p><h2 id="nav-flow-title" class="mb-0">Where journeys concentrate, and how to cross them</h2></div>
      </div>
      <div class="row g-4 align-items-start">
        <div class="col-12 col-xl-5">
          <InboundRanking rows={ranking} level={3} />
        </div>
        <div class="col-12 col-xl-7">
          <RouteFinder
            options={finderOptions}
            journeys={recordJourneys.map((journey) => ({ id: journey.id, label: journey.label }))}
            contentEdges={universe.contentEdges}
            weakEdges={universe.weakEdges}
            level={3}
          />
        </div>
      </div>
    </section>

    <section class="record-section mt-5" aria-labelledby="nav-topology-title">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        {/*
          RRP-204 (#29): this section heading must not repeat the RouteGraph
          card title ("Recorded link topology") rendered below — the
          navigable-outline gate fails pages that reuse a heading name. The
          section keeps its generic name and stable id; the card keeps the
          specific title. Touch only this line without coordinating with the
          topology lane: the two names must stay distinct.
        */}
        <div><p class="record-section__label mb-2">Topology</p><h2 id="nav-topology-title" class="visually-hidden">Topology</h2></div>
      </div>
      <RouteGraph
        nodes={universe.nodes}
        contentEdges={universe.contentEdges}
        weakEdges={universe.weakEdges}
        journeyCount={recordJourneys.length}
        level={3}
      />
    </section>

    <section class="record-section mt-5" aria-labelledby="nav-table-title">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div><p class="record-section__label mb-2">Searchable inventory</p><h2 id="nav-table-title" class="mb-0">Find a route</h2></div>
            <p class="small text-body-secondary mb-0" data-route-count role="status" aria-live="polite">{sitePageRecords.length} routes</p>
          </div>
          <form class="row g-3 align-items-end mb-4" role="search" onsubmit="return false">
            <div class="col-12 col-lg-7"><label class="form-label" for="record-route-filter">Search by path, title, family, or description</label><input id="record-route-filter" class="form-control" type="search" placeholder="Try research, fellowship, news…" autocomplete="off" data-route-filter /></div>
            <div class="col-12 col-lg-5"><label class="form-label" for="record-family-filter">Filter by family</label><select id="record-family-filter" class="form-select" data-family-filter><option value="">All families</option>{families.map((family) => <option value={family}>{family}</option>)}</select></div>
          </form>
          <div class="table-responsive" tabindex="0" role="region" aria-label="Complete public route inventory">
            <table class="table table-hover align-middle mb-0">
              <caption class="visually-hidden">Complete public route inventory</caption>
              <thead><tr><th scope="col">Route</th><th scope="col">Family</th><th scope="col">Kind</th><th scope="col">Indexability</th><th scope="col">Description</th></tr></thead>
              <tbody data-route-list>
                {families.flatMap((family) => sitePageRecords.filter((entry) => entry.family === family).map((entry) => (
                  <tr data-route-item data-family={entry.family} data-search-text={`${entry.path} ${entry.title} ${entry.family} ${entry.description}`}>
                    <th scope="row"><a href={recordHref(entry.path)}>{entry.title}</a><code class="d-block small text-body-secondary mt-1">{entry.path}</code></th>
                    <td>{entry.family}</td>
                    <td>{routeKindLabel(entry.kind)}</td>
                    <td><span class:list={['badge', entry.indexable ? 'text-bg-success' : 'text-bg-secondary']}>{entry.indexable ? 'Indexable' : 'Noindex'}</span></td>
                    <td class="small text-body-secondary">{entry.description}</td>
                  </tr>
                )))}
              </tbody>
            </table>
          </div>
          <p class="small text-body-secondary mt-3 mb-0">Search is an enhancement. The HTML table above contains the complete list at build time.</p>
        </div>
      </div>
    </section>
  </div>
</RecordDocument>

<style>
  /* Maximized preview becomes a focused overlay. Instant state change only —
   * no transition, so there is nothing to gate under prefers-reduced-motion. */
  :global(.record-preview--max) {
    position: fixed;
    inset: 1rem;
    z-index: 1050;
    overflow-y: auto;
    background: var(--bs-body-bg, #fff);
  }
  /* Topology focus-dim. Decorative edges stay faint; dimmed nodes fade. */
  :global([data-route-graph] .is-dim) {
    opacity: 0.25;
  }
  :global([data-graph-svg] a:focus-visible) {
    outline: 2px solid #14627d;
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-route-graph] *) {
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  const filter = document.querySelector<HTMLInputElement>('[data-route-filter]');
  const familyFilter = document.querySelector<HTMLSelectElement>('[data-family-filter]');
  const items = [...document.querySelectorAll<HTMLTableRowElement>('[data-route-item]')];
  const count = document.querySelector<HTMLElement>('[data-route-count]');

  const updateRouteList = () => {
    const query = filter?.value.trim().toLowerCase() ?? '';
    const family = familyFilter?.value ?? '';
    let visible = 0;
    items.forEach((item) => {
      const matchesQuery = !query || item.dataset.searchText?.toLowerCase().includes(query);
      const matchesFamily = !family || item.dataset.family === family;
      const matches = Boolean(matchesQuery && matchesFamily);
      item.hidden = !matches;
      if (matches) visible += 1;
    });
    if (count) count.textContent = `${visible} route${visible === 1 ? '' : 's'}`;
  };

  filter?.addEventListener('input', updateRouteList);
  familyFilter?.addEventListener('change', updateRouteList);
</script>

<script>
  import '../../../components/record/route-preview';
  import '../../../components/record/route-graph';
  import '../../../components/record/route-path';
</script>
