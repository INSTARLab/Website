---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import FlowDiagram from '../../../components/record/viz/FlowDiagram.astro';
import Timeline from '../../../components/record/viz/Timeline.astro';
import { recordHref, recordRouteAtPath } from '../../../data/record';
import {
  correctionCommitLocator,
  correctionMirrorRepository,
  recordCorrectionCount,
  recordCorrections,
} from '../../../data/record-registers';

const route = recordRouteAtPath('/record/corrections/');

const monthLabel = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const byMonth = new Map<string, number>();
for (const correction of recordCorrections) {
  const key = correction.correctedAt.slice(0, 7);
  byMonth.set(key, (byMonth.get(key) ?? 0) + 1);
}
const monthBars = [...byMonth.entries()]
  .sort(([left], [right]) => left.localeCompare(right))
  .map(([key, value]) => ({ label: monthLabel(`${key}-01`), value }));

const commitCount = recordCorrections.reduce((total, correction) => total + correction.commits.length, 0);
const withheldCount = recordCorrections.filter((correction) => correction.withholdsRetractedIdentifiers).length;
const pendingMirrorCount = recordCorrections
  .flatMap((correction) => correction.commits)
  .filter((commit) => correctionCommitLocator(commit) === null).length;

// The register's only true event series: each span runs from the date the
// defective claim went out to the date the correcting commit landed. COR-006
// carries `publishedAt: null` because the repository does not establish it,
// and the timeline prints that absence in words rather than guessing a date.
// Commit SHAs stay in the register cards below as prose and links only — the
// timeline carries no SHA, so none can leak into structured data.
const correctionEvents = recordCorrections.map((correction) => ({
  id: correction.id,
  label: correction.subject,
  from: correction.publishedAt,
  to: correction.correctedAt,
  href: `#correction-${correction.id}`,
  limits: correction.withholdsRetractedIdentifiers
    ? 'The values retracted in this entry are described, not reproduced: the commit citation in the register entry below is the locator instead.'
    : undefined,
}));

// The register's method, stated as a sequence rather than as a paragraph, so a
// reader can see that the citation is produced by the process and not chosen
// afterwards to flatter it.
const methodSteps = [
  { label: 'A claim is published', description: 'Copy, a route description, a structured-data field, or an asset goes out on the site.' },
  { label: 'A defect is found', description: 'Someone contradicts it: a source, the owner, an external record, or a later test that the claim cannot pass.' },
  { label: 'A correction lands as a commit', description: 'The fix is a commit with a message that states what was wrong. The commit is the artifact; it is not edited afterwards.' },
  { label: 'The register cites the commit', description: 'The entry names the SHA so a reader can read the edit for themselves, rather than trusting this page’s summary of it.' },
];
---

<RecordDocument {route}>
  <section class="record-section container-fluid px-0" aria-labelledby="corrections-brief-title">
    <div class="row align-items-end g-4 mb-4">
      <div class="col-lg-8">
        <p class="record-section__label mb-2">Corrections worksheet</p>
        <h2 id="corrections-brief-title">A withdrawn claim is part of the record too.</h2>
        <p class="record-section__lede mb-0">Every entry below is a claim this site published and then corrected. Each one states what went out, what was wrong with it, what the site says now, when the correction landed, and the commit that landed it — so a reader can check the correction instead of taking this page&rsquo;s word for it.</p>
      </div>
      <div class="col-lg-4">
        <div class="alert alert-info mb-0" role="note"><strong>Reading rule.</strong> An entry here is not a statement that the site is now correct. It is a statement that this particular claim was wrong and what replaced it.</div>
      </div>
    </div>
    <div class="row g-3" aria-label="Corrections register summary">
      <div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="record-kicker d-block mb-2">Corrections recorded</span><strong class="record-stat__value d-block">{recordCorrectionCount}</strong><span class="record-stat__label">claims published and then corrected</span></div></article></div>
      <div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="record-kicker d-block mb-2">Commits cited</span><strong class="record-stat__value d-block">{commitCount}</strong><span class="record-stat__label">commits, cited by SHA, that introduce or correct a claim</span></div></article></div>
      <div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="record-kicker d-block mb-2">Identifier entries withheld</span><strong class="record-stat__value d-block">{withheldCount}</strong><span class="record-stat__label">entries whose retracted values this register deliberately does not reproduce</span></div></article></div>
    </div>
    {/*
      Self-verifiability note (gh#360): more commits than claims is expected,
      because one claim can take several commits to introduce and correct.
      The spans below are derived from the register above, not written by
      hand, so they cannot drift from it.
    */}
    <p class="small text-body-secondary mt-3 mb-0">{recordCorrectionCount} claims cite {commitCount} commits: {recordCorrections.map((correction) => `${correction.id} spans ${correction.commits.length}`).join(', ')}.</p>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="corrections-method-title">
    <div class="row g-4 align-items-start">
      <div class="col-12 col-xl-7">
        <div class="card h-100"><div class="card-body p-3 p-xl-4">
          <FlowDiagram
            level={3}
            id="corrections-method"
            title="How a correction gets into this register"
            steps={methodSteps}
            description="The register is downstream of the fix. Nothing is listed here that did not land as a commit."
            source="Institutional registers (SRC-008)"
            sourceHref={recordHref('/record/verify/')}
          />
        </div></div>
      </div>
      <div class="col-12 col-xl-5">
        <div class="card h-100"><div class="card-body p-3 p-xl-4">
          <BarChart
            level={3}
            id="corrections-by-month"
            title="Corrections by the month they landed"
            items={monthBars}
            unit="corrections"
            description="Derived from the register below, by the date of the correcting commit. A month with no corrections is not drawn, because this chart measures the register rather than the site’s accuracy."
            source="Institutional registers (SRC-008)"
            sourceHref={recordHref('/record/verify/')}
          />
        </div></div>
      </div>
    </div>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="corrections-chronology-title">
    <div class="row align-items-end g-4 mb-4">
      <div class="col-lg-8"><p class="record-section__label mb-2">Chronology</p><h2 id="corrections-chronology-title">When each defective claim went out, and when its fix landed.</h2><p class="record-section__lede mb-0">The bars above count corrections by month; the timeline below orders them as dated events. Each span runs from publication to correction, and each label links to its register entry.</p></div>
    </div>
    <div class="card shadow-sm"><div class="card-body p-3 p-xl-4">
      <Timeline
        level={3}
        id="corrections-chronology"
        kicker="Dated events"
        title="Corrections from publication to fix"
        events={correctionEvents}
        description="Dates are commit-evidenced. Where the repository does not establish when a claim went out, the span says so instead of dating it."
        source="Institutional registers (SRC-008)"
        sourceHref={recordHref('/record/verify/')}
      />
    </div></div>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="corrections-register-title">
    <div class="row align-items-end g-4 mb-4">
      <div class="col-lg-8"><p class="record-section__label mb-2">The register</p><h2 id="corrections-register-title">What went out, what was wrong, and what replaced it.</h2></div>
      <div class="col-lg-4"><p class="small text-body-secondary mb-0">Newest correction first. The commit citations are prose and links only: they are kept out of the structured data this site emits, and a build-time check enforces that.</p></div>
    </div>

    {recordCorrections.map((correction) => (
      <article class="card shadow-sm mb-4" id={`correction-${correction.id}`}>
        <div class="card-body p-3 p-xl-4">
          <p class="record-kicker mb-2">{correction.id} · corrected {correction.correctedAt}{correction.publishedAt ? ` · published ${correction.publishedAt}` : ' · date published not established'}</p>
          {/*
            The register heading carries the correction id because the
            chronology timeline below renders each entry subject as its own
            event heading: a bare subject would name two headings on this
            page and fail the navigable-outline gate. The id prefix keeps
            every heading unique while the timeline keeps its short labels.
          */}
          <h3 class="mb-3">{correction.id} · {correction.subject}</h3>
          <div class="table-responsive border rounded" tabindex="0" role="region" aria-label={`${correction.id} correction detail`}>
            <table class="record-table table align-middle mb-0">
              <caption class="caption-top px-3 py-3">{correction.id}: what was published, the defect, the correction, and its scope</caption>
              <tbody>
                <tr><th scope="row" class="w-25">What was published</th><td>{correction.published}</td></tr>
                <tr><th scope="row">What was wrong</th><td>{correction.defect}</td></tr>
                <tr><th scope="row">What the site says now</th><td>{correction.correction}</td></tr>
                <tr><th scope="row">How far it spread</th><td>{correction.scope}</td></tr>
                <tr>
                  <th scope="row">Commits</th>
                  <td>
                    <ul class="list-unstyled mb-0">
                      {correction.commits.map((commit) => {
                        const locator = correctionCommitLocator(commit);
                        return (
                          <li class="mb-2">
                            {locator
                              ? <a class="record-link" href={locator} target="_blank" rel="noopener noreferrer" aria-label={`Commit ${commit.sha.slice(0, 7)} in the public source repository (opens in a new tab)`}><code>{commit.sha}</code> <span aria-hidden="true">↗</span></a>
                              : <code>{commit.sha}</code>}
                            <span class="d-block small text-body-secondary">{commit.committedAt} · {commit.summary}{locator === null && ' Not yet on the public mirror: the promotion step has not carried this commit yet, so it is cited by SHA rather than linked.'}</span>
                          </li>
                        );
                      })}
                    </ul>
                  </td>
                </tr>
                {correction.withholdsRetractedIdentifiers && (
                  <tr>
                    <th scope="row">Deliberately withheld</th>
                    <td>The values retracted in this entry are not reproduced anywhere on this page, in any meta tag, in any sitemap, or in the structured data this site emits. A build-time check fails the deploy if they appear. The citation above is the locator instead.</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="record-section container-fluid px-0" aria-labelledby="corrections-locator-title">
    <div class="row g-4 align-items-start">
      <div class="col-12 col-xl-7">
        <div class="card h-100 border-primary-subtle bg-primary-subtle"><div class="card-body p-3 p-xl-4">
          <p class="record-section__label mb-2">Locator convention</p>
          <h2 id="corrections-locator-title" class="mb-3">Cite the commit. Do not republish the identifier.</h2>
          <p>Where a retracted claim included a fabricated federal identifier, this register cites the commit and does not write the value. The reason is not delicacy: every route on this site emits JSON-LD, so writing an invented federal identifier into a page would put it into machine-readable output on the organization&rsquo;s own domain, where a crawler or a data aggregator would read it as a fact about the organization.</p>
          <p class="mb-0">The commit page is a record of an edit. It is a strictly better place for that string to sit, and it is where the citation points. {pendingMirrorCount} of the {commitCount} commits cited above are not on the public mirror yet, because the promotion step has not carried them; those entries cite the SHA as text rather than linking to a page that would not resolve.</p>
        </div></div>
      </div>
      <div class="col-12 col-xl-5">
        <div class="card h-100 border-warning"><div class="card-body p-3 p-xl-4">
          <p class="record-kicker mb-2">Correction path</p>
          <h2 class="mb-3">Something here is still wrong.</h2>
          <p>If a claim on this site is inaccurate, or an entry in this register is incomplete, that is the thing this room most wants to hear about. Send the URL and what contradicts it.</p>
          <p class="mb-3">Corrections land as commits, and they are recorded here the same way every entry above was.</p>
          <a class="record-link" href={recordHref('/contact-us/')}>Contact INSTAR Lab <span aria-hidden="true">→</span></a>
        </div></div>
      </div>
    </div>
    <p class="small text-body-secondary mt-3 mb-0">Commit citations resolve in the public source repository at <a class="record-link" href={correctionMirrorRepository} target="_blank" rel="noopener noreferrer" aria-label="INSTARLab/Website public source repository (opens in a new tab)">{correctionMirrorRepository} <span aria-hidden="true">↗</span></a>. See also the <a href={recordHref('/record/legal/')}>legal status register</a> for the classification correction&rsquo;s subject matter, and the <a href={recordHref('/record/verify/')}>source register</a> for what the repository can and cannot establish.</p>
  </section>
</RecordDocument>
