---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import { recordExternalSources, recordHref, recordRouteAtPath, recordSourceRegister } from '../../../data/record';

const route = recordRouteAtPath('/record/verify/');
const sourceStatusDefinitions = [
  { key: 'verified-in-repository', label: 'Verified in repository', description: 'Present in the current checked-out source and used by the build.', action: 'Use within its stated scope.', className: 'text-bg-success' },
  { key: 'review-required', label: 'Review required', description: 'Present, but an external status, filename, rights, or provenance field needs human review.', action: 'Do not promote it into a stronger claim.', className: 'text-bg-warning' },
  { key: 'not-public', label: 'Not public', description: 'Referenced as a separate source corpus but not published by this route.', action: 'Keep unpublished material out of public copy.', className: 'text-bg-secondary' },
] as const;
const sourceStatusCounts = sourceStatusDefinitions.map((definition) => ({ ...definition, count: recordSourceRegister.filter((source) => source.status === definition.key).length }));
const sourceTotal = recordSourceRegister.length;
const sourcesWithRecordedVerificationDate = 0;
const sourceDateMessage = sourcesWithRecordedVerificationDate === 0 ? 'No verification dates are recorded in the current register.' : `${sourcesWithRecordedVerificationDate} of ${sourceTotal} sources have a recorded verification date.`;
const sourceStatusBars = sourceStatusCounts.map((status) => ({ label: status.label, value: status.count }));
---

<RecordDocument {route}>
  <section class="record-section container-fluid px-0" aria-labelledby="verify-brief-title">
    <div class="row align-items-end g-4 mb-4">
      <div class="col-lg-8"><p class="record-section__label mb-2">Verification worksheet</p><h2 id="verify-brief-title">Every useful fact needs a boundary.</h2><p class="record-section__lede mb-0">This register shows where the record room gets its information and where the repository stops being enough. “Verified in repository” means the field is present in current source; it does not mean a separate external audit has been performed.</p></div>
      <div class="col-lg-4"><div class="card border-0 bg-body-tertiary h-100"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Snapshot state</p><p class="h3 mb-1">{sourceTotal} sources</p><p class="small text-body-secondary mb-0">{sourceDateMessage}</p></div></div></div>
    </div>
    <div class="row g-3 mb-4" aria-label="Source status totals">
      {sourceStatusCounts.map((status) => <div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class:list={['badge', status.className]}>{status.label}</span><strong class="record-stat__value d-block mt-3">{status.count}</strong><span class="record-stat__label">of {sourceTotal} register entries</span></div></article></div>)}
    </div>
    <div class="row g-4 align-items-start">
      <div class="col-12 col-xl-7"><article class="card h-100"><div class="card-body p-3 p-xl-4"><BarChart level={3} id="verify-source-status" title="What the register can establish" items={sourceStatusBars} unit="source records" description="Counts are derived directly from the source register. They describe repository status, not external verification." source={`Source register (${recordSourceRegister[0].id}–${recordSourceRegister.at(-1)?.id})`} sourceHref={recordHref('/record/verify/')} /></div></article></div>
      <div class="col-12 col-xl-5"><article class="card h-100 border-warning"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Freshness check</p><h3>Date coverage is separate from status.</h3><p class="mb-3">The current source records contain no verified-at field. A repository status therefore cannot be read as a freshness guarantee.</p><div class="alert alert-warning mb-0" role="status"><strong>{sourcesWithRecordedVerificationDate} / {sourceTotal}</strong> verification dates recorded</div></div></article></div>
    </div>
  </section>
  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="verify-register-title">
    <div class="row align-items-end g-4 mb-4"><div class="col-lg-8"><p class="record-section__label mb-2">Source register</p><h2 id="verify-register-title">What each source can establish.</h2></div><div class="col-lg-4"><p class="small text-body-secondary mb-0">The “limits” field travels with every source so a reader can see the boundary at the point of use. The repository paths in the locator column are deliberate audit locators, code-styled so they read as paths rather than prose; anything a reader opens directly is listed with its served URL under <a class="record-link" href={recordHref('/record/files/')}>record files</a>.</p></div></div>
    <div class="table-responsive border rounded bg-white" tabindex="0" role="region" aria-label="Source status definitions and register entries"><table class="record-table table table-hover align-middle mb-0"><caption class="caption-top px-3 py-3">Source status, locator, evidence supported, and known limits</caption><thead class="table-light"><tr><th scope="col">ID / status</th><th scope="col">Source and locator</th><th scope="col">Supports</th><th scope="col">Limit</th></tr></thead><tbody>{recordSourceRegister.map((source) => <tr id={source.id.toLowerCase()}><th scope="row"><span class="font-monospace d-block mb-2">{source.id}</span><span class:list={['badge', source.status === 'verified-in-repository' ? 'text-bg-success' : source.status === 'review-required' ? 'text-bg-warning' : 'text-bg-secondary']}>{sourceStatusDefinitions.find((status) => status.key === source.status)?.label}</span></th><td><strong>{source.label}</strong><code class="d-block mt-2 text-break">{source.locator}</code><span class="small text-body-secondary d-block mt-2">Verification date: not recorded</span></td><td>{source.supports}</td><td>{source.limits}</td></tr>)}</tbody></table></div>
  </section>
  {/* External records about the institution. The operational measures elsewhere
    * in the room publish only what an approver inside INSTAR Lab has signed;
    * where a figure exists only in a government filing, the room points at the
    * filing instead of restating the number as its own measure. Every figure is
    * attributed to the publisher that states it, and the page it lives on can
    * change without notice, so the boundary travels with the link. */}
  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="verify-external-title">
    <div class="row align-items-end g-4 mb-4">
      <div class="col-lg-8"><p class="record-section__label mb-2">External authoritative sources</p><h2 id="verify-external-title">Figures about the institution that the institution does not publish itself.</h2><p class="record-section__lede mb-0">These are third-party records. The operational measures in this room publish only what an approver inside INSTAR Lab has signed, and everything else stays “Not reported” rather than being filled in from here. Where a filing does publish a figure, this register names the publisher, states the figures it carries, and keeps the limitation next to them.</p></div>
      <div class="col-lg-4"><div class="card border-0 bg-body-tertiary h-100"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Last retrieved</p><p class="h3 mb-1">{recordExternalSources.length} external records</p><p class="small text-body-secondary mb-0">Link-checked on {recordExternalSources[0].retrievedAt}. These pages are maintained outside this site.</p></div></div></div>
    </div>
    <div class="table-responsive border rounded bg-white" tabindex="0" role="region" aria-label="External authoritative sources, what they publish, and their limits">
      <table class="record-table table table-hover align-middle mb-0">
        <caption class="caption-top px-3 py-3">External record, what it publishes, and what it cannot establish</caption>
        <thead class="table-light"><tr><th scope="col">Source</th><th scope="col">What it publishes</th><th scope="col">Boundary</th></tr></thead>
        <tbody>
          {recordExternalSources.map((external) => (
            <tr id={external.id.toLowerCase()}>
              <th scope="row">
                <span class="font-monospace d-block mb-2">{external.id}</span>
                <a class="record-link" href={external.locator} target="_blank" rel="noopener noreferrer" aria-label={`${external.label} at ${external.publisher} (opens in a new tab)`}>{external.label} <span aria-hidden="true">↗</span></a>
                <span class="small text-body-secondary d-block mt-2">{external.publisher}</span>
                <code class="d-block mt-2 text-break">{external.locator}</code>
                {external.fallback && (
                  <span class="small text-body-secondary d-block mt-2">If this record link moves, search the register: <a class="record-link" href={external.fallback.locator} target="_blank" rel="noopener noreferrer" aria-label={`${external.fallback.label} (opens in a new tab)`}>{external.fallback.label} <span aria-hidden="true">↗</span></a></span>
                )}
              </th>
              <td>{external.publishes}{external.note && <span class="d-block mt-2">{external.note}</span>}</td>
              <td class="small text-body-secondary">{external.limits}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="verify-correction-title"><div class="alert alert-info border-start border-4 border-primary mb-0" role="note"><h3 id="verify-correction-title">Correction path</h3><p class="mb-2">If a source, route, or public claim is outdated, contact INSTAR Lab with the URL and correction context. The record room keeps repository status and external review as separate steps.</p><a class="record-link" href={recordHref('/contact-us/')}>Contact INSTAR Lab <span aria-hidden="true">→</span></a></div></section>
</RecordDocument>
