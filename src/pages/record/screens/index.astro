---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import { recordHref, recordRouteAtPath, recordVisuals } from '../../../data/record';

const route = recordRouteAtPath('/record/screens/');
const mediaRoles = [...new Set(recordVisuals.map((visual) => visual.mediaRole))];
const roleCounts = mediaRoles.map((role) => ({ role, count: recordVisuals.filter((visual) => visual.mediaRole === role).length }));
const provenanceState = (license: string) => license.toLowerCase().includes('unverified') ? 'Unverified / review required' : 'License text recorded';
const provenanceCounts = [...new Set(recordVisuals.map((visual) => provenanceState(visual.license)))].map((state) => ({ state, count: recordVisuals.filter((visual) => provenanceState(visual.license) === state).length }));
const aspectLabel = (width: number, height: number) => `${(width / height).toFixed(2)}:1`;
const frameClass = (width: number, height: number) => width / height >= 2.2 ? 'Wide' : width / height >= 1.45 ? 'Landscape' : 'Portrait / square';
const totalVisuals = recordVisuals.length;
const roleBars = roleCounts.map((entry) => ({ label: entry.role, value: entry.count }));
---

<RecordDocument {route}>
  <section class="record-section container-fluid px-0" aria-labelledby="screens-brief-title">
    <div class="row align-items-end g-4 mb-4"><div class="col-lg-8"><p class="record-section__label mb-2">Source media archive</p><h2 id="screens-brief-title">Inspect the media where the route uses it.</h2><p class="record-section__lede mb-0">This archive shows representative source visuals from the current public AVIF library and links each one to its canonical route. These are media assets, not browser screenshot captures.</p></div><div class="col-lg-4"><div class="card border-0 bg-body-tertiary h-100"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Archive total</p><p class="h3 mb-1">{totalVisuals} source visuals</p><p class="small text-body-secondary mb-0">Dimensions and roles are copied from the current media record.</p></div></div></div></div>
    <div class="row g-3 mb-4" aria-label="Media archive totals"><div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="badge text-bg-primary">Media roles</span><strong class="record-stat__value d-block mt-3">{mediaRoles.length}</strong><span class="record-stat__label">role values recorded</span></div></article></div><div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="badge text-bg-warning">Provenance review</span><strong class="record-stat__value d-block mt-3">{provenanceCounts.find((entry) => entry.state.startsWith('Unverified'))?.count ?? 0}</strong><span class="record-stat__label">assets with unverified license text</span></div></article></div><div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="badge text-bg-light border">Canonical links</span><strong class="record-stat__value d-block mt-3">{recordVisuals.filter((visual) => Boolean(visual.href)).length}</strong><span class="record-stat__label">source routes linked</span></div></article></div></div>
    <div class="row g-4 align-items-start"><div class="col-12 col-xl-7"><article class="card h-100"><div class="card-body p-3 p-xl-4"><BarChart level={3} id="screens-media-role-profile" title="How the source library is classified" items={roleBars} unit="source visuals" description="Roles use the public media policy where available; record-reference identifies archive reuse where no matching policy exists. Roles do not establish ownership." source="Public media policy and record visual register" sourceHref={recordHref('/record/verify/')} /></div></article></div><div class="col-12 col-xl-5"><article class="card h-100"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Provenance queue</p><h3 class="mb-3">License text remains distinct from use.</h3><ul class="list-group list-group-flush">{provenanceCounts.map((entry) => <li class="list-group-item d-flex justify-content-between gap-3 px-0"><span>{entry.state}</span><strong>{entry.count}</strong></li>)}</ul><p class="small text-body-secondary mt-3 mb-0">The current visual records explicitly mark unverified licenses. No ownership or license is inferred from the image being present in the repository.</p></div></article></div></div>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="screens-gallery-title"><div class="row align-items-end g-4 mb-4"><div class="col-lg-8"><p class="record-section__label mb-2">Aligned gallery</p><h2 id="screens-gallery-title">Role, frame, and source travel with every image.</h2></div><div class="col-lg-4"><p class="small text-body-secondary mb-0">Each card preserves the dimensions, data attributes, source, license text, and route link recorded for the asset.</p></div></div><div class="row g-4">{recordVisuals.map((visual) => <div class="col-12 col-md-6 col-xxl-4"><figure class="record-visual card h-100 mb-0" id={visual.id}><a class="text-decoration-none" href={recordHref(visual.href)}><img class="card-img-top" src={recordHref(visual.src)} alt={visual.alt} width={visual.width} height={visual.height} loading="lazy" data-media-id={visual.mediaId} data-media-role={visual.mediaRole} data-source={visual.source} data-license={visual.license} data-reuse-reason={visual.reuseReason} /></a><figcaption class="card-body p-3"><div class="d-flex justify-content-between gap-2 small text-body-secondary mb-2"><span>{visual.mediaRole}</span><span>{frameClass(visual.width, visual.height)} · {aspectLabel(visual.width, visual.height)}</span></div><h3>{visual.title}</h3><p class="small mb-2">{visual.caption}</p><dl class="row small mb-3"><dt class="col-5 text-body-secondary">Source</dt><dd class="col-7 text-break">{visual.source}</dd><dt class="col-5 text-body-secondary">License</dt><dd class="col-7">{provenanceState(visual.license)}</dd></dl><a class="record-link" href={recordHref(visual.href)}>Open canonical route <span aria-hidden="true">↗</span></a></figcaption></figure></div>)}</div></section>
  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="screens-policy-title"><div class="alert alert-info border-start border-4 border-primary mb-0"><h3 id="screens-policy-title">Media policy</h3><p class="mb-2">Each public media policy entry carries an asset role, dimensions, loading behavior, alt decision, focal point, and provenance object. Many source or license fields remain review-required; see the verification register.</p><a class="record-link" href={recordHref('/record/verify/')}>Open source register <span aria-hidden="true">→</span></a></div></section>
</RecordDocument>
