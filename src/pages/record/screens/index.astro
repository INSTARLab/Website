---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import { recordCaptures, recordHref, recordRouteAtPath } from '../../../data/record';

const route = recordRouteAtPath('/record/screens/');
const generation = recordCaptures;
const entries = [...generation.routes].sort((left, right) => left.routeId.localeCompare(right.routeId));
const hasGeneration = generation.generationId !== 'pending-no-captures' && entries.length > 0;
const viewports = generation.captureTool.viewports;
const successEntries = entries.filter((entry) => entry.status === 'success');
const failedEntries = entries.filter((entry) => entry.status === 'failed');
const staleEntries = entries.filter((entry) => entry.status !== 'success' && entry.status !== 'failed');
const statusBars = [
  { label: 'Current captures', value: successEntries.length },
  { label: 'Failed captures', value: failedEntries.length },
  { label: 'Stale captures', value: staleEntries.length },
];
const generationShort = generation.generationId === 'pending-no-captures' ? 'pending' : generation.generationId.slice(0, 12);
const statusLabel = (status: string) => status === 'success' ? 'Current' : status === 'failed' ? 'Failed' : 'Stale';
const slugFor = (routeId: string) => routeId === '/' ? 'home' : routeId === '/404.html' ? '404' : routeId.replace(/^\/|\/$/g, '').replaceAll('/', '-').toLowerCase();
const captureSource = (routeId: string, contentHash: string) => `Automated browser capture of ${routeId} from frozen build ${contentHash.slice(0, 12)}`;
---

<RecordDocument {route}>
  <style>
    /* Thumbnails are bounded top-of-page previews: full-page captures run far
       taller than any card, so the frame is fixed and the exact decoded
       dimensions travel in the caption and segment links beneath each one. */
    .record-visual__thumb {
      aspect-ratio: 16 / 10;
      width: 100%;
      height: auto;
      object-fit: cover;
      object-position: top center;
    }
  </style>
  <section class="record-section container-fluid px-0" aria-labelledby="screens-brief-title" data-capture-generation={generation.generationId} data-capture-complete={String(generation.coverage.complete)}>
    <div class="row align-items-end g-4 mb-4"><div class="col-lg-8"><p class="record-section__label mb-2">Screenshot archive</p><h2 id="screens-brief-title">Every public page, captured from one frozen build.</h2><p class="record-section__lede mb-0">Each card below is a decoded, nonblank full-page browser screenshot of a ledger page, with its route, dimensions, capture time, and source-build hash. A failed or outdated capture is labeled as failed or stale — never as current.</p></div><div class="col-lg-4"><div class="card border-0 bg-body-tertiary h-100"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Archive total</p><p class="h3 mb-1">{successEntries.length} of {generation.coverage.required} current</p><p class="small text-body-secondary mb-0">Generation {generationShort}{generation.generatedAt ? ` · captured ${generation.generatedAt.slice(0, 10)}` : ' · no capture generation published yet'}.</p></div></div></div></div>
    <div class="row g-3 mb-4" aria-label="Capture archive totals"><div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="badge text-bg-primary">Ledger pages</span><strong class="record-stat__value d-block mt-3">{generation.coverage.required}</strong><span class="record-stat__label">required routes in this generation</span></div></article></div><div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="badge text-bg-warning">Needs attention</span><strong class="record-stat__value d-block mt-3">{failedEntries.length + staleEntries.length}</strong><span class="record-stat__label">failed or stale captures</span></div></article></div><div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class="badge text-bg-light border">Viewports</span><strong class="record-stat__value d-block mt-3">{viewports.length}</strong><span class="record-stat__label">{viewports.map((viewport) => `${viewport.id} ${viewport.width}px`).join(' · ') || 'no viewports recorded'}</span></div></article></div></div>
    <div class="row g-4 align-items-start"><div class="col-12 col-xl-7"><article class="card h-100"><div class="card-body p-3 p-xl-4"><BarChart level={3} id="screens-capture-status-profile" title="Capture status across the ledger" items={statusBars} unit="ledger pages" description="Current means a decoded, nonblank screenshot of the frozen build's content hash. Failed keeps its failure detail; stale means the source build moved on." source="Record capture generation" sourceHref={recordHref('/record/verify/')} /></div></article></div><div class="col-12 col-xl-5"><article class="card h-100"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Provenance</p><h3 class="mb-3">The archive names the build it depicts.</h3><dl class="row small mb-0"><dt class="col-5 text-body-secondary">Generation</dt><dd class="col-7 text-break">{generationShort}</dd><dt class="col-5 text-body-secondary">Source base</dt><dd class="col-7">{generation.sourceBuild.base}</dd><dt class="col-5 text-body-secondary">Self-capture</dt><dd class="col-7">This page's own screenshot depicts the previous generation by design; it is validated through the generation chain, never by chasing its own embed.</dd></dl></div></article></div></div>
  </section>

  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="screens-gallery-title"><div class="row align-items-end g-4 mb-4"><div class="col-lg-8"><p class="record-section__label mb-2">Aligned gallery</p><h2 id="screens-gallery-title">Route, status, and provenance travel with every capture.</h2></div><div class="col-lg-4"><p class="small text-body-secondary mb-0">Thumbnails preview the top of each capture and open the full-resolution capture. Dimensions are the decoded screenshot size, not a placeholder.</p></div></div>
  {!hasGeneration && <div class="alert alert-warning" role="status"><h3 class="h5">No capture generation published yet.</h3><p class="mb-0">The capture pipeline has not published a generation for the current build. This archive reports the absence instead of showing captures from an unknown source.</p></div>}
  {hasGeneration && <div class="row g-4">{entries.map((entry) => <div class="col-12 col-md-6 col-xxl-4"><figure class="record-visual card h-100 mb-0" id={`capture-${slugFor(entry.routeId)}`}><figcaption class="card-body p-3"><div class="d-flex justify-content-between gap-2 small text-body-secondary mb-2"><span>{entry.kind}</span><span class={`badge ${entry.status === 'success' ? 'text-bg-success' : entry.status === 'failed' ? 'text-bg-danger' : 'text-bg-warning'}`}>{statusLabel(entry.status)}</span></div><h3>{entry.title}</h3><p class="small mb-2"><a class="record-link" href={recordHref(entry.routeId)}>Open canonical route <span aria-hidden="true">↗</span></a></p>{entry.status === 'failed' && <p class="small text-danger mb-2" role="status">Capture failed: {entry.failure?.message ?? 'no detail recorded'}</p>}{entry.selfCapture && <p class="small text-body-secondary mb-2">Self-capture: depicts generation {(entry.depictsGeneration ?? 'the pre-capture archive').slice(0, 12)}, not the build that embeds this gallery.</p>}<dl class="row small mb-0"><dt class="col-5 text-body-secondary">Captured</dt><dd class="col-7">{entry.capturedAt.slice(0, 10)}</dd><dt class="col-5 text-body-secondary">Build</dt><dd class="col-7 text-break">{entry.contentHash.slice(0, 12)}</dd></dl></figcaption>{entry.status === 'success' && viewports.map((viewport) => { const artifact = entry.artifacts[viewport.id]; const fullH = artifact ? artifact.segments.reduce((total, segment) => total + segment.h, 0) : 0; const fullW = artifact?.segments[0]?.w ?? 0; return artifact ? <a class="text-decoration-none border-top d-block p-3" href={recordHref(artifact.segments[0].image)}><img class="card-img-top record-visual__thumb" src={recordHref(artifact.thumb)} alt={`Screenshot thumbnail of ${entry.title} (${entry.routeId}) at ${viewport.id} viewport`} width={artifact.thumbW} height={artifact.thumbH} loading="lazy" decoding="async" data-media-id={`record-capture-${slugFor(entry.routeId)}-${viewport.id}`} data-media-role="page-capture" data-source={captureSource(entry.routeId, entry.contentHash)} data-license="Capture of INSTAR Lab's own public page; provenance is the capture record on this page." data-reuse-reason={`Visual archive reference to the canonical route ${entry.routeId}.`} /><span class="small text-body-secondary d-block mt-2">{viewport.id} · {fullW}×{fullH}px full capture{artifact.segments.length > 1 ? ` in ${artifact.segments.length} parts` : ''}</span></a> : null; })}{entry.status === 'success' && viewports.map((viewport) => { const artifact = entry.artifacts[viewport.id]; return artifact && artifact.segments.length > 1 ? <p class="small text-body-secondary px-3 pb-2 mb-0">Full-capture parts ({viewport.id}): {artifact.segments.map((segment, index) => <span><a class="record-link" href={recordHref(segment.image)}>part {index + 1} ({segment.w}×{segment.h})</a>{index < artifact.segments.length - 1 ? ' · ' : ''}</span>)}</p> : null; })}</figure></div>)}</div>}
  </section>
  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="screens-policy-title"><div class="alert alert-info border-start border-4 border-primary mb-0"><h3 id="screens-policy-title">Capture policy</h3><p class="mb-2">Captures are published as AVIF, wait for fonts and settled media, and scroll through lazy-loaded sections before shooting. The capture manifest records per-page status, dimensions, viewport, source-build hash, timestamp, and artifact paths; the coverage gate requires every ledger page to hold a current capture.</p><a class="record-link" href={recordHref('/record/verify/')}>Open source register <span aria-hidden="true">→</span></a></div></section>
</RecordDocument>
