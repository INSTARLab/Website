---
import RecordDocument from '../../../components/record/RecordDocument.astro';
import BarChart from '../../../components/record/viz/BarChart.astro';
import { recordFiles, recordHref, recordRouteAtPath } from '../../../data/record';

const route = recordRouteAtPath('/record/files/');
const statusDefinitions = [
  { key: 'published', label: 'Published', className: 'text-bg-success', description: 'Already represented in the public site surface.' },
  { key: 'review-required', label: 'Review required', className: 'text-bg-warning', description: 'Publicly reachable, but description or provenance needs human review.' },
  { key: 'source-only', label: 'Source only', className: 'text-bg-secondary', description: 'Build or authoring source that is not itself a public page.' },
] as const;
const statusCounts = statusDefinitions.map((status) => ({ ...status, count: recordFiles.filter((file) => file.status === status.key).length }));
const kindCounts = [...new Set(recordFiles.map((file) => file.kind))].map((kind) => ({ kind, count: recordFiles.filter((file) => file.kind === kind).length }));
const reviewQueue = recordFiles.filter((file) => file.status === 'review-required');
const totalFiles = recordFiles.length;
const percentage = (count: number) => totalFiles === 0 ? 0 : Math.round((count / totalFiles) * 100);
const fileStatusBars = statusCounts.map((status) => ({ label: status.label, value: status.count }));
---

<RecordDocument {route}>
  <section class="record-section container-fluid px-0" aria-labelledby="files-brief-title">
    <div class="row align-items-end g-4 mb-4"><div class="col-lg-8"><p class="record-section__label mb-2">Document lineage</p><h2 id="files-brief-title">The public surface is more than its pages.</h2><p class="record-section__lede mb-0">This register keeps public documents, source collections, fonts, logos, and media policy visible. It names what is shipped, what is source-only, and what still needs review.</p></div><div class="col-lg-4"><div class="card border-0 bg-body-tertiary h-100"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Inventory total</p><p class="h3 mb-1">{totalFiles} file records</p><p class="small text-body-secondary mb-0">Kind and status counts are derived from the current register.</p></div></div></div></div>
    <div class="row g-3 mb-4" aria-label="File status totals">{statusCounts.map((status) => <div class="col-12 col-sm-4"><article class="card record-stat h-100"><div class="card-body p-3"><span class:list={['badge', status.className]}>{status.label}</span><strong class="record-stat__value d-block mt-3">{status.count}</strong><span class="record-stat__label">{percentage(status.count)}% of file records</span></div></article></div>)}</div>
    <div class="row g-4 align-items-start">
      <div class="col-12 col-xl-7"><article class="card h-100"><div class="card-body p-3 p-xl-4"><BarChart id="files-publication-state" title="What is ready to describe" items={fileStatusBars} unit="file records" description="Status is the publication state recorded for each entry. It does not independently establish ownership or license." source="Public file register" sourceHref={recordHref('/record/files/')} /></div></article></div>
      <div class="col-12 col-xl-5"><article class="card h-100"><div class="card-body p-3 p-xl-4"><p class="record-kicker mb-2">Kind distribution</p><h3 class="h4 mb-3">The shape of the inventory.</h3><ul class="list-group list-group-flush">{kindCounts.map((entry) => <li class="list-group-item d-flex justify-content-between gap-3 px-0"><span>{entry.kind}</span><strong>{entry.count}</strong></li>)}</ul><p class="small text-body-secondary mt-3 mb-0">Kinds are copied from the source register; they are not inferred from file extensions.</p></div></article></div>
    </div>
  </section>
  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="files-table-title"><div class="row align-items-end g-4 mb-4"><div class="col-lg-8"><p class="record-section__label mb-2">File register</p><h2 id="files-table-title">Follow each file to its public boundary.</h2></div><div class="col-lg-4"><p class="small text-body-secondary mb-0">Source-only entries remain visible for lineage, while public entries retain their route or repository path.</p></div></div><div class="table-responsive border rounded bg-white" tabindex="0" role="region" aria-label="Public files and source collections"><table class="record-table table table-hover align-middle mb-0"><caption class="caption-top px-3 py-3">Public files and source collections</caption><thead class="table-light"><tr><th scope="col">Kind</th><th scope="col">File or path</th><th scope="col">Status</th><th scope="col">Publication and provenance note</th></tr></thead><tbody>{recordFiles.map((file) => <tr><th scope="row">{file.kind}</th><td><code class="d-block text-break">{file.path}</code><strong class="d-block mt-2">{file.label}</strong></td><td><span class:list={['badge', statusDefinitions.find((status) => status.key === file.status)?.className]}>{statusDefinitions.find((status) => status.key === file.status)?.label}</span></td><td>{file.note}</td></tr>)}</tbody></table></div></section>
  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="files-queue-title"><div class="row align-items-end g-4 mb-4"><div class="col-lg-8"><p class="record-section__label mb-2">Review queue</p><h2 id="files-queue-title">Open provenance work stays visible.</h2><p class="record-section__lede mb-0">This queue contains entries explicitly marked “Review required.” Source-only files remain visible in the register for lineage, but they are not treated as pending publication decisions.</p></div><div class="col-lg-4"><div class="alert alert-warning mb-0"><strong>{reviewQueue.length}</strong> entries need a publication or description decision.</div></div></div><div class="row g-3">{reviewQueue.map((file, index) => <article class="col-12 col-md-6"><div class="card h-100"><div class="card-body p-3"><div class="d-flex justify-content-between gap-3"><span class="record-kicker">Queue {String(index + 1).padStart(2, '0')}</span><span class:list={['badge', statusDefinitions.find((status) => status.key === file.status)?.className]}>{statusDefinitions.find((status) => status.key === file.status)?.label}</span></div><h3 class="h5 mt-3">{file.label}</h3><code class="small text-break d-block">{file.path}</code><p class="small mb-0 mt-2">{file.note}</p></div></div></article>)}</div></section>
  <section class="record-section container-fluid px-0 mt-5" aria-labelledby="files-related-title"><div class="alert alert-info border-start border-4 border-primary mb-0"><h3 id="files-related-title" class="h5">Continue the lineage</h3><p class="mb-2">Use the source register before describing a public document by anything stronger than its URL and filename.</p><a class="record-link" href={recordHref('/record/verify/')}>Open source register <span aria-hidden="true">→</span></a></div></section>
</RecordDocument>
